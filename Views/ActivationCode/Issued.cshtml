@model LaudaryMis.ViewModels.ActivationIssuedVM
@{
    var isHospital = Model.EntityType == "Hospital";
    ViewData["Title"] = "Activation Codes issued";
}

@section Styles {
    <style>
        .code-cell { font-family: Consolas, 'Courier New', monospace; font-size: 1.05rem; font-weight: 700; letter-spacing: .08em; }
        @@media print {
            .app-sidebar, .topbar, .no-print, .page-header .ph-actions { display: none !important; }
            .app-main, main { margin: 0 !important; padding: 0 !important; }
        }
    </style>
}

<div class="alert alert-warning no-print">
    <i class="fa-solid fa-triangle-exclamation"></i>
    <span>
        <strong>Ye codes sirf abhi dikh rahe hain.</strong> Is page ko chhodne ya refresh karne ke baad dobara nahi dikhenge
        (sirf unka hash save hota hai). Abhi download ya print kar lein.
        Code kho jaye to Index page se naya code bana lein.
    </span>
</div>

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-key"></i></div>
    <div class="ph-text">
        <h1>@Model.Codes.Count activation code@(Model.Codes.Count == 1 ? "" : "s")</h1>
        <p class="ph-sub">@(isHospital ? "Hospitals" : "Vendors") &middot; @Model.IssuedOn.ToString("dd MMM yyyy, hh:mm tt")</p>
    </div>
    <div class="ph-actions">
        <button type="button" class="btn btn-primary" id="btnCsv"><i class="fa-solid fa-download"></i> CSV download</button>
        <button type="button" class="btn btn-outline-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> Print</button>
        <a asp-action="Index" asp-route-type="@Model.EntityType" class="btn btn-light"><i class="fa-solid fa-arrow-left"></i> Wapas</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="tblIssued">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@(isHospital ? "Hospital" : "Vendor")</th>
                        @if (isHospital)
                        {
                            <th>District</th>
                        }
                        <th>Activation code</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int i = 1; }
                    @foreach (var c in Model.Codes)
                    {
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td class="fw-semibold">@c.Name</td>
                            @if (isHospital)
                            {
                                <td>@c.District</td>
                            }
                            <td class="code-cell">@c.Code</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small text-muted mt-3 mb-0">
            Hospital / vendor Login page par <strong>"Register karein"</strong> pe jaakar apna naam chunein aur ye code daalein.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#btnCsv').on('click', function () {
                var rows = [];
                $('#tblIssued tr').each(function () {
                    var cells = $(this).children('th,td').map(function () {
                        return '"' + $(this).text().trim().replace(/"/g, '""') + '"';
                    }).get();
                    rows.push(cells.join(','));
                });
                var blob = new Blob(['﻿' + rows.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = 'activation-codes-@(Model.EntityType.ToLower())-@(Model.IssuedOn.ToString("yyyyMMdd-HHmm")).csv';
                document.body.appendChild(a); a.click(); a.remove();
            });
        });
    </script>
}
