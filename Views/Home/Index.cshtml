@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f3a" />
    <title>DGMH UP &middot; Laundry MIS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>

<body class="hp-fit">

    <a class="hp-skip" href="#main">Skip to main content</a>

    <!-- UTILITY STRIP -->
    <div class="hp-util">
        <div class="hp-wrap">
            <div class="hp-textsize" role="group" aria-label="Text size">
                <span>Text size</span>
                <button type="button" data-size="90" aria-label="Smaller text">A<sup>-</sup></button>
                <button type="button" data-size="100" aria-label="Normal text" class="on">A</button>
                <button type="button" data-size="115" aria-label="Larger text">A<sup>+</sup></button>
            </div>
            <div class="hp-util-right">
                <a href="#main">Skip to main content</a>
            </div>
        </div>
    </div>

    <!-- MASTHEAD -->
    <header class="hp-masthead">
        <div class="hp-wrap">
            <a class="hp-brand" href="/">
                <img class="emblem" src="~/Images/up-logo.png" alt="Government of Uttar Pradesh" width="64" height="64" />
                <span>
                    <strong>Directorate General of Medical &amp; Health Services</strong>
                    <em>Government of Uttar Pradesh</em>
                    <small>Laundry MIS &middot; Mechanized Laundry Services</small>
                </span>
            </a>
            <div class="hp-actions">
                <a class="hp-pill" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
                <a class="hp-pill hp-pill-teal" asp-controller="Account" asp-action="Claim"><i class="fa-solid fa-key"></i> Register</a>
            </div>
        </div>
    </header>

    <!-- MENU -->
    <nav class="hp-menu" id="hpMenu" aria-label="Main">
        <div class="hp-wrap">
            <button type="button" class="hp-burger" aria-expanded="false" aria-controls="hpMenuList">
                <i class="fa-solid fa-bars"></i> Menu
            </button>
            <ul class="hp-menu-list" id="hpMenuList">
                <li><a class="home" href="/" aria-label="Home"><i class="fa-solid fa-house"></i></a></li>
                <li><a href="#services">What it does</a></li>
                <li><a href="#how">How it works</a></li>
                <li class="hp-dd">
                    <button type="button" aria-haspopup="true" aria-expanded="false">Sign In <i class="fa-solid fa-chevron-down"></i></button>
                    <ul class="hp-dd-menu">
                        <li><a asp-controller="Account" asp-action="Login" asp-route-roleId="2"><i class="fa-solid fa-hospital"></i> Hospital</a></li>
                        <li><a asp-controller="Account" asp-action="Login" asp-route-roleId="4"><i class="fa-solid fa-clipboard-user"></i> CMS</a></li>
                        <li><a asp-controller="Account" asp-action="Login" asp-route-roleId="3"><i class="fa-solid fa-truck-fast"></i> Service Provider (vendor)</a></li>
                        <li><a asp-controller="Account" asp-action="Login" asp-route-roleId="1"><i class="fa-solid fa-user-shield"></i> Admin</a></li>
                    </ul>
                </li>
                <li><a asp-controller="Account" asp-action="Claim">Register</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <main id="main">

        <!-- TOP: leaders | carousel | login -->
        <section class="hp-top" id="leadership" aria-label="Leadership, highlights and sign in">
            <div class="hp-wrap hp-top-grid">

                <!-- LEADERS -->
                <div class="hp-leaders-col">
                    <article class="hp-leader-row">
                        <img src="~/Images/leaders/cm.jpg" alt="Yogi Adityanath" width="96" height="112" loading="lazy" />
                        <div>
                            <h3>Yogi Adityanath</h3>
                            <p>Hon’ble Chief Minister, Uttar Pradesh</p>
                        </div>
                    </article>
                    <article class="hp-leader-row">
                        <img src="~/Images/leaders/deputy-cm.jpg" alt="Shri Brajesh Pathak" width="96" height="112" loading="lazy" />
                        <div>
                            <h3>Shri Brajesh Pathak</h3>
                            <p>Hon’ble Deputy Chief Minister, Medical Health &amp; Family Welfare Department, Uttar Pradesh</p>
                        </div>
                    </article>
                    <article class="hp-leader-row">
                        <img src="~/Images/leaders/state-minister.jpg" alt="Shri Mayankeshwar Singh" width="96" height="112" loading="lazy" />
                        <div>
                            <h3>Shri Mayankeshwar Singh</h3>
                            <p>Hon’ble State Minister, Medical Health &amp; Family Welfare, Uttar Pradesh</p>
                        </div>
                    </article>
                </div>

                <!-- CAROUSEL -->
                <div class="hp-carousel" id="hpCarousel" aria-roledescription="carousel" aria-label="Highlights">
                    <div class="hp-slides">
                        <div class="hp-slide s1 on" role="group" aria-roledescription="slide" aria-label="1 of 4">
                            <i class="fa-solid fa-shirt hp-slide-ic" aria-hidden="true"></i>
                            <span class="hp-slide-kicker">Directorate General of Medical &amp; Health Services &middot; U.P.</span>
                            <h1>Mechanized laundry services, <span>tracked end to end</span></h1>
                            <p>One portal for district hospitals, laundry firms and the Directorate.</p>
                        </div>
                        <div class="hp-slide s2" role="group" aria-roledescription="slide" aria-label="2 of 4">
                            <i class="fa-solid fa-boxes-packing hp-slide-ic" aria-hidden="true"></i>
                            <span class="hp-slide-kicker">Daily operations</span>
                            <h2>Linen pickup <span>&amp; delivery</span></h2>
                            <p>Hospitals record linen sent from each ward; the firm accepts it and delivers it back clean.</p>
                        </div>
                        <div class="hp-slide s3" role="group" aria-roledescription="slide" aria-label="3 of 4">
                            <i class="fa-solid fa-clipboard-check hp-slide-ic" aria-hidden="true"></i>
                            <span class="hp-slide-kicker">Every week</span>
                            <h2>Weekly performance <span>review (WPR)</span></h2>
                            <p>Ten parameters, scored 0–10. The monthly average decides the share of the bill that is paid.</p>
                        </div>
                        <div class="hp-slide s4" role="group" aria-roledescription="slide" aria-label="4 of 4">
                            <i class="fa-solid fa-file-invoice-dollar hp-slide-ic" aria-hidden="true"></i>
                            <span class="hp-slide-kicker">Every month</span>
                            <h2>Payments <span>&amp; invoices</span></h2>
                            <p>The hospital generates the payment, the admin approves it and the firm raises its invoice.</p>
                        </div>
                    </div>
                    <button type="button" class="hp-car-nav prev" aria-label="Previous slide"><i class="fa-solid fa-chevron-left"></i></button>
                    <button type="button" class="hp-car-nav next" aria-label="Next slide"><i class="fa-solid fa-chevron-right"></i></button>
                    <div class="hp-car-dots" aria-label="Choose slide">
                        <button type="button" class="on" aria-label="Slide 1"></button>
                        <button type="button" aria-label="Slide 2"></button>
                        <button type="button" aria-label="Slide 3"></button>
                        <button type="button" aria-label="Slide 4"></button>
                    </div>
                </div>

                <!-- LOGIN -->
                <div class="hp-login" id="signin">
                    <h2><i class="fa-solid fa-right-to-bracket"></i> Login</h2>
                    <form method="post" asp-controller="Account" asp-action="Login" id="hpLoginForm" novalidate>
                        @Html.AntiForgeryToken()

                        <label for="hpRole">User type</label>
                        <select id="hpRole" name="RoleId" required>
                            <option value="" selected disabled>Please select user type</option>
                            <option value="2">Hospital</option>
                            <option value="4">CMS</option>
                            <option value="3">Service Provider (vendor)</option>
                            <option value="1">Admin</option>
                        </select>

                        <div id="hpUserWrap" hidden>
                            <label for="hpUsername">Username</label>
                            <input type="text" id="hpUsername" name="Username" autocomplete="username" placeholder="Enter your username" />
                        </div>
                        <div id="hpCmsWrap" hidden>
                            <label for="hpDistrict">District</label>
                            <select id="hpDistrict" name="DistrictId"><option value="">Select district</option></select>
                            <label for="hpHospital">Hospital</label>
                            <select id="hpHospital" name="HospitalId" disabled><option value="">Select the district first</option></select>
                        </div>
                        <div id="hpLoginIdWrap">
                            <label for="hpLoginId">Mobile number or email</label>
                            <input type="text" id="hpLoginId" name="LoginId" maxlength="200" autocomplete="username" placeholder="10-digit mobile number or email" />
                        </div>

                        <label for="hpPassword">Password</label>
                        <div class="hp-pwd">
                            <input type="password" id="hpPassword" name="Password" autocomplete="current-password" placeholder="Enter your password" required />
                            <button type="button" id="hpPwdToggle" aria-label="Show password"><i class="fa-solid fa-eye"></i></button>
                        </div>

                        <p class="hp-login-err" id="hpLoginErr" role="alert" hidden></p>

                        <div class="hp-login-btns">
                            <button type="submit" class="hp-signin" id="hpSignIn">Sign In</button>
                            <button type="reset" class="hp-reset">Reset</button>
                        </div>
                    </form>
                    <p class="hp-login-foot">First time here? <a asp-controller="Account" asp-action="Claim">Register with an activation code</a></p>
                </div>

            </div>
        </section>

        <!-- NUMBERS -->
        <section class="hp-stats" aria-label="At a glance">
            <div class="hp-wrap">
                <div><strong>197</strong><span>District hospitals</span></div>
                <div><strong>12</strong><span>Schedules (zones)</span></div>
                <div><strong>4</strong><span>Laundry firms</span></div>
            </div>
        </section>

        <!-- WHAT IT DOES -->
        <section class="hp-section alt" id="services">
            <div class="hp-wrap">
                <div class="hp-head">
                    <span class="kicker">What the portal does</span>
                    <h2>Everything from the ward to the invoice</h2>
                    <p>Each step is recorded once, so hospitals, firms and the Directorate all work from the same figures.</p>
                </div>

                <div class="hp-cards">
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-boxes-packing"></i></div>
                        <h3>Pickup &amp; delivery</h3>
                        <p>Hospitals record the linen sent for wash; the firm accepts it and delivers it back, and the hospital verifies what returned.</p>
                    </div>
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-clipboard-check"></i></div>
                        <h3>Weekly performance (WPR)</h3>
                        <p>Every week the hospital scores the service on ten parameters. The monthly average decides the share of the bill that is paid.</p>
                    </div>
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-money-bill-wave"></i></div>
                        <h3>Monthly payment</h3>
                        <p>The payment is worked out from the WPR score and the bed strength, then approved by the admin.</p>
                    </div>
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-file-invoice-dollar"></i></div>
                        <h3>Invoices</h3>
                        <p>Once a payment is approved, the firm raises its invoice. Invoices can be viewed, printed and downloaded as PDF.</p>
                    </div>
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-chart-column"></i></div>
                        <h3>Reports</h3>
                        <p>Delivery summary, weekly and monthly delivery, pending linen and delivery aging, each for your own hospital or firm.</p>
                    </div>
                    <div class="hp-card">
                        <div class="ic"><i class="fa-solid fa-triangle-exclamation"></i></div>
                        <h3>Warning letters</h3>
                        <p>When a month’s score falls below 60 the hospital can issue a warning letter, and a PDF copy is kept with the record.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- HOW IT WORKS -->
        <section class="hp-section" id="how">
            <div class="hp-wrap">
                <div class="hp-head">
                    <span class="kicker">How it works</span>
                    <h2>One month, four steps</h2>
                </div>

                <div class="hp-steps">
                    <div class="hp-step">
                        <span class="who">Hospital</span>
                        <h3>Send linen for wash</h3>
                        <p>Record each pickup by ward and shift, with the quantity of every linen type.</p>
                    </div>
                    <div class="hp-step">
                        <span class="who">Firm &amp; hospital</span>
                        <h3>Deliver and verify</h3>
                        <p>The firm accepts the pickup and delivers it back; the hospital checks and verifies the delivery.</p>
                    </div>
                    <div class="hp-step">
                        <span class="who">Hospital, CMS &amp; admin</span>
                        <h3>Score and pay</h3>
                        <p>The hospital submits the weekly WPR, its CMS verifies it, and the verified scores set the monthly payment, which the admin approves.</p>
                    </div>
                    <div class="hp-step">
                        <span class="who">Firm</span>
                        <h3>Raise the invoice</h3>
                        <p>For the approved payment, the firm generates its invoice.</p>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <footer class="hp-footer">
        <div class="hp-foot-main">
            <div class="hp-wrap hp-foot-grid">

                <div class="hp-foot-id">
                    <div class="hp-foot-logos">
                        <img src="~/Images/up-logo.png" alt="Government of Uttar Pradesh" width="104" height="104" />
                        <i class="fa-solid fa-staff-snake" aria-hidden="true"></i>
                    </div>
                    <a class="hp-foot-btn" asp-controller="Account" asp-action="Login">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                </div>

                <div>
                    <h2 class="hp-foot-h">Quick Links</h2>
                    <ul class="hp-foot-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="#services">What it does</a></li>
                        <li><a href="#how">How it works</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Sign In</a></li>
                        <li><a asp-controller="Account" asp-action="Claim">Register with an activation code</a></li>
                        <li><a href="#contact">Contact</a></li>
                    </ul>
                </div>

                <div id="contact">
                    <h2 class="hp-foot-h">Get In Touch</h2>
                    <ul class="hp-foot-contact">
                        <li>
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            <span>Medical Health &amp; Family Welfare Department, Swasthya Bhawan, Lucknow<br />Off: 0522-2622625, 2623980</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-phone" aria-hidden="true"></i>
                            <a href="tel:18001805145">1800-180-5145</a>
                        </li>
                        <li>
                            <i class="fa-solid fa-envelope" aria-hidden="true"></i>
                            <a href="mailto:support@dgmhup.in">support@dgmhup.in</a>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
        <div class="hp-foot-bar">
            Laundry MIS &middot; Directorate General of Medical &amp; Health Services, Uttar Pradesh
        </div>
    </footer>

    <a class="hp-totop" href="#" aria-label="Back to top" title="Back to top"><i class="fa-solid fa-arrow-up"></i></a>

    <script>
        // Desktop: scale the whole page to the screen width, so a 1536px laptop shows it
        // like a 1920px screen (80%). Phones and tablets are left at full size.
        (function () {
            function fit() {
                var w = window.innerWidth;
                document.body.style.zoom = w >= 1200 ? String(Math.min(1, Math.max(0.8, w / 1920))) : "";
            }
            fit();
            window.addEventListener("resize", fit);
        })();
    </script>
    <script>
        (function () {
            var menu = document.getElementById("hpMenu");

            // Menu button on small screens
            var burger = menu.querySelector(".hp-burger");
            burger.addEventListener("click", function () {
                var open = menu.classList.toggle("open");
                burger.setAttribute("aria-expanded", open ? "true" : "false");
            });
            // Close the small-screen menu after jumping to a section on this page
            menu.querySelectorAll('.hp-menu-list a[href^="#"]').forEach(function (a) {
                a.addEventListener("click", function () {
                    menu.classList.remove("open");
                    burger.setAttribute("aria-expanded", "false");
                });
            });

            // Sign In drop-down
            var dd = menu.querySelector(".hp-dd");
            var ddBtn = dd.querySelector("button");
            function closeDd() { dd.classList.remove("open"); ddBtn.setAttribute("aria-expanded", "false"); }
            ddBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                var open = dd.classList.toggle("open");
                ddBtn.setAttribute("aria-expanded", open ? "true" : "false");
            });
            document.addEventListener("click", closeDd);
            document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeDd(); });


            // ---- Carousel
            var car = document.getElementById("hpCarousel");
            var slides = car.querySelectorAll(".hp-slide");
            var dots = car.querySelectorAll(".hp-car-dots button");
            var cur = 0, timer = null;
            var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            function show(i) {
                cur = (i + slides.length) % slides.length;
                slides.forEach(function (s, k) { s.classList.toggle("on", k === cur); });
                dots.forEach(function (d, k) { d.classList.toggle("on", k === cur); });
            }
            function stop() { if (timer) clearInterval(timer); timer = null; }
            function play() { stop(); if (!reduce) timer = setInterval(function () { show(cur + 1); }, 5000); }
            car.querySelector(".prev").addEventListener("click", function () { show(cur - 1); play(); });
            car.querySelector(".next").addEventListener("click", function () { show(cur + 1); play(); });
            dots.forEach(function (d, k) { d.addEventListener("click", function () { show(k); play(); }); });
            car.addEventListener("mouseenter", stop);
            car.addEventListener("mouseleave", play);
            play();

            // ---- Login: admin signs in with a username, CMS by district + hospital,
            //      hospital and vendor with a mobile number or email
            var role = document.getElementById("hpRole");
            var userWrap = document.getElementById("hpUserWrap");
            var idWrap = document.getElementById("hpLoginIdWrap");
            var cmsWrap = document.getElementById("hpCmsWrap");
            var district = document.getElementById("hpDistrict");
            var hospital = document.getElementById("hpHospital");
            var err = document.getElementById("hpLoginErr");
            var cmsLoaded = false;

            function fill(sel, items, placeholder) {
                sel.innerHTML = "";
                var first = document.createElement("option");
                first.value = ""; first.textContent = placeholder;
                sel.appendChild(first);
                items.forEach(function (it) {
                    var o = document.createElement("option");
                    o.value = it.id; o.textContent = it.name;
                    sel.appendChild(o);
                });
            }
            function loadCmsDistricts() {
                if (cmsLoaded) return;
                fetch("/Account/CmsDistricts", { credentials: "same-origin" })
                    .then(function (r) { return r.json(); })
                    .then(function (items) {
                        cmsLoaded = true;
                        fill(district, items, items.length ? "Select district" : "No CMS accounts yet");
                    });
            }
            district.addEventListener("change", function () {
                if (!district.value) { fill(hospital, [], "Select the district first"); hospital.disabled = true; return; }
                fetch("/Account/CmsHospitals?districtId=" + encodeURIComponent(district.value), { credentials: "same-origin" })
                    .then(function (r) { return r.json(); })
                    .then(function (items) { fill(hospital, items, "Select hospital"); hospital.disabled = false; });
            });
            function showFields() {
                var v = role.value;
                userWrap.hidden = v !== "1";
                cmsWrap.hidden = v !== "4";
                idWrap.hidden = v === "1" || v === "4";
                if (v === "4") loadCmsDistricts();
                err.hidden = true;
            }
            role.addEventListener("change", showFields);
            document.getElementById("hpPwdToggle").addEventListener("click", function () {
                var input = document.getElementById("hpPassword");
                var showPwd = input.type === "password";
                input.type = showPwd ? "text" : "password";
                this.querySelector("i").className = showPwd ? "fa-solid fa-eye-slash" : "fa-solid fa-eye";
                this.setAttribute("aria-label", showPwd ? "Hide password" : "Show password");
            });
            var form = document.getElementById("hpLoginForm");
            form.addEventListener("reset", function () {
                setTimeout(function () { userWrap.hidden = true; cmsWrap.hidden = true; idWrap.hidden = false; fill(hospital, [], "Select the district first"); hospital.disabled = true; err.hidden = true; }, 0);
            });
            form.addEventListener("submit", function (e) {
                var msg = "";
                if (!role.value) msg = "Please select the user type.";
                else if (role.value === "1" && !document.getElementById("hpUsername").value.trim()) msg = "Enter your username.";
                else if (role.value === "4" && !hospital.value) msg = "Select the district and the hospital.";
                else if (role.value !== "1" && role.value !== "4" && !document.getElementById("hpLoginId").value.trim()) msg = "Enter your mobile number or email.";
                else if (!document.getElementById("hpPassword").value) msg = "Enter your password.";
                if (msg) { e.preventDefault(); err.textContent = msg; err.hidden = false; return; }
                var btn = document.getElementById("hpSignIn");
                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Signing in…';
            });

            // Back-to-top button appears after scrolling
            var toTop = document.querySelector(".hp-totop");
            function showTop() { toTop.classList.toggle("show", window.scrollY > 400); }
            window.addEventListener("scroll", showTop, { passive: true });
            showTop();
            toTop.addEventListener("click", function (e) {
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: "smooth" });
            });

            // Text size (remembered on this browser)
            var sizeBtns = document.querySelectorAll(".hp-textsize button");
            var baseSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
            function setSize(pct) {
                // 100 = the page's own size; the others are a share of it
                document.documentElement.style.fontSize = pct === 100 ? "" : (baseSize * pct / 100) + "px";
                sizeBtns.forEach(function (b) { b.classList.toggle("on", b.getAttribute("data-size") === String(pct)); });
                try { localStorage.setItem("hpTextSize", String(pct)); } catch (e) { }
            }
            sizeBtns.forEach(function (b) {
                b.addEventListener("click", function () { setSize(+b.getAttribute("data-size")); });
            });
            try { var saved = localStorage.getItem("hpTextSize"); if (saved) setSize(+saved); } catch (e) { }
        })();
    </script>

</body>
</html>
