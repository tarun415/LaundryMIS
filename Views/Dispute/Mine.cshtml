@model List<LaudaryMis.ViewModels.DisputeListItemVM>

@{
    ViewBag.Title = "My Disputes";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-scale-balanced"></i></div>
    <div class="ph-text">
        <h1>My Disputes</h1>
        <p class="ph-sub">Bill disputes you raised and what came of them</p>
    </div>
    <div class="ph-actions">
        <a asp-action="Raise" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Raise dispute</a>
    </div>
</div>

<partial name="_Alerts" />

<partial name="_DisputeTable" model="@Model" />
