@model List<LaudaryMis.ViewModels.DailyEntryListVM>



<style>
    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        border: none;
        color: #fff;
        font-weight: 500;
    }

    .dt-buttons {
        display: flex;
        gap: 6px;
    }

        .dt-buttons .btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            border: none;
        }

    .buttons-copy {
        background: #6c757d !important;
    }

    .buttons-excel {
        background: #198754 !important;
    }

    .buttons-pdf {
        background: #dc3545 !important;
    }

    .buttons-print {
        background: #0d6efd !important;
    }

    .dataTables_filter input {
        border-radius: 20px;
        padding: 5px 10px;
    }

    .child-table {
        width: 100% !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        border-radius: 15px;
        padding: 4px 8px;
        margin-left: 5px;
    }
</style>

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold">🧺 Daily Linen Entries</h4>

        <a href="/Provider/DailyEntry" class="btn btn-primary rounded-pill px-4">
            + New Entry
        </a>
    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    <div class="card shadow-sm border-0 rounded-3 mb-2">
        <div class="card-body">

            <div class="row g-2 align-items-end">

                <div class="col-md-2">
                    <label>Status</label>
                    <select id="filterStatus" class="form-select">
                        <option value="">All</option>
                        <option>Pending</option>
                        <option>Delivered</option>
                        <option>Collected</option>
                        <option>Partial</option>
                        <option>Verified</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Hospital</label>
                    <select id="filterHospital" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label>Ward</label>
                    <select id="filterWard" class="form-select">
                        <option value="">All</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label>Date</label>
                    <input type="date" id="filterDate" class="form-control" />
                </div>

                <!-- 🔍 SEARCH BUTTON -->
                <div class="col-md-1 d-grid">
                    <button id="btnSearch" class="btn btn-primary mt-4">
                        🔍
                    </button>
                </div>

                <!-- ♻ CLEAR BUTTON -->
                <div class="col-md-1 d-grid">
                    <button id="btnClear" class="btn btn-outline-secondary mt-4">
                        ✖
                    </button>
                </div>

            </div>

        </div>
    </div>
    <!-- TABLE -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
           
            <div class="table-responsive">
                <table id="entryTable" class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th></th>
                            <th> S.No.</th>
                            <th>Date</th>
                            <th>Hospital</th>
                            <th>Ward</th>
                            <th>Pickup</th>
                            <th>Delivered</th>
                            <th>Pending</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="details-control text-center" data-id="@item.EntryId" style="cursor:pointer;">
                                    ➕
                                </td>
                                <td>@item.RowNum</td>
                                <td>@item.EntryDate.ToString("dd MMM yyyy")</td>
                                <td class="fw-semibold">@item.HospitalName</td>
                                <td>@item.WardName</td>

                              

                                <td class="text-primary fw-bold">
                                    @item.TotalPickupQty
                                </td>

                                <td class="text-success fw-bold">
                                    @item.CleanDeliveredQty
                                </td>
                                <td class="text-success fw-bold">
                                    @item.TotalPendingQty
                                </td>

                                <td>
                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="badge bg-info text-dark">Delivered</span>
                                    }
                                    else if (item.Status == "Verified")
                                    {
                                        <span class="badge bg-success">Verified</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                @if (item.Status == "Collected")
                                {
                                    <td>
                                        <div class="d-flex gap-2 justify-content-center">
                                            <a href="/Provider/EditDailyEntry/@item.EntryId"
                                               class="btn btn-sm btn-warning rounded-circle">
                                                <i class="fa fa-edit"></i>
                                            </a>

                                            <button class="btn btn-sm btn-danger rounded-circle"
                                                    onclick="deleteDailyEntry(@item.EntryId, this)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                }
                                else
                                {
                                    <td></td>
                                }

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
@section Scripts {



    <script>
        $(document).ready(function () {

            $('#entryTable').DataTable({
                pageLength: 10,
                responsive: true,

                dom:
                    "<'row mb-2 align-items-center'<'col-md-4'l><'col-md-8 d-flex justify-content-end gap-2'Bf>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",

                buttons: [
                    { extend: 'copy', className: 'btn buttons-copy', text: '📋' },
                    { extend: 'excel', className: 'btn buttons-excel', text: '📊' },
                    { extend: 'pdf', className: 'btn buttons-pdf', text: '📄' },
                    { extend: 'print', className: 'btn buttons-print', text: '🖨️' }
                ],

                language: {
                    search: "",
                    searchPlaceholder: "🔍 Search entries..."
                }
            });

                            function format(items, id) {

            let html = `<table id="childTable_${id}" class="table table-sm table-bordered child-table">
                            <thead>
                                <tr>
                                    <th>Linen Type</th>
                                    <th>Pickup</th>
                                    <th>Delivered</th>
                                    <th>Pending</th>
                                </tr>
                            </thead>
                            <tbody>`;

            items.forEach(x => {
                html += `<tr>
                            <td>${x.linenTypeName}</td>
                            <td>${x.totalPickupQty}</td>
                            <td>${x.cleanDeliveredQty}</td>
                             <td>${x.totalpendingQty}</td>
                         </tr>`;
            });

            html += "</tbody></table>";

            return html;
        }

        var table = $('#entryTable').DataTable();

        $('#entryTable tbody').on('click', 'td.details-control', function () {

            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var id = $(this).data('id');

            if (row.child.isShown()) {
                row.child.hide();
                tr.removeClass('shown');
                $(this).html("➕");
            }
            else {

                $.get('/Provider/DailyEntryItems/' + id, function (data) {

                    row.child(format(data, id)).show();
                    tr.addClass('shown');
                    tr.find('.details-control').html("➖");

                    // ✅ Initialize child datatable
                    $('#childTable_' + id).DataTable({
                        paging: false,
                        searching: true,
                        info: false,
                        scrollY: "200px",
                        scrollCollapse: true
                    });

                });

            }
        });

                // LOAD HOSPITALS
        $.get('/Provider/GetHospitals', function (data) {

            let html = '<option value="">All</option>';

            data.forEach(x => {
                html += `<option value="${x.id}">${x.name}</option>`;
            });

            $('#filterHospital').html(html);
        });


        // LOAD WARDS
        $.get('/Provider/GetWards', function (data) {

            let html = '<option value="">All</option>';

            data.forEach(x => {
                html += `<option value="${x.id}">${x.name}</option>`;
            });

            $('#filterWard').html(html);
        });


        //Search
                $('#btnSearch').click(function () {

            let data = {
                status: $('#filterStatus').val(),
                hospitalId: $('#filterHospital').val(),
                wardId: $('#filterWard').val(),
                date: $('#filterDate').val()
            };

            $.ajax({
                url: '/Provider/SearchDailyEntries',
                type: 'GET',
                data: data,

                      success: function (res) {

            let rows = "";

            res.forEach(item => {

                        rows += `
        <tr>
            <td class="details-control text-center" data-id="${item.entryId}" style="cursor:pointer;">➕</td>
            <td>${item.rowNum}</td>
            <td>${formatDate(item.entryDate)}</td>
            <td class="fw-semibold">${item.hospitalName}</td>
            <td>${item.wardName}</td>
            <td class="text-primary fw-bold">${item.totalPickupQty}</td>
            <td class="text-success fw-bold">${item.cleanDeliveredQty}</td>
            <td class="text-success fw-bold">${item.totalPendingQty}</td>
            <td>${getStatusBadge(item.status)}</td>

                          ${item.status === "Collected" ? `
        <td>
            <div class="d-flex gap-2 justify-content-center">
                <a href="/Provider/EditDailyEntry/${item.entryId}"
                   class="btn btn-sm btn-warning rounded-circle">
                    <i class="fa fa-edit"></i>
                </a>

                <button class="btn btn-sm btn-danger rounded-circle"
                        onclick="deleteDailyEntry(${item.entryId}, this)">
                    <i class="fa fa-trash"></i>
                </button>
            </div>
        </td>
        ` : `<td></td>`}
        </tr>`;
            });

            table.clear().destroy(); // destroy old table

            $('#entryTable tbody').html(rows); // inject HTML

            // reinitialize
            table = $('#entryTable').DataTable();
        },

                error: function () {
                    alert("Error loading data");
                }
            });

        });
        //Clear
                $('#btnClear').click(function () {

            $('#filterStatus').val('');
            $('#filterHospital').val('');
            $('#filterWard').val('');
            $('#filterDate').val('');

            $('#btnSearch').click(); // reload all data
        });

                function formatDate(data) {
            let d = new Date(data);
            return d.toLocaleDateString('en-GB', {
                day: '2-digit',
                month: 'short',
                year: 'numeric'
            });
        }

        function getStatusBadge(status) {

            if (status === "Pending")
                return `<span class="badge bg-warning text-dark">Pending</span>`;
            if (status === "Delivered")
                return `<span class="badge bg-info text-dark">Delivered</span>`;
            if (status === "Verified")
                return `<span class="badge bg-success">Verified</span>`;
            if (status === "Rejected")
                return `<span class="badge bg-danger">Rejected</span>`;

            return `<span class="badge bg-secondary">${status}</span>`;
        }
            
        });

          function deleteDailyEntry(id, btn) {
            if (confirm("Are you sure you want to delete this entry?")) {

                $.post('/Provider/DeleteDailyEntry', { id: id }, function (res) {

                    if (res.success) {
                        $(btn).closest('tr').fadeOut(); // remove row smoothly
                    } else {
                        alert(res.message || "Delete failed");
                    }

                });

            }
        }
    </script>

}