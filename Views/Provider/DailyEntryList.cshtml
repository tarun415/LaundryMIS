@model List<LaudaryMis.ViewModels.DailyEntryListVM>

@{
    ViewBag.Title = "Daily Linen Entries";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-basket-shopping"></i></div>
    <div class="ph-text">
        <h1>Daily Linen Entries</h1>
        <p class="ph-sub">Linen picked up, delivered and still pending</p>
    </div>
    <div class="ph-actions">
        <a href="/Provider/DailyEntry" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New Entry
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- FILTERS -->
<div class="filter-bar">

    <div class="filter-field">
        <label class="form-label" for="filterStatus">Status</label>
        <select id="filterStatus" class="form-select">
            <option value="">All</option>
            <option>Pending</option>
            <option>Delivered</option>
            <option>Collected</option>
            <option>Partial</option>
            <option>Verified</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterHospital">Hospital</label>
        <select id="filterHospital" class="form-select">
            <option value="">All</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterWard">Ward</label>
        <select id="filterWard" class="form-select">
            <option value="">All</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterDate">Date</label>
        <input type="date" id="filterDate" class="form-control" />
    </div>

    <div class="filter-actions">
        <button id="btnSearch" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <button id="btnClear" class="btn btn-light">
            <i class="fa-solid fa-xmark"></i> Clear
        </button>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="entryTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>S.No.</th>
                        <th>Date</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th class="text-end">Pickup</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th>Status</th>
                        <th class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control" data-id="@item.EntryId"></td>
                            <td>@item.RowNum</td>
                            <td class="nowrap">@item.EntryDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-semibold">@item.HospitalName</td>
                            <td>@item.WardName</td>

                            <td class="text-end fw-bold text-teal">@item.TotalPickupQty</td>
                            <td class="text-end fw-bold text-success">@item.CleanDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.TotalPendingQty</td>

                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge badge-warn">Pending</span>
                                }
                                else if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-info">Delivered</span>
                                }
                                else if (item.Status == "Verified")
                                {
                                    <span class="badge badge-ok">Verified</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge badge-danger">Rejected</span>
                                }
                                else
                                {
                                    <span class="badge badge-navy">@item.Status</span>
                                }
                            </td>

                            <td class="text-end">
                                @if (item.Status == "Collected")
                                {
                                    <div class="action-group justify-content-end">
                                        <a href="/Provider/EditDailyEntry/@item.EntryId"
                                           class="btn btn-sm btn-icon btn-outline-primary"
                                           data-bs-toggle="tooltip" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm btn-icon btn-outline-danger"
                                                data-bs-toggle="tooltip" title="Delete"
                                                onclick="deleteDailyEntry(@item.EntryId, this)">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var table;

        // Shared config so the table keeps its toolbar after a search rebuild
        var TABLE_OPTIONS = {
            expandable: true,
            exportTitle: 'Daily Linen Entries',
            columnDefs: [
                { targets: 'no-sort', orderable: false }
            ]
        };

        $(function () {

            table = LMIS.initTable('#entryTable', $.extend(true, {}, TABLE_OPTIONS));

            // Filter options
            $.get('/Provider/GetHospitals', function (data) {
                var html = '<option value="">All</option>';
                data.forEach(function (x) { html += '<option value="' + x.id + '">' + x.name + '</option>'; });
                $('#filterHospital').html(html);
            });

            $.get('/Provider/GetWards', function (data) {
                var html = '<option value="">All</option>';
                data.forEach(function (x) { html += '<option value="' + x.id + '">' + x.name + '</option>'; });
                $('#filterWard').html(html);
            });

            // Expand / collapse linen detail
            $('#entryTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var id = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Provider/DailyEntryItems/' + id, function (data) {
                    row.child(formatItems(data)).show();
                    tr.addClass('shown');
                });
            });

            // Search
            $('#btnSearch').on('click', function () {

                $.get('/Provider/SearchDailyEntries', {
                    status: $('#filterStatus').val(),
                    hospitalId: $('#filterHospital').val(),
                    wardId: $('#filterWard').val(),
                    date: $('#filterDate').val()
                }, function (res) {

                    var rows = "";

                    res.forEach(function (item) {

                        var actionCell = '<span class="text-muted">&mdash;</span>';

                        if (item.status === "Collected") {
                            actionCell =
                                '<div class="action-group justify-content-end">' +
                                    '<a href="/Provider/EditDailyEntry/' + item.entryId + '" class="btn btn-sm btn-icon btn-outline-primary" title="Edit">' +
                                        '<i class="fa-solid fa-pen"></i></a>' +
                                    '<button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Delete" onclick="deleteDailyEntry(' + item.entryId + ', this)">' +
                                        '<i class="fa-solid fa-trash"></i></button>' +
                                '</div>';
                        }

                        rows +=
                            '<tr>' +
                                '<td class="details-control" data-id="' + item.entryId + '"></td>' +
                                '<td>' + item.rowNum + '</td>' +
                                '<td class="nowrap">' + formatDate(item.entryDate) + '</td>' +
                                '<td class="fw-semibold">' + item.hospitalName + '</td>' +
                                '<td>' + item.wardName + '</td>' +
                                '<td class="text-end fw-bold text-teal">' + item.totalPickupQty + '</td>' +
                                '<td class="text-end fw-bold text-success">' + item.cleanDeliveredQty + '</td>' +
                                '<td class="text-end fw-bold text-danger">' + item.totalPendingQty + '</td>' +
                                '<td>' + getStatusBadge(item.status) + '</td>' +
                                '<td class="text-end">' + actionCell + '</td>' +
                            '</tr>';
                    });

                    // Rebuild with the same options, otherwise the toolbar and
                    // export buttons are lost on the second initialisation.
                    table.clear().destroy();
                    $('#entryTable tbody').html(rows);
                    table = LMIS.initTable('#entryTable', $.extend(true, {}, TABLE_OPTIONS));

                }).fail(function () {
                    LMIS.alert('Search failed', 'Could not load daily entries.', 'error');
                });

            });

            // Clear
            $('#btnClear').on('click', function () {
                $('#filterStatus').val('');
                $('#filterHospital').val('');
                $('#filterWard').val('');
                $('#filterDate').val('');
                $('#btnSearch').click();
            });

        });

        function formatItems(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Linen Type</th>' +
                        '<th class="text-end">Pickup</th>' +
                        '<th class="text-end">Delivered</th>' +
                        '<th class="text-end">Pending</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td>' + x.linenTypeName + '</td>' +
                        '<td class="text-end fw-bold text-teal">' + x.totalPickupQty + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.cleanDeliveredQty + '</td>' +
                        '<td class="text-end fw-bold text-danger">' + x.totalpendingQty + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

        function formatDate(data) {
            return new Date(data).toLocaleDateString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric'
            });
        }

        function getStatusBadge(status) {
            if (status === "Pending")   return '<span class="badge badge-warn">Pending</span>';
            if (status === "Delivered") return '<span class="badge badge-info">Delivered</span>';
            if (status === "Verified")  return '<span class="badge badge-ok">Verified</span>';
            if (status === "Rejected")  return '<span class="badge badge-danger">Rejected</span>';
            return '<span class="badge badge-navy">' + status + '</span>';
        }

        function deleteDailyEntry(id, btn) {
            LMIS.confirm({
                title: 'Delete this entry?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Provider/DeleteDailyEntry', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#entryTable', btn);
                        LMIS.toast('Entry deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                });
            });
        }

    </script>
}
