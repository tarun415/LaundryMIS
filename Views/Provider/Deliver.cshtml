@model dynamic

@{
    ViewBag.Title = "Deliver Clean Linen";
}

@section Styles {
    <style>
        .table-scroll {
            max-height: 380px;
            overflow: auto;
            border: 1px solid var(--line);
            border-radius: var(--r-sm);
        }
        .table-scroll table { margin: 0; }
        .table-scroll thead th { position: sticky; top: 0; z-index: 2; }
        .table-scroll input.clean { max-width: 130px; margin-left: auto; text-align: right; }
    </style>
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck"></i></div>
    <div class="ph-text">
        <h1>Deliver Clean Linen</h1>
        <p class="ph-sub">Enter the clean linen being returned against this entry</p>
    </div>
    <div class="ph-actions">
        <a href="~/Provider/Pending" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<input type="hidden" id="entryId" value="@Model.Entry.Id" />

<div class="card mb-3">
    <div class="card-header">
        <i class="fa-solid fa-shirt text-teal"></i>
        <span class="card-title">Linen Items</span>
        <span class="info-pill ms-auto">
            <i class="fa-solid fa-calculator"></i>
            Entering: <strong id="cleanTotal">0</strong>
        </span>
    </div>

    <div class="card-body">
        <div class="table-scroll">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Linen</th>
                        <th class="text-end">Dirty</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Remaining</th>
                        <th class="text-end" style="width: 170px;">Enter Clean</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var remaining = item.DirtyCount - item.DeliveredCount;

                        <tr>
                            <td class="fw-semibold">@item.LinenType</td>

                            <td class="text-end">@item.DirtyCount</td>

                            <td class="text-end fw-bold text-success">@item.DeliveredCount</td>

                            <td class="text-end fw-bold @(remaining == 0 ? "text-success" : "text-danger")">
                                @remaining
                            </td>

                            <td class="text-end">
                                <input type="number" min="0" inputmode="numeric"
                                       class="clean form-control form-control-sm"
                                       data-type="@item.LinenType"
                                       data-remaining="@remaining"
                                       placeholder="0"
                                       @(remaining == 0 ? "disabled" : "") />
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-user-check text-teal"></i>
        <span class="card-title">Handover Details</span>
    </div>

    <div class="card-body">
        <div class="row g-3">

            <div class="col-12 col-md-4">
                <label class="form-label" for="deliveredBy">Delivered By</label>
                <input type="text" id="deliveredBy" class="form-control" placeholder="Enter name" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" for="receivedBackBy">Received Back By</label>
                <input type="text" id="receivedBackBy" class="form-control" placeholder="Enter name" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" for="remarks">Remarks</label>
                <input type="text" id="remarks" class="form-control" placeholder="Optional remarks" />
            </div>

        </div>

        <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-3 border-top">
            <a href="~/Provider/Pending" class="btn btn-light">Cancel</a>
            <button type="button" id="btnSaveDelivery" class="btn btn-primary" onclick="saveDelivery()">
                <i class="fa-solid fa-floppy-disk"></i> Save Delivery
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>

        $(function () {
            $(document).on('input', '.clean', function () {
                var total = 0;
                $('.clean').each(function () { total += parseInt($(this).val(), 10) || 0; });
                $('#cleanTotal').text(LMIS.num(total));
            });
        });

        async function saveDelivery() {

            var items = [];

            for (var i of document.querySelectorAll(".clean")) {

                var clean = parseInt(i.value, 10) || 0;
                var remaining = parseInt(i.dataset.remaining, 10);

                if (clean > remaining) {
                    LMIS.alert("Too many items",
                               '"' + i.dataset.type + '" cannot exceed the remaining quantity of ' + remaining + '.',
                               "warning");
                    return;
                }

                if (clean > 0) {
                    items.push({ linenType: i.dataset.type, cleanCount: clean });
                }
            }

            if (items.length === 0) {
                LMIS.alert("Nothing to save", "Enter a clean count for at least one linen type.", "warning");
                return;
            }

            var data = {
                entryId: parseInt(document.getElementById("entryId").value, 10),
                deliveredBy: document.getElementById("deliveredBy").value,
                receivedBackBy: document.getElementById("receivedBackBy").value,
                remarks: document.getElementById("remarks").value,
                items: items
            };

            var btn = document.getElementById("btnSaveDelivery");
            btn.disabled = true;

            try {
                const res = await fetch('/Provider/Deliver', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const r = await res.json();

                if (r.success) {
                    LMIS.toast("Delivery saved");
                    setTimeout(function () { window.location.href = appUrl("/Provider/Pending"); }, 700);
                } else {
                    btn.disabled = false;
                    LMIS.alert("Save failed", r.message || "Please try again.", "error");
                }
            } catch (ex) {
                btn.disabled = false;
                console.error(ex);
                LMIS.alert("Save failed", "An error occurred while saving the delivery.", "error");
            }
        }

    </script>
}
