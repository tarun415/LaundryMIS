@{
    ViewBag.Title = "Weekly Performance Report";
}

@*
    ProviderController.WPREntry() returns View() with no model and there is no
    matching [HttpPost] action, so this screen scores locally but cannot save yet.
    Point the form at a save action and replace submitHospWPR() to finish it.
*@

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-clipboard-check"></i></div>
    <div class="ph-text">
        <h1>Submit Weekly Performance Report</h1>
        <p class="ph-sub">Score parameters and submit for payment processing</p>
    </div>
</div>

<div class="row g-3">

    <!-- REPORT DETAILS -->
    <div class="col-12 col-xl-7">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-file-pen text-teal"></i>
                <span class="card-title">Report Details</span>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="w-week">Week</label>
                        <select class="form-select" id="w-week">
                            <option value="1">Week 1</option>
                            <option value="2">Week 2</option>
                            <option value="3">Week 3</option>
                            <option value="4">Week 4</option>
                            <option value="5">Week 5</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="w-month">Month</label>
                        <select class="form-select" id="w-month">
                            <option>January</option><option>February</option><option>March</option>
                            <option>April</option><option>May</option><option>June</option>
                            <option>July</option><option>August</option><option>September</option>
                            <option>October</option><option>November</option><option>December</option>
                        </select>
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="w-year">Year</label>
                        <input class="form-control" type="number" id="w-year" />
                    </div>

                    <div class="col-12 col-sm-6">
                        <label class="form-label" for="w-staff">Designated Staff</label>
                        <input class="form-control" id="w-staff" placeholder="Staff name" />
                    </div>

                    <div class="col-12">
                        <label class="form-label" for="w-remarks">Remarks</label>
                        <textarea class="form-control" id="w-remarks" rows="3" placeholder="Optional…"></textarea>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- LIVE SCORE -->
    <div class="col-12 col-xl-5">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-bullseye text-teal"></i>
                <span class="card-title">Live Score</span>
            </div>

            <div class="card-body d-flex flex-column">

                <div class="text-center mb-2">
                    <div class="score-big" id="wprLiveScore">0</div>
                    <div class="score-sub">out of 100</div>
                </div>

                <div class="score-meter">
                    <div class="score-fill" id="wprScoreFill" style="width:0%"></div>
                </div>

                <div class="text-center mt-3">
                    <span class="badge badge-none" id="wprScoreLabel">Score parameters below</span>
                </div>

                <div class="alert alert-warning mt-3 mb-0">
                    <i class="fa-solid fa-calendar-day"></i>
                    <span>WPR must be uploaded by the 5th day of the succeeding week.</span>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-light flex-fill" onclick="resetHospWPR()">
                        <i class="fa-solid fa-rotate-left"></i> Reset
                    </button>
                    <button type="button" class="btn btn-primary flex-fill" onclick="submitHospWPR()">
                        <i class="fa-solid fa-check"></i> Submit WPR
                    </button>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- PARAMETERS -->
<div class="card kpi-section mt-3">
    <div class="card-header">
        <i class="fa-solid fa-list-check text-teal"></i>
        <span class="card-title">10 Performance Parameters</span>
        <span id="wprCount" class="ms-auto">0 / 10 scored</span>
    </div>

    <div class="card-body pb-0 pt-3">
        <p class="text-muted small mb-0">
            <i class="fa-solid fa-circle-info"></i>
            Choose an option for each parameter to auto-calculate the score.
        </p>
    </div>

    <div id="wprRows" class="mt-2"></div>
</div>

@section Scripts {
    <script>

        // Parameter definitions: [label, goodText, avgText, poorText]
        const HOSP_PARAMS = [
            ["Hospital linen quality after wash", "Good", "Average", "Poor"],
            ["Timely supply of clean and washed linen", "Good", "Average", "Poor"],
            ["Washing procedure/formula followed; quality consumables used", "Strictly Followed", "Normally Followed", "Not Followed"],
            ["Laundry personnel displaying photo identity card", "Strictly Followed", "Normally Followed", "Not Followed"],
            ["Behavior of laundry personnel towards hospital staff/patients", "Good", "Average", "Poor"],
            ["Personnel NOT found smoking/drinking/sleeping during duty", "Never", "Sometimes", "Mostly"],
            ["Only approved personnel on duty (per approved list)", "Never Violated", "Sometimes", "Mostly Violated"],
            ["Breakdown of equipment (lower is better)", "Never", "Sometimes", "Mostly"],
            ["Alternate arrangement done during breakdown", "Mostly", "Sometimes", "Never"],
            ["Number of warning letters issued by Hospital Authority", "1 letter", "2 letters", "3+ letters"]
        ];

        const GRADES = [
            { key: 'g', score: 10, cls: 'sg', badge: 'sc-good', label: 'Good' },
            { key: 'a', score: 5,  cls: 'sa', badge: 'sc-avg',  label: 'Average' },
            { key: 'p', score: 2,  cls: 'sp', badge: 'sc-poor', label: 'Poor' }
        ];

        let hospScores = {};

        (function buildRows() {

            const container = document.getElementById("wprRows");
            const now = new Date();

            document.getElementById("w-year").value = now.getFullYear();
            document.getElementById("w-month").selectedIndex = now.getMonth();

            HOSP_PARAMS.forEach(function (p, idx) {

                const i = idx + 1;
                const row = document.createElement("div");
                row.className = "kpi-row";
                row.id = "row_" + i;

                let buttons = "";
                GRADES.forEach(function (g, gi) {
                    buttons +=
                        '<button type="button" class="kb" id="kb' + i + g.key + '" ' +
                        'title="' + p[gi + 1] + '" ' +
                        'onclick="setHospScore(' + i + ',\'' + g.key + '\')">' +
                        p[gi + 1] + '</button>';
                });

                row.innerHTML =
                    '<div class="kpi-n">' + i + '</div>' +
                    '<div class="kpi-lbl">' + p[0] +
                        '<div class="stat-sub">Max: 10 marks</div>' +
                    '</div>' +
                    '<div class="kpi-btns">' + buttons + '</div>' +
                    '<div class="kpi-sc" id="ks' + i + '"><span>—</span></div>';

                container.appendChild(row);
            });

        })();

        function setHospScore(i, gradeKey) {

            const grade = GRADES.find(function (g) { return g.key === gradeKey; });
            if (!grade) return;

            hospScores[i] = grade.score;

            GRADES.forEach(function (g) {
                const btn = document.getElementById("kb" + i + g.key);
                if (btn) btn.classList.remove('sg', 'sa', 'sp');
            });

            const selected = document.getElementById("kb" + i + gradeKey);
            if (selected) selected.classList.add(grade.cls);

            document.getElementById("ks" + i).innerHTML =
                '<span class="sc-badge ' + grade.badge + '">' + grade.label + ' (' + grade.score + '/10)</span>';

            calcHospWPR();
        }

        function calcHospWPR() {

            let total = 0, count = 0;
            for (const k in hospScores) { total += hospScores[k]; count++; }

            document.getElementById("wprLiveScore").textContent = total;
            document.getElementById("wprCount").textContent = count + " / 10 scored";

            const fill = document.getElementById("wprScoreFill");
            fill.style.width = total + "%";
            fill.classList.remove('sc-good', 'sc-avg', 'sc-poor');
            fill.classList.add(total > 60 ? 'sc-good' : total > 20 ? 'sc-avg' : 'sc-poor');

            let label, cls;
            if (count === 0)      { label = "Score parameters below"; cls = "badge-none"; }
            else if (total <= 20) { label = "0% — No Payment";        cls = "badge-none"; }
            else if (total <= 40) { label = "40% Payment";            cls = "badge-low"; }
            else if (total <= 60) { label = "60% Payment";            cls = "badge-mid"; }
            else if (total <= 80) { label = "90% Payment";            cls = "badge-good"; }
            else                  { label = "100% Payment";           cls = "badge-full"; }

            const el = document.getElementById("wprScoreLabel");
            el.textContent = label;
            el.className = "badge " + cls;
        }

        function resetHospWPR() {

            hospScores = {};

            for (let i = 1; i <= HOSP_PARAMS.length; i++) {
                GRADES.forEach(function (g) {
                    const btn = document.getElementById("kb" + i + g.key);
                    if (btn) btn.classList.remove('sg', 'sa', 'sp');
                });
                document.getElementById("ks" + i).innerHTML = "<span>—</span>";
            }

            calcHospWPR();
        }

        function submitHospWPR() {

            const scored = Object.keys(hospScores).length;

            if (scored < HOSP_PARAMS.length) {
                LMIS.alert("Incomplete scoring",
                           "Please score all " + HOSP_PARAMS.length + " parameters before submitting.",
                           "warning");
                return;
            }

            // No save endpoint exists for this screen yet — see the note at the top of the file.
            LMIS.alert("Not available yet",
                       "Submission for this screen is not connected to the server. " +
                       "Use the WPR Entry screen to file a weekly report.",
                       "info");
        }

    </script>
}
