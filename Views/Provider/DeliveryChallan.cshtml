@model LaudaryMis.ViewModels.DeliveryChallanVM

@{
    ViewBag.Title = "Delivery Challan";
}

@section Styles {
    <style>
        .table-scroll {
            max-height: 420px;
            overflow: auto;
            border: 1px solid var(--line);
            border-radius: var(--r-sm);
        }
        .table-scroll table { margin: 0; }
        .table-scroll thead th { position: sticky; top: 0; z-index: 2; }
        .table-scroll input.deliveryQty { max-width: 130px; margin-left: auto; text-align: right; }
    </style>
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
    <div class="ph-text">
        <h1>Delivery Challan</h1>
        <p class="ph-sub">Pickup No: <strong>@Model.PickupNo</strong></p>
    </div>
    <div class="ph-actions">
        <a href="/Provider/AcceptPickup" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<input type="hidden" id="PickupId" value="@Model.PickupId" />

<div class="card mb-3">
    <div class="card-header">
        <i class="fa-solid fa-shirt text-teal"></i>
        <span class="card-title">Linen Items</span>
        <span class="info-pill ms-auto">
            <i class="fa-solid fa-calculator"></i>
            Delivering: <strong id="deliveryTotal">0</strong>
        </span>
    </div>

    <div class="card-body">
        <div class="table-scroll">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Linen</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th class="text-end" style="width: 170px;">Delivery Qty</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @item.LinenName
                                <input type="hidden" class="linenTypeId" value="@item.LinenTypeId" />
                            </td>

                            <td class="text-end">@item.CollectedQty</td>

                            <td class="text-end fw-bold text-success">@item.DeliveredQty</td>

                            <td class="text-end fw-bold @(item.PendingQty == 0 ? "text-success" : "text-danger")">
                                @item.PendingQty
                            </td>

                            <td class="text-end">
                                <input type="number" min="0" max="@item.PendingQty" inputmode="numeric"
                                       class="form-control form-control-sm deliveryQty"
                                       value="0"
                                       data-pending="@item.PendingQty"
                                       @(item.PendingQty == 0 ? "disabled" : "") />
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-user-check text-teal"></i>
        <span class="card-title">Handover Details</span>
    </div>

    <div class="card-body">
        <div class="row g-3">

            <div class="col-12 col-md-4">
                <label class="form-label" for="DeliveredBy">Delivered By</label>
                <input type="text" id="DeliveredBy" class="form-control" placeholder="Enter name" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" for="ReceivedBy">Received By</label>
                <input type="text" id="ReceivedBy" class="form-control" placeholder="Enter name" />
            </div>

            <div class="col-12 col-md-4">
                <label class="form-label" for="Remarks">Remarks</label>
                <input type="text" id="Remarks" class="form-control" placeholder="Optional remarks" />
            </div>

        </div>

        <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-3 border-top">
            <a href="/Provider/AcceptPickup" class="btn btn-light">Cancel</a>
            <button type="button" id="btnSaveDelivery" class="btn btn-primary" onclick="saveDelivery()">
                <i class="fa-solid fa-floppy-disk"></i> Save Delivery
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>

        $(function () {
            $(document).on('input', '.deliveryQty', function () {
                var total = 0;
                $('.deliveryQty').each(function () { total += parseInt($(this).val(), 10) || 0; });
                $('#deliveryTotal').text(LMIS.num(total));
            });
        });

        async function saveDelivery() {

            var items = [];
            var rows = document.querySelectorAll("tbody tr");

            for (var row of rows) {

                var linenTypeIdEl = row.querySelector(".linenTypeId");
                var qtyBox = row.querySelector(".deliveryQty");
                if (!linenTypeIdEl || !qtyBox) continue;

                var linenTypeId = parseInt(linenTypeIdEl.value, 10);
                var deliveryQty = parseInt(qtyBox.value, 10) || 0;
                var pendingQty = parseInt(qtyBox.dataset.pending, 10);

                if (deliveryQty > pendingQty) {
                    LMIS.alert("Too many items",
                               "Delivery quantity cannot exceed the pending quantity of " + pendingQty + ".",
                               "warning");
                    return;
                }

                if (deliveryQty > 0) {
                    items.push({ linenTypeId: linenTypeId, deliveryQty: deliveryQty });
                }
            }

            if (items.length === 0) {
                LMIS.alert("Nothing to save", "Please enter at least one delivery quantity.", "warning");
                return;
            }

            var model = {
                pickupId: parseInt(document.getElementById("PickupId").value, 10),
                deliveredBy: document.getElementById("DeliveredBy").value,
                receivedBy: document.getElementById("ReceivedBy").value,
                remarks: document.getElementById("Remarks").value,
                items: items
            };

            var btn = document.getElementById("btnSaveDelivery");
            btn.disabled = true;

            try {
                const response = await fetch('/Provider/DeliveryChallan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(model)
                });

                const result = await response.json();

                if (result.success) {
                    LMIS.toast("Delivery saved successfully");
                    setTimeout(function () { window.location.href = '/Provider/AcceptPickup'; }, 700);
                } else {
                    btn.disabled = false;
                    LMIS.alert("Save failed", result.message || "Please try again.", "error");
                }
            } catch (ex) {
                btn.disabled = false;
                console.error(ex);
                LMIS.alert("Save failed", "An error occurred while saving the delivery.", "error");
            }
        }

    </script>
}
