@using LaudaryMis.Models
@{
    ViewData["Title"] = "Provider Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var hospitals = ViewBag.Hospitals as List<Hospital> ?? new List<Hospital>();
    int month = ViewBag.CurrentMonth != null ? (int)ViewBag.CurrentMonth : DateTime.Now.Month;
    int year = ViewBag.CurrentYear != null ? (int)ViewBag.CurrentYear : DateTime.Now.Year;
    string mName = ViewBag.MonthName as string ?? DateTime.Now.ToString("MMMM yyyy");
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck-fast"></i></div>
    <div class="ph-text">
        <h1>Provider Dashboard</h1>
        <p class="ph-sub">Laundry Service Management</p>
    </div>
</div>

<!-- Quick Links -->
<div class="row g-3">

    <div class="col-6 col-xl-3">
        <a asp-action="DailyEntry" class="stat-card is-teal h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-basket-shopping"></i></div>
            <div class="min-w-0">
                <div class="stat-lbl">Daily Linen Log</div>
                <div class="stat-sub">Record today's linen</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-xl-3">
        <a asp-action="Pending" class="stat-card is-warn h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-lbl">Pending</div>
                <div class="stat-sub">Awaiting action</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-xl-3">
        <a asp-action="DailyEntryList" class="stat-card is-navy h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-chart-column"></i></div>
            <div class="min-w-0">
                <div class="stat-lbl">Reports</div>
                <div class="stat-sub">Entry history</div>
            </div>
        </a>
    </div>

    <div class="col-6 col-xl-3">
        <a asp-controller="MonthlyBill" asp-action="MyBills" class="stat-card is-ok h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-file-invoice"></i></div>
            <div class="min-w-0">
                <div class="stat-lbl">My Bills</div>
                <div class="stat-sub">Submitted bills</div>
            </div>
        </a>
    </div>

</div>

