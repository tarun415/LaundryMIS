@model List<LaudaryMis.ViewModels.PickupListVM>

<style>

    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        border: none;
        color: #fff;
        font-weight: 500;
    }

    .dt-buttons {
        display: flex;
        gap: 6px;
    }

        .dt-buttons .btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            border: none;
        }

    .buttons-copy {
        background: #6c757d !important;
    }

    .buttons-excel {
        background: #198754 !important;
    }

    .buttons-pdf {
        background: #dc3545 !important;
    }

    .buttons-print {
        background: #0d6efd !important;
    }

    .dataTables_filter input {
        border-radius: 20px;
        padding: 5px 10px;
    }

    .child-table {
        width: 100% !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        border-radius: 15px;
        padding: 4px 8px;
        margin-left: 5px;
    }

</style>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="fw-bold">
            🚚 Pickup Entries
        </h4>

       @*  <a href="/Hospital/CreatePickUp"
           class="btn btn-primary rounded-pill px-4">

            + New Pickup

        </a> *@

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- FILTER -->

    <div class="card shadow-sm border-0 rounded-3 mb-2">

        <div class="card-body">

            <div class="row g-2 align-items-end">

                <div class="col-md-2">

                    <label>Status</label>

                    <select id="filterStatus"
                            class="form-select">

                        <option value="">All</option>
                        <option value="Collected">Collected</option>
                        <option value="Accepted">Accepted</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Pending">Pending</option>
                        <option value="Verified">Verified</option>

                    </select>

                </div>

                <div class="col-md-3">

                    <label>Ward</label>

                    <select id="filterWard"
                            class="form-select">

                        <option value="">All</option>

                    </select>

                </div>

                <div class="col-md-2">

                    <label>Date</label>

                    <input type="date"
                           id="filterDate"
                           class="form-control" />

                </div>

                <div class="col-md-1 d-grid">

                    <button id="btnSearch"
                            class="btn btn-primary mt-4">

                        🔍

                    </button>

                </div>

                <div class="col-md-1 d-grid">

                    <button id="btnClear"
                            class="btn btn-outline-secondary mt-4">

                        ✖

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- TABLE -->

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body">

            <div class="table-responsive">

                <table id="pickupTable"
                       class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th></th>
                            <th>S.No.</th>
                            <th>Pickup No</th>
                            <th>Date</th>
                            <th>Hospital</th>
                            <th>Ward</th>
                            <th>Shift</th>
                            <th>Collected Qty</th>
                            <th>Delivered Qty</th>
                            <th>Pending Qty</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="details-control text-center"
                                    data-id="@item.PickupId"
                                    style="cursor:pointer;">

                                    ➕

                                </td>

                                <td>@item.RowNum</td>

                                <td class="fw-semibold text-primary">
                                    @item.PickupNo
                                </td>

                                <td>
                                    @item.PickupDateTime.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.HospitalName
                                </td>

                                <td>
                                    @item.WardName
                                </td>

                                <td>
                                    @item.ShiftName
                                </td>

                                <td class="fw-bold text-primary">
                                    @item.TotalCollectedQty
                                </td>
                                <td class="fw-bold text-success">
                                    @item.TotalDeliveredQty
                                </td>
                                <td class="fw-bold text-danger">
                                    @item.TotalPendingQty
                                </td>

                                <td>

                                    @if (item.Status == "Collected")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Collected
                                        </span>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="badge bg-info text-dark">
                                            Delivered
                                        </span>
                                    }
                                    else if (item.Status == "Verified")
                                    {
                                        <span class="badge bg-success">
                                            Verified
                                        </span>
                                    }
                                    else if (item.Status == "Accepted")
                                    {
                                        <span class="badge bg-primary">
                                            Accepted
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>

                                    @if (item.Status == "Collected")
                                    {
                                        <div class="text-center">
                                            <button type="button"
                                                    class="btn btn-sm btn-success rounded-pill px-3"
                                                    onclick="acceptPickup(@item.PickupId)">
                                                <i class="fa fa-check"></i> Accept
                                            </button>
                                        </div>
                                    }
                                    else if (item.Status == "Accepted" || item.Status == "Partial Delivered")
                                    {
                                        <div class="text-center">
                                            <a href="/Provider/DeliveryChallan/@item.PickupId"
                                               class="btn btn-sm btn-primary rounded-pill px-3">
                                                <i class="fa fa-truck"></i> Deliver
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            var table = $('#pickupTable').DataTable({

                pageLength: 10,

                responsive: true,

                dom:
                    "<'row mb-2 align-items-center'<'col-md-4'l><'col-md-8 d-flex justify-content-end gap-2'Bf>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",

                buttons: [

                    {
                        extend: 'copy',
                        className: 'btn buttons-copy',
                        text: '📋'
                    },

                    {
                        extend: 'excel',
                        className: 'btn buttons-excel',
                        text: '📊'
                    },

                    {
                        extend: 'pdf',
                        className: 'btn buttons-pdf',
                        text: '📄'
                    },

                    {
                        extend: 'print',
                        className: 'btn buttons-print',
                        text: '🖨️'
                    }

                ]
            });

            function format(items,id) {

                let html =
                `<table id="childTable_${id}"
                        class="table table-bordered table-sm child-table">

                    <thead>
                        <tr>
                            <th>Linen Type</th>
                            <th>Collected Qty</th>
                            <th>Delivered Qty</th>
                            <th>Pending Qty</th>
                        </tr>
                    </thead>
                    <tbody>`;

                items.forEach(x => {

                    html += `
                        <tr>
                            <td>${x.linenTypeName}</td>
                            <td class="fw-bold text-primary">${x.collectedQty}</td>
            <td class="fw-bold text-success">${x.deliveredQty}</td>
            <td class="fw-bold text-danger">${x.pendingQty}</td>
                        </tr>`;
                });

                html += "</tbody></table>";

                return html;
            }

            $('#pickupTable tbody').on(
                'click',
                'td.details-control',
                function () {

                    var tr = $(this).closest('tr');
                    var row = table.row(tr);
                    var id = $(this).data('id');

                    if (row.child.isShown()) {

                        row.child.hide();
                        tr.removeClass('shown');
                        $(this).html("➕");
                    }
                    else {

                        $.get('/Hospital/PickupItems/' + id,
                            function (data) {

                                row.child(
                                    format(data,id)
                                ).show();

                                tr.addClass('shown');

                                tr.find('.details-control')
                                  .html("➖");

                            });
                    }
                });

            $.get('/Common/GetWards', function (data) {

                let html = '<option value="">All</option>';

                data.forEach(x => {

                    html += `<option value="${x.id}">
                                ${x.name}
                            </option>`;
                });

                $('#filterWard').html(html);

            });

                  $('#btnSearch').click(function () {

            $.get('/Hospital/SearchPickupList',
            {
                status: $('#filterStatus').val(),
                wardId: $('#filterWard').val(),
                date: $('#filterDate').val()
            },
            function (res) {

                table.clear();

                res.forEach(function (item) {

                    var statusBadge = '';

                    if (item.status === "Collected")
                        statusBadge = '<span class="badge bg-warning text-dark">Collected</span>';
                    else if (item.status === "Delivered")
                        statusBadge = '<span class="badge bg-info text-dark">Delivered</span>';
                    else if (item.status === "Verified")
                        statusBadge = '<span class="badge bg-success">Verified</span>';
                    else if (item.status === "Accepted")
                        statusBadge = '<span class="badge bg-primary">Accepted</span>';
                    else
                        statusBadge = '<span class="badge bg-secondary">' + item.status + '</span>';

                            var actionButtons = '';

        if (item.status === "Collected") {

            actionButtons =
            `<div class="text-center">
                <button type="button"
                        class="btn btn-sm btn-success rounded-pill px-3"
                        onclick="acceptPickup(${item.pickupId})">

                    <i class="fa fa-check"></i> Accept
                </button>
            </div>`;
        }
        else if (item.status === "Accepted"||item.status === "Partial Delivered") {

            actionButtons =
            `<div class="text-center">
                <a href="/Provider/DeliveryChallan/${item.pickupId}"
                   class="btn btn-sm btn-primary rounded-pill px-3">

                    <i class="fa fa-truck"></i> Deliver
                </a>
            </div>`;
        }

                    table.row.add([
                        `<span class="details-control text-center"
                                data-id="${item.pickupId}"
                                style="cursor:pointer;">
                            ➕
                         </span>`,
                        item.rowNum,
                        item.pickupNo,
                        formatDate(item.pickupDateTime),
                        item.hospitalName,
                        item.wardName,
                        item.shiftName,
                          item.totalCollectedQty,
                                  item.totalDeliveredQty,
                                    item.totalPendingQty,
                        statusBadge,
                        actionButtons
                    ]);

                });

                table.draw();

            }).fail(function () {

                alert("Error loading data");

            });

        });

            $('#btnClear').click(function () {

                $('#filterStatus').val('');
                $('#filterWard').val('');
                $('#filterDate').val('');

                location.reload();

            });

        });

        function formatDate(data) {

            let d = new Date(data);

            return d.toLocaleDateString('en-GB',{
                day:'2-digit',
                month:'short',
                year:'numeric'
            });
        }

        function deletePickup(id,btn){

            if(confirm('Are you sure?')){

                $.post('/Hospital/DeletePickup',
                {
                    id:id
                },
                function(res){

                    if(res.success){

                        $(btn)
                        .closest('tr')
                        .fadeOut();

                    }
                    else{

                        alert(res.message);

                    }

                });
            }
        }
        function acceptPickup(id) {

            if (!confirm("Are you sure you want to accept this pickup?"))
                return;

            $.ajax({

                url: '/Provider/AcceptPickup',
                type: 'POST',

                data: {
                    PickupId: id,
                    Remarks: ''
                },

                success: function (res) {

                    if (res.success) {

                        alert(res.message);

                        $('#btnSearch').click();
                    }
                    else {

                        alert(res.message);
                    }
                },

                error: function () {

                    alert('Error while accepting pickup.');
                }

            });
        }
    </script>

}