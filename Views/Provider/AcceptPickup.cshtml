@model List<LaudaryMis.ViewModels.PickupListVM>

@{
    ViewBag.Title = "Accept Pickup";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hand-holding-hand"></i></div>
    <div class="ph-text">
        <h1>Accept Pickup</h1>
        <p class="ph-sub">Review collected linen and confirm acceptance</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- FILTERS -->
<div class="filter-bar">

    <div class="filter-field">
        <label class="form-label" for="filterStatus">Status</label>
        <select id="filterStatus" class="form-select">
            <option value="">All</option>
            <option value="Collected">Collected</option>
            <option value="Accepted">Accepted</option>
            <option value="Delivered">Delivered</option>
            <option value="Pending">Pending</option>
            <option value="Verified">Verified</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterWard">Ward</label>
        <select id="filterWard" class="form-select">
            <option value="">All</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterDate">Date</label>
        <input type="date" id="filterDate" class="form-control" />
    </div>

    <div class="filter-actions">
        <button id="btnSearch" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <button id="btnClear" class="btn btn-light">
            <i class="fa-solid fa-xmark"></i> Clear
        </button>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="pickupTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>S.No.</th>
                        <th>Pickup No</th>
                        <th>Date</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th>Shift</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th>Status</th>
                        <th class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control" data-id="@item.PickupId"></td>

                            <td>@item.RowNum</td>

                            <td class="fw-semibold text-teal">@item.PickupNo</td>

                            <td class="nowrap">@item.PickupDateTime.ToString("dd MMM yyyy")</td>

                            <td>@item.HospitalName</td>
                            <td>@item.WardName</td>
                            <td>@item.ShiftName</td>

                            <td class="text-end fw-bold text-teal">@item.TotalCollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.TotalDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.TotalPendingQty</td>

                            <td>
                                @if (item.Status == "Collected")
                                {
                                    <span class="badge badge-warn">Collected</span>
                                }
                                else if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-info">Delivered</span>
                                }
                                else if (item.Status == "Verified")
                                {
                                    <span class="badge badge-ok">Verified</span>
                                }
                                else if (item.Status == "Accepted")
                                {
                                    <span class="badge badge-teal">Accepted</span>
                                }
                                else
                                {
                                    <span class="badge badge-navy">@item.Status</span>
                                }
                            </td>

                            <td class="text-end">
                                @if (item.Status == "Collected")
                                {
                                    <button type="button" class="btn btn-sm btn-success"
                                            onclick="acceptPickup(@item.PickupId)">
                                        <i class="fa-solid fa-check"></i> Accept
                                    </button>
                                }
                                else if (item.Status == "Accepted" || item.Status == "Partial Delivered")
                                {
                                    <a href="/Provider/DeliveryChallan/@item.PickupId" class="btn btn-sm btn-primary">
                                        <i class="fa-solid fa-truck"></i> Deliver
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        var table;

        $(function () {

            // expandable: this table owns its row.child() detail rows,
            // so Responsive is off and the table scrolls sideways instead.
            table = LMIS.initTable('#pickupTable', {
                expandable: true,
                exportTitle: 'Pickup Entries',
                order: [],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            // Ward filter options
            $.get('/Common/GetWards', function (data) {
                var html = '<option value="">All</option>';
                data.forEach(function (x) {
                    html += '<option value="' + x.id + '">' + x.name + '</option>';
                });
                $('#filterWard').html(html);
            });

            // Expand / collapse linen detail
            $('#pickupTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var id = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Hospital/PickupItems/' + id, function (data) {
                    row.child(formatItems(data)).show();
                    tr.addClass('shown');
                });
            });

            // Search
            $('#btnSearch').on('click', function () {

                $.get('/Hospital/SearchPickupList', {
                    status: $('#filterStatus').val(),
                    wardId: $('#filterWard').val(),
                    date: $('#filterDate').val()
                }, function (res) {

                    table.clear();

                    res.forEach(function (item) {

                        var statusBadge;
                        switch (item.status) {
                            case "Collected": statusBadge = '<span class="badge badge-warn">Collected</span>'; break;
                            case "Delivered": statusBadge = '<span class="badge badge-info">Delivered</span>'; break;
                            case "Verified":  statusBadge = '<span class="badge badge-ok">Verified</span>'; break;
                            case "Accepted":  statusBadge = '<span class="badge badge-teal">Accepted</span>'; break;
                            default:          statusBadge = '<span class="badge badge-navy">' + item.status + '</span>';
                        }

                        var actionButtons = '<span class="text-muted">&mdash;</span>';

                        if (item.status === "Collected") {
                            actionButtons =
                                '<button type="button" class="btn btn-sm btn-success" onclick="acceptPickup(' + item.pickupId + ')">' +
                                    '<i class="fa-solid fa-check"></i> Accept</button>';
                        }
                        else if (item.status === "Accepted" || item.status === "Partial Delivered") {
                            actionButtons =
                                '<a href="/Provider/DeliveryChallan/' + item.pickupId + '" class="btn btn-sm btn-primary">' +
                                    '<i class="fa-solid fa-truck"></i> Deliver</a>';
                        }

                        table.row.add([
                            '<div class="details-control" data-id="' + item.pickupId + '"></div>',
                            item.rowNum,
                            '<span class="fw-semibold text-teal">' + item.pickupNo + '</span>',
                            formatDate(item.pickupDateTime),
                            item.hospitalName,
                            item.wardName,
                            item.shiftName,
                            '<span class="fw-bold text-teal">' + item.totalCollectedQty + '</span>',
                            '<span class="fw-bold text-success">' + item.totalDeliveredQty + '</span>',
                            '<span class="fw-bold text-danger">' + item.totalPendingQty + '</span>',
                            statusBadge,
                            actionButtons
                        ]);

                    });

                    table.draw();

                }).fail(function () {
                    LMIS.alert('Search failed', 'Could not load pickup entries.', 'error');
                });

            });

            // Clear
            $('#btnClear').on('click', function () {
                $('#filterStatus').val('');
                $('#filterWard').val('');
                $('#filterDate').val('');
                location.reload();
            });

        });

        function formatItems(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Linen Type</th>' +
                        '<th class="text-end">Collected Qty</th>' +
                        '<th class="text-end">Delivered Qty</th>' +
                        '<th class="text-end">Pending Qty</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td>' + x.linenTypeName + '</td>' +
                        '<td class="text-end fw-bold text-teal">' + x.collectedQty + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td class="text-end fw-bold text-danger">' + x.pendingQty + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

        function formatDate(data) {
            return new Date(data).toLocaleDateString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric'
            });
        }

        function acceptPickup(id) {

            LMIS.confirm({
                title: 'Accept this pickup?',
                text: 'The linen will be marked as accepted by your team.',
                icon: 'question',
                confirmText: 'Yes, accept',
                danger: false
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Provider/AcceptPickup', { PickupId: id, Remarks: '' }, function (res) {
                    if (res.success) {
                        LMIS.toast(res.message || 'Pickup accepted');
                        $('#btnSearch').click();
                    } else {
                        LMIS.alert('Could not accept', res.message || 'Please try again.', 'error');
                    }
                }).fail(function () {
                    LMIS.alert('Could not accept', 'An error occurred while accepting the pickup.', 'error');
                });
            });
        }

    </script>
}
