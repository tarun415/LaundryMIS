@model IEnumerable<dynamic>

@{
    ViewBag.Title = "Pending Deliveries";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hourglass-half"></i></div>
    <div class="ph-text">
        <h1>Pending Deliveries</h1>
        <p class="ph-sub">Entries still awaiting clean linen delivery</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="deliveryTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="2">Date</th>
                        <th data-priority="1">Hospital</th>
                        <th data-priority="3">Status</th>
                        <th data-priority="1" class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="nowrap">@Convert.ToDateTime(item.EntryDate).ToString("dd MMM yyyy")</td>
                            <td class="fw-semibold">@item.HospitalName</td>

                            <td>
                                @if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-ok">Delivered</span>
                                }
                                else if (item.Status == "Partial")
                                {
                                    <span class="badge badge-warn">Partial</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Pending</span>
                                }
                            </td>

                            <td class="text-end">
                                <a href="~/Provider/Deliver/@item.EntryId" class="btn btn-sm btn-success">
                                    <i class="fa-solid fa-truck"></i> Deliver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#deliveryTable', {
                exportTitle: 'Pending Deliveries',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });
        });
    </script>
}
