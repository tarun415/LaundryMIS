@model List<LaudaryMis.ViewModels.DeliveryListVM>

<style>

    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        border: none;
        color: #fff;
        font-weight: 500;
    }

    .dt-buttons {
        display: flex;
        gap: 6px;
    }

        .dt-buttons .btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            border: none;
        }

    .buttons-copy {
        background: #6c757d !important;
    }

    .buttons-excel {
        background: #198754 !important;
    }

    .buttons-pdf {
        background: #dc3545 !important;
    }

    .buttons-print {
        background: #0d6efd !important;
    }

    .dataTables_filter input {
        border-radius: 20px;
        padding: 5px 10px;
    }

    .child-table {
        width: 100% !important;
    }

    .dataTables_wrapper .dataTables_filter input {
        border-radius: 15px;
        padding: 4px 8px;
        margin-left: 5px;
    }

</style>

<div class="container mt-4">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4 class="fw-bold">
            🚚 Delivery Challan List
        </h4>

    </div>

    <!-- TABLE -->

    <div class="card shadow-sm border-0 rounded-4">

        <div class="card-body">

            <div class="table-responsive">

                <table id="deliveryTable"
                       class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th></th>
                            <th>S.No.</th>
                            <th>Delivery No</th>
                            <th>Pickup No</th>
                            <th>Hospital</th>
                            <th>Ward</th>
                            <th>Collected Qty</th>
                            <th>Delivered Qty</th>
                            <th>Pending Qty</th>
                            <th>Status</th>
                            <th>Delivery Date</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="details-control text-center"
                                    data-id="@item.DeliveryId"
                                    style="cursor:pointer;">

                                    ➕

                                </td>

                                <td>@item.RowNum</td>

                                <td class="fw-bold text-primary">
                                    @item.DeliveryNo
                                </td>

                                <td>
                                    @item.PickupNo
                                </td>

                                <td>
                                    @item.HospitalName
                                </td>

                                <td>
                                    @item.WardName
                                </td>

                                <td class="fw-bold">
                                    @item.TotalCollectedQty
                                </td>

                                <td class="text-success fw-bold">
                                    @item.DeliveredQty
                                </td>

                                <td class="text-danger fw-bold">
                                    @item.PendingQty
                                </td>

                                <td>

                                    @if (item.Status == "Partial Delivered")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partial Delivered
                                        </span>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="badge bg-success">
                                            Delivered
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @item.Status
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.DeliveryDateTime.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        $(document).ready(function () {

            var table = $('#deliveryTable').DataTable({

                pageLength: 10,

                responsive: true,

                dom:
                    "<'row mb-2 align-items-center'<'col-md-4'l><'col-md-8 d-flex justify-content-end gap-2'Bf>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",

                buttons: [

                    {
                        extend: 'copy',
                        className: 'btn buttons-copy',
                        text: '📋'
                    },

                    {
                        extend: 'excel',
                        className: 'btn buttons-excel',
                        text: '📊'
                    },

                    {
                        extend: 'pdf',
                        className: 'btn buttons-pdf',
                        text: '📄'
                    },

                    {
                        extend: 'print',
                        className: 'btn buttons-print',
                        text: '🖨️'
                    }

                ]

            });

            // Child Table Format

            function format(items, id) {

                let html =

                `<table id="childTable_${id}"
                        class="table table-bordered table-sm child-table">

                    <thead>

                        <tr>

                            <th>Linen Name</th>
                            <th>Collected Qty</th>
                            <th>Delivered Qty</th>
                            <th>Pending Qty</th>

                        </tr>

                    </thead>

                    <tbody>`;

                items.forEach(x => {

                    html += `

                    <tr>

                        <td>${x.linenName}</td>

                        <td>${x.collectedQty}</td>

                        <td class="text-success fw-bold">
                            ${x.deliveredQty}
                        </td>

                        <td class="text-danger fw-bold">
                            ${x.pendingQty}
                        </td>

                    </tr>`;
                });

                html += "</tbody></table>";

                return html;
            }

            // Expand Row

            $('#deliveryTable tbody').on(
                'click',
                'td.details-control',
                function () {

                    var tr = $(this).closest('tr');

                    var row = table.row(tr);

                    var id = $(this).data('id');

                    if (row.child.isShown()) {

                        row.child.hide();

                        tr.removeClass('shown');

                        $(this).html("➕");
                    }
                    else {

                        $.get('/Provider/DeliveryItems/' + id,

                            function (data) {

                                row.child(
                                    format(data, id)
                                ).show();

                                tr.addClass('shown');

                                tr.find('.details-control')
                                    .html("➖");
                            });
                    }
                });

        });

    </script>
}