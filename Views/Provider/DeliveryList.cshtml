@model List<LaudaryMis.ViewModels.DeliveryListVM>

@{
    ViewBag.Title = "Delivery Challan List";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck-ramp-box"></i></div>
    <div class="ph-text">
        <h1>Delivery Challan List</h1>
        <p class="ph-sub">Deliveries raised against collected linen</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="deliveryTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>S.No.</th>
                        <th>Delivery No</th>
                        <th>Pickup No</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th>Status</th>
                        <th>Delivery Date</th>
                        <th>Provider</th>
                        <th>Delivered By</th>
                        <th>Received By</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control" data-id="@item.DeliveryId"></td>

                            <td>@item.RowNum</td>

                            <td class="fw-semibold text-teal">@item.DeliveryNo</td>
                            <td>@item.PickupNo</td>
                            <td>@item.HospitalName</td>
                            <td>@item.WardName</td>

                            <td class="text-end fw-bold">@item.TotalCollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.DeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.PendingQty</td>

                            <td>
                                @if (item.Status == "Partial Delivered")
                                {
                                    <span class="badge badge-warn">Partial Delivered</span>
                                }
                                else if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-ok">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge badge-navy">@item.Status</span>
                                }
                            </td>

                            <td class="nowrap">@item.DeliveryDateTime.ToString("dd MMM yyyy")</td>

                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.ProviderName) ? "—" : item.ProviderName)</div>
                                @if (!string.IsNullOrWhiteSpace(item.ProviderPhone))
                                {
                                    <div class="text-muted small"><i class="fa-solid fa-phone fa-xs"></i> @item.ProviderPhone</div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.DeliveredBy) ? "—" : item.DeliveredBy)</div>
                                @if (!string.IsNullOrWhiteSpace(item.DeliveredByPhone))
                                {
                                    <div class="text-muted small"><i class="fa-solid fa-phone fa-xs"></i> @item.DeliveredByPhone</div>
                                }
                            </td>

                            <td>
                                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(item.ReceivedBy) ? "—" : item.ReceivedBy)</div>
                                @if (!string.IsNullOrWhiteSpace(item.ReceivedByPhone))
                                {
                                    <div class="text-muted small"><i class="fa-solid fa-phone fa-xs"></i> @item.ReceivedByPhone</div>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            // expandable: this table owns its row.child() detail rows,
            // so Responsive is off and the table scrolls sideways instead.
            var table = LMIS.initTable('#deliveryTable', {
                expandable: true,
                exportTitle: 'Delivery Challans',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            $('#deliveryTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var id = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Provider/DeliveryItems/' + id, function (data) {
                    row.child(formatItems(data)).show();
                    tr.addClass('shown');
                });
            });

        });

        function formatItems(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Linen Name</th>' +
                        '<th class="text-end">Collected Qty</th>' +
                        '<th class="text-end">Delivered Qty</th>' +
                        '<th class="text-end">Pending Qty</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td>' + x.linenName + '</td>' +
                        '<td class="text-end">' + x.collectedQty + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td class="text-end fw-bold text-danger">' + x.pendingQty + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

    </script>
}
