@using LaudaryMis.ViewModels
@model LaudaryMis.ViewModels.DailyEntryVM
<style>
    .linen-scroll {
        max-height: 300px; /* adjust as needed */
        overflow-y: auto;
        border: 1.5px solid #dee2e6;
        border-radius: 9px;
    }

        /* Sticky header */
        .linen-scroll thead th {
            position: sticky;
            top: 0;
            background: #dbeafe; /* nice blue */
            color: #1e3a8a;
            z-index: 2;
        }
</style>
<div class="container mt-4">
    @* <h3>🧺 Daily Linen Entry</h3> *@
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0">
            @(Model == null || Model.EntryId == 0 ? "➕ Add Daily Linen Entry" : "✏️ Edit Daily Linen Entry")
        </h4>

        <a href="@Url.Action("DailyEntryList", "Provider")"
           class="btn btn-outline-secondary rounded-pill px-3">
            ← Back to List
        </a>
    </div>
    <input type="hidden" id="entryId" value="@Model.EntryId" />

    <div class="row g-3">

        <!-- Row 1 -->
        <div class="col-md-6">
            <label>Hospital</label>
            <select id="ln-hospital" class="form-control">
                <option value="">Select Hospital</option>
                @foreach (var h in Model.Hospitals)
                {
                    <option value="@h.HospitalId"
                            selected="@(h.HospitalId == Model.HospitalId)">
                        @h.HospitalName
                    </option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label>Ward</label>
            <select id="ln-ward" class="form-control">
                <option value="">Select Ward</option>
                @foreach (var w in Model.Wards)
                {
                    <option value="@w.WardId"
                            selected="@(w.WardId == Model.Ward)">
                        @w.WardName
                    </option>
                }
            </select>
        </div>
       

        <!-- Row 2 -->
        <div class="col-md-6">
            <label>Date</label>
            <input type="date" id="ln-date" class="form-control"
                   value="@Model.EntryDate.ToString("yyyy-MM-dd")" />
        </div>

        <div class="col-md-6">
            <label>Shift</label>
            <select id="ln-shift" class="form-control">
                <option value="Morning" selected="@(Model.Shift == "Morning")">Morning</option>
                <option value="Evening" selected="@(Model.Shift == "Evening")">Evening</option>
            </select>
        </div>

    </div>

    <hr />

    <!-- 🔥 LINEN TABLE -->
    <div class="table-responsive linen-scroll">
        <table class="table table-bordered">
        <thead>
            <tr>
                <th>Linen Type</th>
                <th>Dirty Count</th>
            </tr>
        </thead>
        <tbody id="linenTable"></tbody>
        </table>
    </div>

    <hr />

    <!-- Tracking -->
    <div class="row g-3">

        <div class="col-md-4">
            <label class="form-label mb-1">Collected By</label>
            <input type="text" id="ln-collected"
                   class="form-control"
                   value="@Model.CollectedBy" />
        </div>

        <div class="col-md-4">
            <label class="form-label mb-1">Received By</label>
            <input type="text" id="ln-received"
                   class="form-control"
                   value="@Model.ReceivedBy" />
        </div>

        <div class="col-md-4">
            <label class="form-label mb-1">Supervisor</label>
            <input type="text" id="ln-supervisor"
                   class="form-control"
                   value="@Model.Supervisor" />
        </div>

    </div>

    <!-- Remarks + Infected -->
    <div class="row g-3 mt-2 align-items-end">

        <!-- Remarks -->
        <div class="col-md-8">
            <label class="form-label mb-1 fw-semibold">Remarks</label>
            <input type="text"
                   id="ln-remarks"
                   class="form-control"
                   placeholder="Enter remarks (optional)"
                   value="@Model.Remarks" />
        </div>

        <!-- Infected Checkbox -->
        <div class="col-md-4 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="ln-infected"
                       @(Model.IsInfected ? "checked" : "") />

                <label class="form-check-label ms-2 fw-semibold" for="ln-infected">
                    Is Infected
                </label>
            </div>
        </div>

    </div>

    <!-- Buttons -->
    <div class="d-flex justify-content-end gap-2 mt-3">

        <a href="/Provider/DailyEntryList"
           class="btn btn-light border rounded-pill px-4">
            Cancel
        </a>

        <button type="button"
                onclick="saveEntry()"
                class="btn btn-primary rounded-pill px-4">
            @(Model.EntryId == 0 ? "💾 Save" : "✏️ Update")
        </button>

    </div>
</div>

<!-- 🔥 Razor → JS Array -->
<script>
      const linenTypes = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.LinenTypes.Select(x => x.LinenName)
                )
        );

        const existingItems = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        (Model.Items as List<LinenItemVM>) ?? new List<LinenItemVM>()
                )
        );
            // ✅ PRINT
    console.log("Linen Types:", linenTypes);
    console.log("Existing Items:", existingItems);
          function generateTable() {

        let html = "";

        // 🔥 fallback if linenTypes empty
        let source = linenTypes.length > 0
            ? linenTypes
            : existingItems.map(x => x.LinenType);

        source.forEach(name => {

            let existing = existingItems.find(x =>
                x.LinenType?.trim().toLowerCase() === name?.trim().toLowerCase()
            );

            let dirty = existing ? existing.DirtyCount : 0;

            html += `
                <tr>
                    <td>${name}</td>
                    <td>
                        <input type="number"
                               class="dirty form-control"
                               data-type="${name}"
                               value="${dirty}" />
                    </td>
                </tr>
            `;
        });

        document.getElementById("linenTable").innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", generateTable);

    document.addEventListener("DOMContentLoaded", generateTable);

       function saveEntry() {

        const rows = document.querySelectorAll("#linenTable tr");

        let items = [];

        rows.forEach(r => {
            const input = r.querySelector(".dirty");
            const type = input.dataset.type;
            const dirty = parseInt(input.value) || 0;

            if (dirty > 0) {
                items.push({
                    LinenType: type,
                    DirtyCount: dirty
                });
            }
        });

        const hospitalId = parseInt($("#ln-hospital").val());
        if (!hospitalId) {
            alert("Select hospital");
            return;
        }

        const wardId = parseInt($("#ln-ward").val());
        if (!wardId) {
            alert("Select ward");
            return;
        }

        if (items.length === 0) {
            alert("Enter at least one item");
            return;
        }

        
            const data = {
        EntryId: $("#entryId").val(), // important
        EntryDate: $("#ln-date").val(),
        Shift: $("#ln-shift").val(),
        HospitalId: hospitalId,
        Ward: wardId,

        CollectedBy: $("#ln-collected").val(),
        ReceivedBy: $("#ln-received").val(),
        Supervisor: $("#ln-supervisor").val(),

        IsInfected: $("#ln-infected").is(":checked"),
        Remarks: $("#ln-remarks").val() || "",

        Items: items
    };
        $.ajax({
            url: '/Provider/Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),

               success: function (result) {
        if (result.success) {

            // optional  message
             alert("Saved Successfully");

            setTimeout(() => {
                window.location.href = '/Provider/DailyEntryList';
            }, 500);
        }
    },

            error: function (xhr) {
                console.log(xhr.responseText);
                alert(xhr.responseText || "Error occurred");
            }
        });
    }
</script>