@model LaudaryMis.ViewModels.DailyEntryVM

<div class="container mt-4">
    <h3>🧺 Daily Linen Entry</h3>

    <!-- Hospital -->
    <div class="mb-3">
        <label>Hospital</label>
        <select id="ln-hospital" class="form-control">
            <option value="">Select Hospital</option>
            @foreach (var h in Model.Hospitals)
            {
                <option value="@h.HospitalId">@h.HospitalName</option>
            }
        </select>
    </div>

    <!-- Date -->
    <div class="mb-3">
        <label>Date</label>
        <input type="date" id="ln-date" class="form-control" value="@Model.EntryDate.ToString("yyyy-MM-dd")" />
    </div>

    <!-- Ward -->
    <div class="mb-3">
        <label>Ward</label>
        <select id="ln-ward" class="form-control">
            <option value="">Select Ward</option>
            @foreach (var h in Model.Wards)
            {
                <option value="@h.WardId">@h.WardName</option>
            }
        </select>
    </div>

    <!-- SHIFT -->
    <div class="mb-3">
        <label>Shift</label>
        <select id="ln-shift" class="form-control">
            <option>Morning</option>
            <option>Evening</option>
        </select>
    </div>

    <hr />

    <!-- 🔥 LINEN TABLE -->
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Linen Type</th>
                <th>Dirty Count</th>
            </tr>
        </thead>
        <tbody id="linenTable"></tbody>
    </table>

    <hr />

    <!-- Tracking -->
    <div class="row">
        <div class="col-md-4">
            <label>Collected By</label>
            <input type="text" id="ln-collected" class="form-control" />
        </div>

        <div class="col-md-4">
            <label>Received By</label>
            <input type="text" id="ln-received" class="form-control" />
        </div>

        <div class="col-md-4">
            <label>Supervisor</label>
            <input type="text" id="ln-supervisor" class="form-control" />
        </div>
    </div>

    <br />
    <div class="row mt-3">
        <div class="col-md-6">
            <label>Remarks</label>
            <input type="text" id="ln-remarks" class="form-control" />
        </div>

        <div class="col-md-6">
            <label>
                <input type="checkbox" id="ln-infected" /> Is Infected
            </label>
        </div>
    </div>
    <button class="btn btn-success" onclick="saveEntry()">Save Entry</button>
</div>

<!-- 🔥 Razor → JS Array -->
<script>
    const linenTypes = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    Model.LinenTypes.Select(x => x.LinenName)
                )
        )

    function generateTable() {
        let html = "";

        linenTypes.forEach((name, i) => {
            html += `
                <tr>
                    <td>${name}</td>
                    <td>
                        <input type="number"
                               class="dirty form-control"
                               data-type="${name}" />
                    </td>
                </tr>
            `;
        });

        document.getElementById("linenTable").innerHTML = html;
    }

    document.addEventListener("DOMContentLoaded", generateTable);

       function saveEntry() {

        const rows = document.querySelectorAll("#linenTable tr");

        let items = [];

        rows.forEach(r => {
            const input = r.querySelector(".dirty");
            const type = input.dataset.type;
            const dirty = parseInt(input.value) || 0;

            if (dirty > 0) {
                items.push({
                    LinenType: type,
                    DirtyCount: dirty
                });
            }
        });

        const hospitalId = parseInt($("#ln-hospital").val());
        if (!hospitalId) {
            alert("Select hospital");
            return;
        }

        const wardId = parseInt($("#ln-ward").val());
        if (!wardId) {
            alert("Select ward");
            return;
        }

        if (items.length === 0) {
            alert("Enter at least one item");
            return;
        }

        const data = {
            EntryDate: $("#ln-date").val(),
            Shift: $("#ln-shift").val(),
            HospitalId: hospitalId,
            Ward: wardId,

            CollectedBy: $("#ln-collected").val(),
            ReceivedBy: $("#ln-received").val(),
            Supervisor: $("#ln-supervisor").val(),

            IsInfected: $("#ln-infected").is(":checked"),
            Remarks: $("#ln-remarks").val() || "",

            Items: items
        };

        $.ajax({
            url: '/Provider/Save',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),

            success: function (result) {
                if (result.success) {
                    alert("Saved Successfully");
                    location.reload();
                }
            },

            error: function (xhr) {
                console.log(xhr.responseText);
                alert(xhr.responseText || "Error occurred");
            }
        });
    }
</script>