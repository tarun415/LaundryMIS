@model IEnumerable<LaudaryMis.Models.WarningLetterMaster>

@{
    ViewData["Title"] = "Warning Letter List";
    int srNo = 1;
    var total = Model?.Count() ?? 0;
}

<div class="page-header">
    <div class="ph-icon" style="background: linear-gradient(135deg, var(--gold-500), var(--gold-600));">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="ph-text">
        <h1>Warning Letters</h1>
        <p class="ph-sub">@total letter@(total == 1 ? "" : "s") issued for underperformance</p>
    </div>
</div>

<!-- FILTER -->
<form method="get" asp-action="WarningLetterList">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="agreementId">Agreement</label>
            <input type="text" name="agreementId" id="agreementId" class="form-control"
                   value="@Context.Request.Query["agreementId"]" placeholder="Agreement ID" />
        </div>

        <div class="filter-field">
            <label class="form-label" for="hospitalId">Hospital</label>
            <input type="text" name="hospitalId" id="hospitalId" class="form-control"
                   value="@Context.Request.Query["hospitalId"]" placeholder="Hospital ID" />
        </div>

        <div class="filter-field">
            <label class="form-label" for="monthNo">Month</label>
            <input type="number" name="monthNo" id="monthNo" class="form-control" min="1" max="12"
                   value="@Context.Request.Query["monthNo"]" />
        </div>

        <div class="filter-field">
            <label class="form-label" for="yearNo">Year</label>
            <input type="number" name="yearNo" id="yearNo" class="form-control"
                   value="@Context.Request.Query["yearNo"]" />
        </div>

        <div class="filter-field">
            <label class="form-label" for="status">Status</label>
            <select name="status" id="status" class="form-select">
                <option value="">All</option>
                <option value="Generated">Generated</option>
                <option value="Approved">Approved</option>
                <option value="Closed">Closed</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <a asp-action="WarningLetterList" class="btn btn-light">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </a>
        </div>

    </div>
</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblWarning" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="6">S.No.</th>
                        <th data-priority="1">Warning No</th>
                        <th data-priority="4">Date</th>
                        <th data-priority="2">Provider</th>
                        <th data-priority="5">Hospital</th>
                        <th data-priority="8">Month</th>
                        <th data-priority="9">Year</th>
                        <th data-priority="3">Level</th>
                        <th data-priority="3">Status</th>
                        <th data-priority="1" class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@srNo</td>
                                <td class="fw-semibold text-teal">@item.WarningNo</td>
                                <td class="nowrap">@item.WarningDate.ToString("dd MMM yyyy")</td>
                                <td>@item.ProviderName</td>
                                <td>@item.HospitalName</td>
                                <td>@item.MonthNo</td>
                                <td>@item.YearNo</td>

                                <td>
                                    <span class="badge badge-warn">@item.WarningLevel</span>
                                </td>

                                <td>
                                    @if (item.Status == "Generated")
                                    {
                                        <span class="badge badge-info">@item.Status</span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge badge-ok">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-navy">@item.Status</span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="action-group justify-content-end">

                                        <a asp-action="PreviewWarningLetter"
                                           asp-route-warningId="@item.WarningId"
                                           class="btn btn-sm btn-icon btn-outline-primary"
                                           target="_blank" rel="noopener"
                                           data-bs-toggle="tooltip" title="Preview">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>

                                        <a asp-action="WarningLetterDetails"
                                           asp-route-warningId="@item.WarningId"
                                           class="btn btn-sm btn-icon btn-outline-secondary"
                                           data-bs-toggle="tooltip" title="Details">
                                            <i class="fa-solid fa-file-lines"></i>
                                        </a>

                                        <a asp-action="DownloadWarningLetter"
                                           asp-route-warningId="@item.WarningId"
                                           class="btn btn-sm btn-icon btn-outline-success"
                                           data-bs-toggle="tooltip" title="Download">
                                            <i class="fa-solid fa-download"></i>
                                        </a>

                                    </div>
                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#tblWarning', {
                exportTitle: 'Warning Letters',
                order: [[2, 'desc']],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    emptyTable: 'No warning letters found'
                }
            });
        });
    </script>
}
