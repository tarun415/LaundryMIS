@model LaudaryMis.Models.WarningLetterMaster

@{
    ViewData["Title"] = "Warning Letter Details";
}

<div class="page-header">
    <div class="ph-icon" style="background: linear-gradient(135deg, var(--gold-500), var(--gold-600));">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="ph-text">
        <h1>Warning Letter Details</h1>
        <p class="ph-sub">@Model.WarningNo &middot; @Model.WarningDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="ph-actions">
        <a asp-action="PreviewWarningLetter" asp-route-warningId="@Model.WarningId"
           class="btn btn-outline-primary" target="_blank" rel="noopener">
            <i class="fa-solid fa-eye"></i> Preview
        </a>
        <a asp-action="DownloadWarningLetter" asp-route-warningId="@Model.WarningId"
           class="btn btn-outline-success">
            <i class="fa-solid fa-download"></i> Download
        </a>
        <a asp-action="WarningLetterList" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-3">

    <!-- WARNING INFORMATION -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-circle-exclamation text-teal"></i>
                <span class="card-title">Warning Information</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Warning No</span>
                    <span class="info-v">@Model.WarningNo</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Warning Date</span>
                    <span class="info-v">@Model.WarningDate.ToString("dd MMM yyyy")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Status</span>
                    <span class="info-v">
                        @if (Model.Status == "Generated")
                        {
                            <span class="badge badge-info">@Model.Status</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge badge-ok">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge badge-navy">@Model.Status</span>
                        }
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-k">Warning Level</span>
                    <span class="info-v"><span class="badge badge-warn">@Model.WarningLevel</span></span>
                </div>

            </div>
        </div>
    </div>

    <!-- AGREEMENT INFORMATION -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-file-signature text-teal"></i>
                <span class="card-title">Agreement Information</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Agreement No</span>
                    <span class="info-v">@Model.AgreementNo</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Hospital</span>
                    <span class="info-v">@Model.HospitalName</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Provider</span>
                    <span class="info-v">@Model.ProviderName</span>
                </div>

            </div>
        </div>
    </div>

    <!-- PERFORMANCE -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-chart-line text-teal"></i>
                <span class="card-title">Performance Details</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Month</span>
                    <span class="info-v">@Model.MonthNo</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Year</span>
                    <span class="info-v">@Model.YearNo</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Performance Score</span>
                    <span class="info-v">@Model.PerformanceScore %</span>
                </div>

            </div>
        </div>
    </div>

    <!-- WARNING DETAILS -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-file-lines text-teal"></i>
                <span class="card-title">Warning Details</span>
            </div>
            <div class="card-body">

                <div class="mb-3">
                    <div class="stat-lbl mb-1">Subject</div>
                    <div>@Model.Subject</div>
                </div>

                <div class="mb-3">
                    <div class="stat-lbl mb-1">Reason</div>
                    <div>@Model.Reason</div>
                </div>

                <div>
                    <div class="stat-lbl mb-1">Remarks</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</div>
                </div>

            </div>
        </div>
    </div>

</div>

<!-- SIGNED COPY -->
<div class="card mt-3">
    <div class="card-header">
        <i class="fa-solid fa-file-signature text-teal"></i>
        <span class="card-title">Signed Warning Letter</span>
    </div>

    <div class="card-body">
        <form asp-action="UploadWarningLetterDocument" method="post" enctype="multipart/form-data">

            <input type="hidden" name="WarningId" value="@Model.WarningId" />

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-8">
                    <label class="form-label" for="file">Upload signed PDF</label>
                    <input type="file" name="file" id="file" accept=".pdf" class="form-control" />
                </div>

                <div class="col-12 col-md-4">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-upload"></i> Upload Signed Copy
                    </button>
                </div>

            </div>

        </form>
    </div>
</div>
