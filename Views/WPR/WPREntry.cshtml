@model LaudaryMis.ViewModels.WPRVM

@{
    ViewBag.Title = "Weekly Performance Report";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-clipboard-check"></i></div>
    <div class="ph-text">
        <h1>Submit Weekly Performance Report</h1>
        <p class="ph-sub">Score parameters and submit for payment processing</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form id="wprForm" method="post" asp-action="WPREntry" asp-controller="WPR" onsubmit="return validateForm()">
    @Html.AntiForgeryToken()

    <input type="hidden" id="totalScoreHidden" name="TotalScore" />
    <input type="hidden" id="AgreementId" name="AgreementId" value="@ViewBag.AgreementId" />
    <input type="hidden" id="providerIdHidden" name="ProviderId" value="@ViewBag.ProviderId" />
    <input type="hidden" id="HospitalId" name="HospitalId" value="@ViewBag.HospitalId" />

    <div class="row g-3">

        <!-- REPORT DETAILS -->
        <div class="col-12 col-xl-7">
            <div class="card h-100">
                <div class="card-header">
                    <i class="fa-solid fa-file-pen text-teal"></i>
                    <span class="card-title">Report Details</span>
                </div>

                <div class="card-body">

                    <div id="hospitalDisplay" class="info-pill mb-3" style="display:none;"></div>

                    <div class="row g-3">

                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="fMonth">Month</label>
                            <select name="Month" id="fMonth" class="form-select" onchange="setWeeksByMonth();">
                                <option value="">Select Month</option>
                                <option value="1">January</option>
                                <option value="2">February</option>
                                <option value="3">March</option>
                                <option value="4">April</option>
                                <option value="5">May</option>
                                <option value="6">June</option>
                                <option value="7">July</option>
                                <option value="8">August</option>
                                <option value="9">September</option>
                                <option value="10">October</option>
                                <option value="11">November</option>
                                <option value="12">December</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="Week">Week</label>
                            <select name="Week" id="Week" class="form-select" onchange="loadWeeklyPerformance();">
                                <option value="">Select Week</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="fYear">Year</label>
                            <select name="Year" id="fYear" class="form-select" onchange="setWeeksByMonth();">
                                <option value="">Select Year</option>
                            </select>
                        </div>

                        <div class="col-12 col-sm-6">
                            <label class="form-label" for="StaffName">Staff Name</label>
                            <input id="StaffName" name="StaffName" class="form-control"
                                   placeholder="Enter name" readonly required
                                   value="@(Model?.StaffName ?? ViewBag.ProviderName ?? String.Empty)" />
                        </div>

                        <div class="col-12">
                            <label class="form-label" for="Remarks">Remarks</label>
                            <textarea name="Remarks" id="Remarks" class="form-control" rows="3"
                                      placeholder="Optional remarks…"></textarea>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- LIVE SCORE -->
        <div class="col-12 col-xl-5">
            <div class="card h-100">
                <div class="card-header">
                    <i class="fa-solid fa-gauge-high text-teal"></i>
                    <span class="card-title">Live Score</span>
                </div>

                <div class="card-body">

                    <div class="text-center mb-2">
                        <div class="score-big" id="scoreDisplay">0</div>
                        <div class="score-sub">out of 100</div>
                    </div>

                    <div class="score-meter">
                        <div class="score-fill" id="bar" style="width:0%"></div>
                    </div>

                    <div class="text-center mt-3">
                        <span class="badge badge-none" id="paymentBadge">0% Payment — No Payment</span>
                    </div>

                    <div class="mt-3" style="border:1px solid var(--line); border-radius: var(--r-sm); overflow:hidden;">
                        <table class="slab-table">
                            <thead>
                                <tr><th>Score</th><th>Payment %</th></tr>
                            </thead>
                            <tbody id="slabTable">
                                <tr id="slab0"><td>0 – 20</td><td>No Payment</td></tr>
                                <tr id="slab21"><td>21 – 40</td><td>40%</td></tr>
                                <tr id="slab41"><td>41 – 60</td><td>60%</td></tr>
                                <tr id="slab61"><td>61 – 70</td><td>80%</td></tr>
                                <tr id="slab71"><td>71 – 80</td><td>90%</td></tr>
                                <tr id="slab81"><td>81 – 100</td><td>100%</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-warning mt-3 mb-0">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>WPR must be uploaded by the 5th day of the next week.</span>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="button" class="btn btn-light flex-fill" onclick="resetForm()">
                            <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                        <button type="submit" class="btn btn-primary flex-fill" id="submitBtn">
                            <i class="fa-solid fa-paper-plane"></i> Submit WPR
                        </button>
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- PARAMETERS -->
    <div class="card kpi-section mt-3">
        <div class="card-header">
            <i class="fa-solid fa-list-check text-teal"></i>
            <span class="card-title">Performance Parameters</span>
            <div id="countText" class="ms-auto">0 / 10 scored</div>
        </div>

        <div id="kpiRows"></div>
    </div>

</form>

@section Scripts {
    <script>

        const PARAMS = [
            "Collection Timeliness", "Delivery Timeliness", "Linen Quality", "Infection Control",
            "Stain / Odour Removal", "Damage / Loss", "SOP Compliance", "Staff Behavior",
            "Overall Satisfaction", "Warning Letters"
        ];

        function setWeeksByMonth() {

            const month = parseInt(document.getElementById("fMonth").value);
            const year = parseInt(document.getElementById("fYear").value);
            const weekDropdown = document.getElementById("Week");

            weekDropdown.innerHTML = '<option value="">Select Week</option>';

            if (!month || !year) return;

            const daysInMonth = new Date(year, month, 0).getDate();
            const numberOfWeeks = Math.ceil(daysInMonth / 7);

            for (let week = 1; week <= numberOfWeeks; week++) {
                const option = document.createElement("option");
                option.value = week;
                option.textContent = "Week " + week;
                weekDropdown.appendChild(option);
            }

            weekDropdown.value = "1";
            loadWeeklyPerformance();
        }

        (function initDateDefaults() {

            const now = new Date();
            const currentYear = now.getFullYear();

            document.getElementById("fMonth").value = now.getMonth() + 1;

            const yearDropdown = document.getElementById("fYear");
            for (let i = 0; i <= 5; i++) {
                const year = currentYear + i;
                const option = document.createElement("option");
                option.value = year;
                option.textContent = year;
                yearDropdown.appendChild(option);
            }

            yearDropdown.value = currentYear;
            setWeeksByMonth();
        })();

        // Populates HospitalId, ProviderId, StaffName and the hospital display
        async function fetchAgreementProviderDetails(agreementId) {
            if (!agreementId) return null;
            try {
                const resp = await fetch(`/api/agreement/${agreementId}`);
                if (!resp.ok) return null;
                const agreement = await resp.json();
                if (!agreement) return null;

                const providerEl = document.getElementById("providerIdHidden");
                const hospEl = document.getElementById("HospitalId");
                if (providerEl) providerEl.value = agreement.providerId ?? "";
                if (hospEl) hospEl.value = agreement.hospitalId ?? "";

                if (agreement.hospitalName) {
                    const display = document.getElementById("hospitalDisplay");
                    if (display) {
                        display.innerHTML = '<i class="fa-solid fa-hospital text-teal"></i> ' + agreement.hospitalName;
                        display.style.display = "inline-flex";
                    }
                }

                if (agreement.providerName) {
                    const staff = document.querySelector('input[name="StaffName"]');
                    if (staff) staff.value = agreement.providerName;
                }

                return agreement;
            } catch (ex) {
                console.error("fetchAgreementProviderDetails:", ex);
                return null;
            }
        }

        // Default rows, replaced once server data arrives
        (function buildDefaultKpis() {
            const container = document.getElementById("kpiRows");
            if (!container) return;

            PARAMS.forEach((name, idx) => {
                const i = idx + 1;
                const row = document.createElement("div");
                row.className = "kpi-row";
                row.id = "row_" + i;

                row.innerHTML = `
                    <div class="kpi-n">${i}</div>
                    <div class="kpi-lbl">${name}
                        <input type="hidden" name="Details[${idx}].ParameterId" value="${i}" />
                    </div>
                    <div class="kpi-btns">${[...Array(10)].map((_, s) => `<button type="button" class="kb" id="btn_${i}_${s + 1}" onclick="setScore(${i},${s + 1})">${s + 1}</button>`).join('')}</div>
                    <div class="kpi-sc" id="s${i}"><span>—</span></div>
                    <input type="hidden" id="score_${i}" name="Details[${idx}].Score" />`;

                container.appendChild(row);
            });
        })();

        let scores = {};

        function setScore(i, val) {
            scores[i] = val;

            const input = document.getElementById("score_" + i);
            if (input) input.value = val;

            const sEl = document.getElementById("s" + i);
            const cls = val >= 7 ? 'sc-good' : (val >= 3 ? 'sc-avg' : 'sc-poor');
            if (sEl) sEl.innerHTML = `<span class="sc-badge ${cls}">${val >= 7 ? 'Good' : val >= 3 ? 'Average' : 'Poor'} (${val}/10)</span>`;

            for (let s = 1; s <= 10; s++) {
                const b = document.getElementById(`btn_${i}_${s}`);
                if (b) b.classList.remove('sg', 'sa', 'sp');
            }

            const sel = document.getElementById(`btn_${i}_${val}`);
            if (sel) sel.classList.add(val >= 7 ? 'sg' : val >= 3 ? 'sa' : 'sp');

            calc();
        }

        function calc() {
            let total = 0, count = 0;
            for (const k in scores) { total += scores[k]; count++; }

            const scoreDisplay = document.getElementById("scoreDisplay"); if (scoreDisplay) scoreDisplay.textContent = total;
            const bar = document.getElementById("bar"); if (bar) bar.style.width = total + "%";
            const totalHidden = document.getElementById("totalScoreHidden"); if (totalHidden) totalHidden.value = total;
            const countText = document.getElementById("countText"); if (countText) countText.textContent = `${count} / 10 scored`;

            // Colour the meter by band
            if (bar) {
                bar.classList.remove('sc-good', 'sc-avg', 'sc-poor');
                bar.classList.add(total > 60 ? 'sc-good' : total > 20 ? 'sc-avg' : 'sc-poor');
            }

            const el = document.getElementById("paymentBadge");
            if (!el) return;

            let label = "0% — No Payment", badgeCls = "badge-none";
            if (total > 80) { label = "100% Payment"; badgeCls = "badge-full"; }
            else if (total > 60) { label = "90% Payment"; badgeCls = "badge-good"; }
            else if (total > 40) { label = "60% Payment"; badgeCls = "badge-mid"; }
            else if (total > 20) { label = "40% Payment"; badgeCls = "badge-low"; }

            el.textContent = label;
            el.className = "badge " + badgeCls;

            const slabs = ["slab0", "slab21", "slab41", "slab61", "slab71", "slab81"];
            slabs.forEach(id => { const s = document.getElementById(id); if (s) s.classList.remove('active'); });

            const active = total <= 20 ? "slab0" : total <= 40 ? "slab21" : total <= 60 ? "slab41"
                         : total <= 70 ? "slab61" : total <= 80 ? "slab71" : "slab81";

            const activeEl = document.getElementById(active);
            if (activeEl) activeEl.classList.add('active');
        }

        function resetForm() {
            scores = {};

            for (let i = 1; i <= 10; i++) {
                const si = document.getElementById("score_" + i); if (si) si.value = "";
                const sEl = document.getElementById("s" + i); if (sEl) sEl.innerHTML = "<span>—</span>";
                for (let s = 1; s <= 10; s++) {
                    const b = document.getElementById(`btn_${i}_${s}`);
                    if (b) b.classList.remove('sg', 'sa', 'sp');
                }
            }

            document.getElementById("scoreDisplay").textContent = "0";
            document.getElementById("bar").style.width = "0%";
            document.getElementById("totalScoreHidden").value = "0";
            document.getElementById("paymentBadge").textContent = "0% Payment — No Payment";
            document.getElementById("paymentBadge").className = "badge badge-none";
            document.getElementById("countText").textContent = "0 / 10 scored";

            ["slab0", "slab21", "slab41", "slab61", "slab71", "slab81"]
                .forEach(id => { const s = document.getElementById(id); if (s) s.classList.remove('active'); });
        }

        function validateForm() {

            const providerId = document.getElementById("providerIdHidden").value;
            if (!providerId || providerId === "0") {
                LMIS.alert("Provider not found", "Please select a valid agreement.", "warning");
                return false;
            }

            const hospitalId = document.getElementById("HospitalId").value;
            if (!hospitalId || hospitalId === "0") {
                LMIS.alert("Hospital not found", "Please select a valid agreement.", "warning");
                return false;
            }

            if (!document.getElementById("fMonth").value) {
                LMIS.alert("Missing information", "Please select a month.", "warning");
                return false;
            }

            for (let i = 1; i <= 10; i++) {
                const el = document.getElementById("score_" + i);
                if (el && !el.value) {
                    LMIS.alert("Incomplete scoring", "Please score all 10 parameters before submitting.", "warning");
                    return false;
                }
            }

            const staffName = (document.querySelector('input[name="StaffName"]').value || "").trim();
            if (!staffName) {
                LMIS.alert("Missing information", "Please enter the staff name.", "warning");
                return false;
            }

            const btn = document.getElementById("submitBtn");
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Submitting…';
            return true;
        }

        function loadWeeklyPerformance() {

            const agreementId = $("#AgreementId").val();
            const hospitalId = $("#HospitalId").val();
            const week = $("#Week").val();
            const month = $("#fMonth").val();
            const year = $("#fYear").val();

            if (!agreementId || agreementId === "0" || !hospitalId || hospitalId === "0" || !week || !month || !year) {
                return;
            }

            $.get("/WPR/GetWeeklyPerformanceData", {
                agreementId: agreementId,
                hospitalId: hospitalId,
                weekNo: week,
                month: month,
                year: year
            }, function (res) {
                buildPerformanceTable(res && res.data ? res.data : []);
            }).fail(function () {
                console.warn("GetWeeklyPerformanceData failed");
            });
        }

        function buildPerformanceTable(data) {

            $("#kpiRows").empty();
            scores = {};

            (data || []).forEach(function (item, index) {

                const pid = item.parameterId;
                const name = item.parameterName;
                const systemScore = item.systemScore ?? 0;
                const isEditable = !!item.isEditable;
                const maxScore = item.maxScore || 10;

                let row = `<div class="kpi-row" id="row_${pid}">
                    <div class="kpi-n">${index + 1}</div>
                    <div class="kpi-lbl">${name}
                        <input type="hidden" name="Details[${index}].ParameterId" value="${pid}" />
                        <input type="hidden" id="score_${pid}" name="Details[${index}].Score" />
                        <input type="hidden" name="Details[${index}].ParameterName" value="${name}" />
                    </div>`;

                if (isEditable) {
                    row += `<div class="kpi-btns">`;
                    for (let s = 1; s <= maxScore; s++) {
                        row += `<button type="button" class="kb" id="btn_${pid}_${s}" onclick="setScore(${pid},${s})">${s}</button>`;
                    }
                    row += `</div><div class="kpi-sc" id="s${pid}"><span>—</span></div>`;
                } else {
                    row += `<div class="kpi-btns">`;
                    for (let s = 1; s <= maxScore; s++) {
                        const css = (s === systemScore) ? (systemScore >= 7 ? 'sg' : systemScore >= 3 ? 'sa' : 'sp') : '';
                        row += `<button type="button" class="kb ${css}" disabled>${s}</button>`;
                    }
                    row += `</div>`;

                    const label = systemScore >= 7 ? 'Good' : systemScore >= 3 ? 'Average' : 'Poor';
                    const cls = systemScore >= 7 ? 'sc-good' : systemScore >= 3 ? 'sc-avg' : 'sc-poor';
                    row += `<div class="kpi-sc" id="s${pid}">
                                <span class="sc-badge ${cls}">${label} (${systemScore}/10)</span>
                                <div class="stat-sub mt-1">Auto calculated</div>
                            </div>`;

                    scores[pid] = systemScore;
                }

                row += `</div>`;
                $("#kpiRows").append(row);
                $("#score_" + pid).val(scores[pid] ?? "");
            });

            calc();
        }

        $(function () {
            (async function initial() {
                const agreementInput = document.getElementById("AgreementId");
                const agreementId = agreementInput ? agreementInput.value : null;
                if (agreementId && agreementId !== "0") {
                    await fetchAgreementProviderDetails(agreementId);
                }
                loadWeeklyPerformance();
            })();
        });

    </script>
}
