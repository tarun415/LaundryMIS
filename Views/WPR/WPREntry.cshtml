@model LaudaryMis.ViewModels.WPRVM

<div class="wrap">

    <div class="page-hdr">
        <h2>Submit Weekly Performance Report</h2>
        <p>Score parameters and submit for payment processing</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">✅ @TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-error">❌ @TempData["Error"]</div>
    }

    <style>
        /* small UI helpers kept from original file */
        .kb:disabled { opacity: 1; cursor: not-allowed; pointer-events: none; }
        .kb.sg { background: #28a745; color: #fff; border-color: #28a745; }
        .kb.sa { background: #ffc107; color: #000; border-color: #ffc107; }
        .kb.sp { background: #dc3545; color: #fff; border-color: #dc3545; }

        /* keep alerts */
        .alert-success { background: #f0faf4; border: 1px solid #a3d9b1; border-left: 4px solid #27ae60; color: #1e7e44; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; }
        .alert-error { background: #fff5f5; border: 1px solid #f5b7b7; border-left: 4px solid #e74c3c; color: #a93226; padding: 10px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; }
        .notice-warn { background: #fffbf0; border: 1px solid #f5c518; border-left: 4px solid #f5c518; color: #7a5c00; padding: 8px 12px; border-radius: 6px; font-size: 12px; margin-top: 12px; }
    </style>

    <form id="wprForm" method="post" asp-action="WPREntry" asp-controller="WPR" onsubmit="return validateForm()">
        @Html.AntiForgeryToken()

        <!-- Hidden IDs (make sure ids match JS selectors) -->
        <input type="hidden" id="totalScoreHidden" name="TotalScore" />
        <input type="hidden" id="AgreementId" name="AgreementId" value="@ViewBag.AgreementId" />
        <input type="hidden" id="providerIdHidden" name="ProviderId" value="@ViewBag.ProviderId" />
        <input type="hidden" id="HospitalId" name="HospitalId" value="@ViewBag.HospitalId" />

        <div class="g2">
            <div class="card">
                <div class="card-hdr">
                    <div class="card-title"><span class="card-icon">📝</span> Report Details</div>
                </div>

                <!-- small hospital display (JS populates) -->
                <div id="hospitalDisplay" style="margin:8px 0;font-weight:600;color:#27ae60;"></div>

                <div class="g2">
                    <div class="form-group">
                        <label class="form-label">Month</label>
                        <select name="Month" id="fMonth" class="form-control" onchange="loadWeeklyPerformance();">
                            <option value="">Select Month</option>
                            <option value="1">January</option>
                            <option value="2">February</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Week</label>
                        <select name="Week" id="Week" class="form-control" onchange="loadWeeklyPerformance();">
                            <option value="">Select Week</option>
                            <option value="1">Week 1</option>
                            <option value="2">Week 2</option>
                            <option value="3">Week 3</option>
                            <option value="4">Week 4</option>
                            <option value="5">Week 5</option>
                        </select>
                    </div>
                </div>

                <div class="g2">
                    <div class="form-group">
                        <label class="form-label">Year</label>
                        <input name="Year" id="fYear" class="form-control" readonly />
                    </div>
                 @*    <div class="form-group">
                        <label class="form-label">Staff Name</label>
                        <input name="StaffName" class="form-control" placeholder="Enter name" readonly required />
                    </div> *@
                    <div class="form-group">
                        <label class="form-label">Staff Name</label>
                        <input id="StaffName"
                               name="StaffName"
                               class="form-control"
                               placeholder="Enter name"
                               readonly
                               required
                               value="@(Model?.StaffName ?? ViewBag.ProviderName ?? String.Empty)" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Remarks</label>
                    <textarea name="Remarks" class="form-control" placeholder="Optional remarks..."></textarea>
                </div>
            </div>

            <div class="card">
                <div class="card-hdr">
                    <div class="card-title"><span class="card-icon">📊</span> Live Score</div>
                </div>

                <div style="text-align:center;margin-bottom:6px;">
                    <div class="score-big" id="scoreDisplay">0</div>
                    <div class="score-sub">out of 100</div>
                </div>

                <div class="score-meter">
                    <div class="score-fill" id="bar" style="width:0%"></div>
                </div>

                <div style="text-align:center;margin-top:6px;">
                    <span class="badge badge-none" id="paymentBadge">0% Payment — No Payment</span>
                </div>

                <div style="margin-top:14px;border:1px solid #f0ede8;border-radius:8px;overflow:hidden;">
                    <table style="width:100%;font-size:11px;border-collapse:collapse;">
                        <thead>
                            <tr style="background:#f8f6f2;">
                                <th style="padding:6px 10px;text-align:left;color:#888;font-weight:600;">Score</th>
                                <th style="padding:6px 10px;text-align:right;color:#888;font-weight:600;">Payment %</th>
                            </tr>
                        </thead>
                        <tbody id="slabTable">
                            <tr id="slab0"><td style="padding:5px 10px;color:#c0392b;">0 – 20</td><td style="text-align:right;padding:5px 10px;color:#c0392b;">No Payment</td></tr>
                            <tr id="slab21"><td style="padding:5px 10px;">21 – 40</td><td style="text-align:right;padding:5px 10px;">40%</td></tr>
                            <tr id="slab41"><td style="padding:5px 10px;">41 – 60</td><td style="text-align:right;padding:5px 10px;">60%</td></tr>
                            <tr id="slab61"><td style="padding:5px 10px;">61 – 70</td><td style="text-align:right;padding:5px 10px;">80%</td></tr>
                            <tr id="slab71"><td style="padding:5px 10px;">71 – 80</td><td style="text-align:right;padding:5px 10px;">90%</td></tr>
                            <tr id="slab81"><td style="padding:5px 10px;">81 – 100</td><td style="text-align:right;padding:5px 10px;">100%</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="notice-warn">⚠ WPR must be uploaded by 5th day of next week</div>

                <div style="display:flex;gap:10px;margin-top:14px;">
                    <button type="button" class="btn btn-ghost" onclick="resetForm()">Reset</button>
                    <button type="submit" class="btn btn-gold" id="submitBtn">Submit WPR</button>
                </div>
            </div>
        </div>

        <div class="card kpi-section">
            <div class="card-hdr">
                <div class="card-title"><span class="card-icon">📋</span> Performance Parameters</div>
                <div id="countText">0 / 10 scored</div>
            </div>

            <div id="kpiRows"></div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // -----------------------
        // Constants and small helpers
        // -----------------------
        const PARAMS = [
          "Collection Timeliness","Delivery Timeliness","Linen Quality","Infection Control",
          "Stain / Odour Removal","Damage / Loss","SOP Compliance","Staff Behavior",
          "Overall Satisfaction","Warning Letters"
        ];

        // init month/year/week defaults
        (function initDateDefaults() {
            const now = new Date();
            document.getElementById("fMonth").value = now.getMonth() + 1;
            document.getElementById("fYear").value = now.getFullYear();
            document.getElementById("Week").value = Math.min(Math.ceil(now.getDate() / 7), 5);
        })();

        // -----------------------
        // Agreement fetch (populates HospitalId, ProviderId, StaffName, Hospital display)
        // returns Promise so callers can await completion
        // -----------------------
        async function fetchAgreementProviderDetails(agreementId) {
            if (!agreementId) return null;
            try {
                const resp = await fetch(`/api/agreement/${agreementId}`);
                if (!resp.ok) return null;
                const agreement = await resp.json();
                if (!agreement) return null;

                // populate hidden inputs and UI
                const providerEl = document.getElementById("providerIdHidden");
                const hospEl = document.getElementById("HospitalId");
                if (providerEl) providerEl.value = agreement.providerId ?? "";
                if (hospEl) hospEl.value = agreement.hospitalId ?? "";
                if (agreement.hospitalName) {
                    const display = document.getElementById("hospitalDisplay");
                    if (display) { display.textContent = "🏥 " + agreement.hospitalName; display.style.color = "#27ae60"; }
                }
                if (agreement.providerName) {
                    const staff = document.querySelector('input[name="StaffName"]');
                    if (staff) staff.value = agreement.providerName;
                }
                return agreement;
            } catch (ex) {
                console.error("fetchAgreementProviderDetails:", ex);
                return null;
            }
        }

        // -----------------------
        // Build default KPI rows (if server didn't provide them)
        // -----------------------
        (function buildDefaultKpis() {
            const container = document.getElementById("kpiRows");
            if (!container) return;
            PARAMS.forEach((name, idx) => {
                const i = idx + 1;
                const row = document.createElement("div");
                row.className = "kpi-row";
                row.id = "row_" + i;

                row.innerHTML = `
                    <div class="kpi-n">${i}</div>
                    <div class="kpi-lbl">${name}
                        <input type="hidden" name="Details[${idx}].ParameterId" value="${i}" />
                    </div>
                    <div class="kpi-btns">${[...Array(10)].map((_,s)=>`<button type="button" class="kb" id="btn_${i}_${s+1}" onclick="setScore(${i},${s+1})">${s+1}</button>`).join('')}</div>
                    <div class="kpi-sc" id="s${i}"><span>—</span></div>
                    <input type="hidden" id="score_${i}" name="Details[${idx}].Score" />`;
                container.appendChild(row);
            });
        })();

        // -----------------------
        // Score state and helpers
        // -----------------------
        let scores = {};
        function setScore(i, val) {
            scores[i] = val;
            const input = document.getElementById("score_" + i);
            if (input) input.value = val;

            const sEl = document.getElementById("s" + i);
            const cls = val >= 7 ? 'sc-good' : (val >= 3 ? 'sc-avg' : 'sc-poor');
            if (sEl) sEl.innerHTML = `<span class="sc-badge ${cls}">${val >= 7 ? 'Good' : val >= 3 ? 'Average' : 'Poor'} (${val}/10)</span>`;

            for (let s = 1; s <= 10; s++) {
                const b = document.getElementById(`btn_${i}_${s}`);
                if (b) b.classList.remove('sg','sa','sp');
            }
            const sel = document.getElementById(`btn_${i}_${val}`);
            if (sel) sel.classList.add(val >= 7 ? 'sg' : val >= 3 ? 'sa' : 'sp');

            calc();
        }

        function calc() {
            let total = 0, count = 0;
            for (const k in scores) { total += scores[k]; count++; }
            const scoreDisplay = document.getElementById("scoreDisplay"); if (scoreDisplay) scoreDisplay.textContent = total;
            const bar = document.getElementById("bar"); if (bar) bar.style.width = total + "%";
            const totalHidden = document.getElementById("totalScoreHidden"); if (totalHidden) totalHidden.value = total;
            const countText = document.getElementById("countText"); if (countText) countText.textContent = `${count} / 10 scored`;

            const el = document.getElementById("paymentBadge");
            if (!el) return;
            let label = "0% — No Payment", badgeCls = "badge-none";
            if (total > 80) { label = "100% Payment"; badgeCls = "badge-full"; }
            else if (total > 60) { label = "90% Payment"; badgeCls = "badge-good"; }
            else if (total > 40) { label = "60% Payment"; badgeCls = "badge-mid"; }
            else if (total > 20) { label = "40% Payment"; badgeCls = "badge-low"; }

            el.textContent = label; el.className = "badge " + badgeCls;

            const slabs = ["slab0","slab21","slab41","slab61","slab71","slab81"];
            slabs.forEach(id=>{ const s=document.getElementById(id); if(s){ s.style.background=""; s.style.fontWeight=""; }});
            let active = total <= 20 ? "slab0" : total <=40 ? "slab21" : total <=60 ? "slab41" : total <=70 ? "slab61" : total <=80 ? "slab71" : "slab81";
            const activeEl = document.getElementById(active); if (activeEl) { activeEl.style.background="#fffbf0"; activeEl.style.fontWeight="600"; }
        }

        function resetForm() {
            scores = {};
            for (let i=1;i<=10;i++) {
                const si = document.getElementById("score_"+i); if(si) si.value = "";
                const sEl = document.getElementById("s"+i); if(sEl) sEl.innerHTML = "<span>—</span>";
                for (let s=1;s<=10;s++){ const b = document.getElementById(`btn_${i}_${s}`); if(b) b.classList.remove('sg','sa','sp'); }
            }
            document.getElementById("scoreDisplay").textContent = "0";
            document.getElementById("bar").style.width = "0%";
            document.getElementById("totalScoreHidden").value = "0";
            document.getElementById("paymentBadge").textContent = "0% Payment — No Payment";
            document.getElementById("countText").textContent = "0 / 10 scored";
        }

        // -----------------------
        // Validation
        // -----------------------
        function validateForm() {
            const providerId = document.getElementById("providerIdHidden").value;
            if (!providerId || providerId === "0") { alert("Provider information not found. Please select a valid agreement."); return false; }
            const hospitalId = document.getElementById("HospitalId").value;
            if (!hospitalId || hospitalId === "0") { alert("Hospital information not found. Please select a valid agreement."); return false; }
            if (!document.getElementById("fMonth").value) { alert("Please select a month."); return false; }
            for (let i=1;i<=10;i++){ if (!document.getElementById("score_"+i).value) { alert("Please score all 10 parameters before submitting."); return false; } }
            const staffName = (document.querySelector('input[name="StaffName"]').value || "").trim();
            if (!staffName) { alert("Please enter Staff Name."); return false; }

            document.getElementById("submitBtn").disabled = true;
            document.getElementById("submitBtn").textContent = "Submitting...";
            return true;
        }

        // -----------------------
        // Load performance: guarded ajax call — uses AgreementId/HospitalId/week/month/year
        // -----------------------
        function loadWeeklyPerformance() {
            const agreementId = $("#AgreementId").val();
            const hospitalId = $("#HospitalId").val();
            const week = $("#Week").val();
            const month = $("#fMonth").val();
            const year = $("#fYear").val();

            // guard: required values
            if (!agreementId || agreementId === "0" || !hospitalId || hospitalId === "0" || !week || !month || !year) {
                console.log("loadWeeklyPerformance skipped - missing values", { agreementId, hospitalId, week, month, year });
                return;
            }

            $.get("/WPR/GetWeeklyPerformanceData", {
                agreementId: agreementId,
                hospitalId: hospitalId,
                weekNo: week,
                month: month,
                year: year
            }, function(res) {
                buildPerformanceTable(res && res.data ? res.data : []);
            }).fail(function() {
                console.warn("GetWeeklyPerformanceData failed");
            });
        }

        // -----------------------
        // Build performance table from server response
        // -----------------------
        function buildPerformanceTable(data) {
            $("#kpiRows").empty();
            scores = {};

            (data || []).forEach(function(item, index) {
                const pid = item.parameterId;
                const name = item.parameterName;
                const systemScore = item.systemScore ?? 0;
                const isEditable = !!item.isEditable;
                const maxScore = item.maxScore || 10;

                let row = `<div class="kpi-row" id="row_${pid}">
                    <div class="kpi-n">${index+1}</div>
                    <div class="kpi-lbl">${name}
                        <input type="hidden" name="Details[${index}].ParameterId" value="${pid}" />
                        <input type="hidden" id="score_${pid}" name="Details[${index}].Score" />
                        <input type="hidden" name="Details[${index}].ParameterName" value="${name}" />
                    </div>`;

                if (isEditable) {
                    row += `<div class="kpi-btns">`;
                    for (let s=1;s<=maxScore;s++){
                        row += `<button type="button" class="kb" id="btn_${pid}_${s}" onclick="setScore(${pid},${s})">${s}</button>`;
                    }
                    row += `</div><div class="kpi-sc" id="s${pid}"><span>—</span></div>`;
                } else {
                    // auto score: render disabled buttons and badge
                    row += `<div class="kpi-btns">`;
                    for (let s=1;s<=maxScore;s++){
                        const css = (s===systemScore) ? (systemScore>=7 ? 'sg' : systemScore>=3 ? 'sa' : 'sp') : '';
                        row += `<button type="button" class="kb ${css}" disabled>${s}</button>`;
                    }
                    row += `</div>`;
                    const label = systemScore>=7 ? 'Good' : systemScore>=3 ? 'Average' : 'Poor';
                    const cls = systemScore>=7 ? 'sc-good' : systemScore>=3 ? 'sc-avg' : 'sc-poor';
                    row += `<div class="kpi-sc" id="s${pid}"><span class="sc-badge ${cls}">${label} (${systemScore}/10)</span><br/><small style="color:#777;font-size:11px;">Auto Calculated</small></div>`;
                    scores[pid] = systemScore;
                }

                row += `</div>`;
                $("#kpiRows").append(row);
                $("#score_" + pid).val(scores[pid] ?? "");
            });

            calc();
        }

        // -----------------------
        // Initial flow: ensure agreement details are loaded, then attempt first performance load
        // -----------------------
        $(function() {
            (async function initial() {
                const agreementInput = document.getElementById("AgreementId");
                const agreementId = agreementInput ? agreementInput.value : null;
                if (agreementId && agreementId !== "0") {
                    await fetchAgreementProviderDetails(agreementId);
                }
                // try loading performance once values are available
                loadWeeklyPerformance();
            })();
        });
    </script>
}