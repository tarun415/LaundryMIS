@model List<LaudaryMis.ViewModels.PickupListVM>

@{
    ViewBag.Title = "Pickup Entries";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-boxes-packing"></i></div>
    <div class="ph-text">
        <h1>Pickup Entries</h1>
        <p class="ph-sub">Linen collected from wards, and its delivery status</p>
    </div>
    <div class="ph-actions">
        <a href="~/Hospital/CreatePickUp" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> New Pickup
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

<!-- FILTERS -->
<div class="filter-bar">

    <div class="filter-field">
        <label class="form-label" for="filterStatus">Status</label>
        <select id="filterStatus" class="form-select">
            <option value="">All</option>
            <option value="Collected">Collected</option>
            <option value="Accepted">Accepted</option>
            <option value="Delivered">Delivered</option>
            <option value="Partial Delivered">Partial Delivered</option>
            <option value="Verified">Verified</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterWard">Ward</label>
        <select id="filterWard" class="form-select">
            <option value="">All</option>
        </select>
    </div>

    <div class="filter-field">
        <label class="form-label" for="filterDate">Date</label>
        <input type="date" id="filterDate" class="form-control" />
    </div>

    <div class="filter-actions">
        <button id="btnSearch" class="btn btn-primary">
            <i class="fa-solid fa-magnifying-glass"></i> Search
        </button>
        <button id="btnClear" class="btn btn-light">
            <i class="fa-solid fa-xmark"></i> Clear
        </button>
    </div>

</div>

<input type="hidden" id="SelectedDeliveryIds" value="" />

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="pickupTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>S.No.</th>
                        <th>Pickup No</th>
                        <th>Date</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th>Shift</th>
                        <th>Infected</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th>Status</th>
                        <th class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control"
                                data-id="@item.PickupId"
                                data-status="@item.Status"></td>

                            <td>@item.RowNum</td>

                            <td class="fw-semibold text-teal">@item.PickupNo</td>

                            <td class="nowrap">@item.PickupDateTime.ToString("dd MMM yyyy")</td>

                            <td>@item.HospitalName</td>
                            <td>@item.WardName</td>
                            <td>@item.ShiftName</td>
                            <td>
                                @if (item.IsInfected)
                                {
                                    <span class="badge bg-danger">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Infected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="fa-solid fa-check"></i> Normal
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold text-teal">@item.TotalCollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.TotalDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.TotalPendingQty</td>

                            <td>
                                @if (item.Status == "Collected")
                                {
                                    <span class="badge badge-warn">Collected</span>
                                }
                                else if (item.Status == "Partial Delivered")
                                {
                                    <span class="badge badge-info">Partial Delivered</span>
                                }
                                else if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-teal">Delivered</span>
                                }
                                else if (item.Status == "Verified")
                                {
                                    <span class="badge badge-ok">Verified</span>
                                }
                                else
                                {
                                    <span class="badge badge-navy">@item.Status</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="action-group justify-content-end">

                                    @if (item.Status == "Collected")
                                    {
                                        <a href="~/Hospital/EditPickup/@item.PickupId"
                                           class="btn btn-sm btn-icon btn-outline-primary"
                                           data-bs-toggle="tooltip" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-icon btn-outline-danger"
                                                data-bs-toggle="tooltip" title="Delete"
                                                onclick="deletePickup(@item.PickupId, this)">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>

                                        <a href="~/Hospital/PrintPickup/@item.PickupId"
                                           target="_blank" rel="noopener"
                                           class="btn btn-sm btn-icon btn-outline-secondary"
                                           data-bs-toggle="tooltip" title="Print">
                                            <i class="fa-solid fa-print"></i>
                                        </a>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.PrintUrlFilePath))
                                    {
                                        <a href="@item.PrintUrlFilePath"
                                           target="_blank" rel="noopener"
                                           class="btn btn-sm btn-icon btn-outline-secondary"
                                           data-bs-toggle="tooltip" title="Print challan">
                                            <i class="fa-solid fa-file-pdf"></i>
                                        </a>
                                    }

                                    @if ((item.Status == "Delivered" || item.Status == "Partial Delivered") && !item.IsVerified)
                                    {
                                        <button type="button" class="btn btn-sm btn-success"
                                                onclick="verifyDeliveries(@item.PickupId)">
                                            <i class="fa-solid fa-check"></i> Accept
                                        </button>
                                    }

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<!-- DELIVERY DETAIL MODAL -->
<div class="modal fade" id="deliveryDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-truck-ramp-box text-teal me-1"></i> Delivery Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="deliveryDetailContainer"></div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        var table;

        $(function () {

            // expandable: this table drives its own row.child() detail rows,
            // so the Responsive extension is turned off and the table scrolls sideways.
            table = LMIS.initTable('#pickupTable', {
                expandable: true,
                exports: false,
                order: [],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            // Ward filter options
            $.get('/Common/GetWards', function (data) {
                var html = '<option value="">All</option>';
                data.forEach(function (x) {
                    html += '<option value="' + x.id + '">' + x.name + '</option>';
                });
                $('#filterWard').html(html);
            });

            // Expand / collapse detail row
            $('#pickupTable tbody').on('click', '.details-control', function () {

                var $control = $(this);
                var tr = $control.closest('tr');
                var row = table.row(tr);

                var id = $control.data('id');
                var status = $control.data('status');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                if (status === "Collected" || status === "Accepted") {
                    loadPickupItems(id, row, tr);
                } else {
                    loadDeliveryHistory(id, row, tr);
                }
            });

            // Search
            $('#btnSearch').on('click', function () {

                $.get('/Hospital/SearchPickupList', {
                    status: $('#filterStatus').val(),
                    wardId: $('#filterWard').val(),
                    date: $('#filterDate').val()
                }, function (res) {

                    table.clear();

                    res.forEach(function (item) {

                        var statusBadge;
                        switch (item.status) {
                            case "Collected":
                                statusBadge = '<span class="badge badge-warn">Collected</span>'; break;
                            case "Partial Delivered":
                                statusBadge = '<span class="badge badge-info">Partial Delivered</span>'; break;
                            case "Delivered":
                                statusBadge = '<span class="badge badge-teal">Delivered</span>'; break;
                            case "Verified":
                                statusBadge = '<span class="badge badge-ok">Verified</span>'; break;
                            default:
                                statusBadge = '<span class="badge badge-navy">' + item.status + '</span>';
                        }

                        var actionButtons = '';

                        if (item.status === "Collected") {
                            actionButtons =
                                '<div class="action-group justify-content-end">' +
                                    '<a href="~/Hospital/EditPickup/' + item.pickupId + '" class="btn btn-sm btn-icon btn-outline-primary" title="Edit">' +
                                        '<i class="fa-solid fa-pen"></i></a>' +
                                    '<button type="button" class="btn btn-sm btn-icon btn-outline-danger" title="Delete" onclick="deletePickup(' + item.pickupId + ',this)">' +
                                        '<i class="fa-solid fa-trash"></i></button>' +
                                    '<a href="~/Hospital/PrintPickup/' + item.pickupId + '" target="_blank" rel="noopener" class="btn btn-sm btn-icon btn-outline-secondary" title="Print">' +
                                        '<i class="fa-solid fa-print"></i></a>' +
                                '</div>';
                        }
                        else if ((item.status === "Delivered" || item.status === "Partial Delivered") && !item.isVerified) {
                            actionButtons =
                                '<button type="button" class="btn btn-sm btn-success" onclick="verifyDeliveries(' + item.pickupId + ')">' +
                                    '<i class="fa-solid fa-check"></i> Accept</button>';
                        }
                        else if (item.isVerified) {
                            actionButtons = '<span class="badge badge-ok">Verified</span>';
                        }

                        table.row.add([
                            '<div class="details-control" data-id="' + item.pickupId + '" data-status="' + item.status + '"></div>',
                            item.rowNum,
                            '<span class="fw-semibold text-teal">' + item.pickupNo + '</span>',
                            formatDate(item.pickupDateTime),
                            item.hospitalName,
                            item.wardName,
                            item.shiftName,
                                    '<td>' +
            (item.isInfected
                ? '<span class="badge bg-danger"><i class="fa-solid fa-triangle-exclamation"></i> Infected</span>'
                : '<span class="badge bg-success"><i class="fa-solid fa-check"></i> Normal</span>') +
        '</td>',
                            '<span class="fw-bold text-teal">' + item.totalCollectedQty + '</span>',
                            '<span class="fw-bold text-success">' + item.totalDeliveredQty + '</span>',
                            '<span class="fw-bold text-danger">' + item.totalPendingQty + '</span>',
                            statusBadge,
                            actionButtons
                        ]);

                    });

                    table.draw();

                }).fail(function () {
                    LMIS.alert('Search failed', 'Could not load pickup entries.', 'error');
                });

            });

            // Clear
            $('#btnClear').on('click', function () {
                $('#filterStatus').val('');
                $('#filterWard').val('');
                $('#filterDate').val('');
                location.reload();
            });

        });

        function formatDate(data) {
            return new Date(data).toLocaleDateString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric'
            });
        }

        function deletePickup(id, btn) {
            LMIS.confirm({
                title: 'Delete this pickup?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Hospital/DeletePickup', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#pickupTable', btn);
                        LMIS.toast('Pickup deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                });
            });
        }

        function acceptDelivery(deliveryId) {
            LMIS.confirm({
                title: 'Accept this delivery?',
                icon: 'question',
                confirmText: 'Yes, accept',
                danger: false
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Hospital/AcceptDelivery', {
                    DeliveryId: deliveryId,
                    remarks: 'Accepted by Hospital'
                }, function (res) {
                    if (res.success) {
                        LMIS.alert('Success', res.message, 'success').then(function () { location.reload(); });
                    } else {
                        LMIS.alert('Error', res.message, 'error');
                    }
                });
            });
        }

        function loadPickupItems(pickupId, row, tr) {
            $.get('/Hospital/PickupItems/' + pickupId, function (data) {
                row.child(formatPickupItems(data)).show();
                tr.addClass('shown');
            });
        }

        function loadDeliveryHistory(pickupId, row, tr) {
            $.get('/Hospital/GetPickupDeliveryHistory/' + pickupId, function (data) {
                row.child(formatDeliveryHistory(data)).show();
                tr.addClass('shown');
            });
        }

        function formatPickupItems(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Linen Type</th>' +
                        '<th class="text-end">Collected Qty</th>' +
                        '<th class="text-end">Delivered Qty</th>' +
                        '<th class="text-end">Pending Qty</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td>' + x.linenTypeName + '</td>' +
                        '<td class="text-end fw-bold text-teal">' + x.collectedQty + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td class="text-end fw-bold text-danger">' + x.pendingQty + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

        function formatDeliveryHistory(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Delivery No</th>' +
                        '<th>Delivery Date</th>' +
                        '<th class="text-end">Delivered Qty</th>' +
                        '<th>Status</th>' +
                        '<th class="text-center">Accept</th>' +
                        '<th class="text-center">Reject</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {

                var deliveryDate = new Date(x.deliveryDateTime).toLocaleDateString('en-GB', {
                    day: '2-digit', month: 'short', year: 'numeric'
                });

                var acceptCell = !x.isVerified
                    ? '<input type="checkbox" class="form-check-input acceptCheck" value="' + x.deliveryId + '" />'
                    : '<span class="text-muted">&mdash;</span>';

                var rejectCell = x.status !== "Verified"
                    ? '<input type="checkbox" class="form-check-input rejectCheck" value="' + x.deliveryId + '" />'
                    : '<span class="text-muted">&mdash;</span>';

                html +=
                    '<tr>' +
                        '<td><a href="javascript:void(0)" class="delivery-detail-link fw-semibold"' +
                            ' data-deliveryid="' + x.deliveryId + '"' +
                            ' data-deliveryno="' + x.deliveryNo + '">' + x.deliveryNo + '</a></td>' +
                        '<td class="nowrap">' + deliveryDate + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td>' + x.status + '</td>' +
                        '<td class="text-center">' + acceptCell + '</td>' +
                        '<td class="text-center">' + rejectCell + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

        // Accept and Reject are mutually exclusive per row
        $(document).on('change', '.acceptCheck', function () {
            if ($(this).is(':checked')) {
                $(this).closest('tr').find('.rejectCheck').prop('checked', false);
            }
            updateSelectedDeliveries();
        });

        $(document).on('change', '.rejectCheck', function () {
            if ($(this).is(':checked')) {
                $(this).closest('tr').find('.acceptCheck').prop('checked', false);
            }
            updateSelectedDeliveries();
        });

        function updateSelectedDeliveries() {
            var ids = [];
            $('.acceptCheck:checked').each(function () {
                var id = $(this).val();
                if ($.inArray(id, ids) === -1) ids.push(id);
            });
            $('#SelectedDeliveryIds').val(ids.join(','));
        }

        function verifyDeliveries(pickupId) {

            var deliveryIds = $('#SelectedDeliveryIds').val();

            if (!deliveryIds) {
                LMIS.alert('Nothing selected',
                           'Expand the pickup row and tick at least one delivery to accept.',
                           'warning');
                return;
            }

            LMIS.confirm({
                title: 'Verify deliveries?',
                text: 'The selected deliveries will be marked as verified.',
                icon: 'question',
                confirmText: 'Yes, verify',
                danger: false
            }).then(function (ok) {
                if (ok) saveVerification(pickupId, deliveryIds);
            });
        }

        function saveVerification(pickupId, deliveryIds) {
            $.post('/Hospital/VerifyDeliveries', {
                PickupId: pickupId,
                DeliveryIds: deliveryIds,
                Remarks: ''
            }, function (res) {
                if (res.success) {
                    LMIS.alert('Success', res.message, 'success').then(function () { location.reload(); });
                } else {
                    LMIS.alert('Error', res.message, 'error');
                }
            });
        }

        // Delivery line-item detail
        $(document).on('click', '.delivery-detail-link', function () {

            var deliveryId = $(this).data('deliveryid');
            var deliveryNo = $(this).data('deliveryno');

            $.get('/Hospital/GetDeliveryItems', { deliveryId: deliveryId }, function (data) {

                var html =
                    '<div class="alert alert-info"><i class="fa-solid fa-receipt"></i>' +
                    '<span><strong>Delivery No:</strong> ' + deliveryNo + '</span></div>' +
                    '<div class="table-responsive"><table class="table table-hover align-middle">' +
                        '<thead><tr>' +
                            '<th>Linen Type</th>' +
                            '<th class="text-end">Collected</th>' +
                            '<th class="text-end">Delivered</th>' +
                            '<th class="text-end">Balance</th>' +
                        '</tr></thead><tbody>';

                data.forEach(function (x) {
                    html +=
                        '<tr>' +
                            '<td>' + x.linenName + '</td>' +
                            '<td class="text-end fw-bold text-teal">' + x.collectedQty + '</td>' +
                            '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                            '<td class="text-end fw-bold text-danger">' + x.pendingQty + '</td>' +
                        '</tr>';
                });

                html += '</tbody></table></div>' +
                    '<div class="alert alert-warning mb-0"><i class="fa-solid fa-circle-info"></i>' +
                    '<span><strong>Note:</strong> Balance Qty represents linen still pending for this pickup.</span></div>';

                $('#deliveryDetailContainer').html(html);
                $('#deliveryDetailModal').modal('show');
            });

        });

    </script>
}
