@using LaudaryMis.ViewModels
@model List<DailyEntryListVM>

@{
    ViewBag.Title = "Pending Verification";
    var total = Model?.Count ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-clipboard-list"></i></div>
    <div class="ph-text">
        <h1>Pending Verification</h1>
        <p class="ph-sub">@total entr@(total == 1 ? "y" : "ies") awaiting your confirmation</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="verificationTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="3">Date</th>
                        <th data-priority="2">Ward</th>
                        <th data-priority="4">Linen</th>
                        <th data-priority="5" class="text-end">Pickup</th>
                        <th data-priority="5" class="text-end">Delivered</th>
                        <th data-priority="1" class="no-sort">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="nowrap">@item.EntryDate.ToString("dd MMM yyyy")</td>
                            <td>@item.WardName</td>
                            <td class="fw-semibold">@item.LinenTypeName</td>
                            <td class="text-end fw-bold text-teal">@item.TotalPickupQty</td>
                            <td class="text-end fw-bold text-success">@item.CleanDeliveredQty</td>

                            <td>
                                <div class="d-flex flex-wrap align-items-center gap-2">

                                    <form method="post" action="~/Hospital/Verify" class="d-inline">
                                        <input type="hidden" name="id" value="@item.EntryId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa-solid fa-check"></i> Verify
                                        </button>
                                    </form>

                                    <form method="post" action="~/Hospital/Reject" class="d-flex align-items-center gap-2">
                                        <input type="hidden" name="id" value="@item.EntryId" />
                                        <input type="text" name="reason" class="form-control form-control-sm"
                                               placeholder="Reason" required style="max-width: 170px;" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fa-solid fa-xmark"></i> Reject
                                        </button>
                                    </form>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#verificationTable', {
                exportTitle: 'Pending Verification',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });
        });
    </script>
}
