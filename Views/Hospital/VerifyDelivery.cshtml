@model LaudaryMis.ViewModels.VerifyDeliveryVM

<form asp-action="VerifyDelivery"
      method="post"
      enctype="multipart/form-data">

    <input type="hidden" asp-for="DeliveryId" />

    <div class="mb-3">
        <label>Linen Type</label>

        <input type="text"
               class="form-control"
               value="@Model.LinenType"
               readonly />
    </div>

    <div class="mb-3">
        <label>Delivered Qty</label>

        <input type="text"
               class="form-control"
               value="@Model.CleanCount"
               readonly />
    </div>

    <div class="mb-3">
        <label>Verified Qty</label>

        <input asp-for="VerifiedQty"
               class="form-control" />

        <span asp-validation-for="VerifiedQty"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Verification Remark</label>

        <textarea asp-for="VerificationRemark"
                  class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label>
            Upload Log Book
            <span class="text-danger">*</span>
        </label>

        <input asp-for="LogBookFile"
               type="file"
               class="form-control"
               required />

        <span asp-validation-for="LogBookFile"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-success">
        Verify
    </button>

</form>

<script>
    $('form').submit(function () {

        if (!$('input[type="file"]').val()) {

            alert("Upload log book first");

            return false;
        }
    });
</script>