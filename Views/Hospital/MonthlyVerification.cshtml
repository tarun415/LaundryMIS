@model List<LaudaryMis.ViewModels.MonthlyVerificationListVM>

@using System.Globalization

@{
    ViewBag.Title = "Weekly Verification Report";
}

@section Styles {
    <style>
        /* Remarks column stays a predictable width so the table doesn't jump */
        .remarkBox {
            width: 150px;
            min-width: 150px;
            resize: vertical;
            min-height: 36px;
            font-size: .8rem;
        }

        .child-wrapper {
            padding: 12px;
            background: var(--surface-2);
            border-radius: var(--r-sm);
        }
    </style>
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-calendar-check"></i></div>
    <div class="ph-text">
        <h1>Weekly Verification Report</h1>
        <p class="ph-sub">Confirm each week's linen figures, then upload the monthly logbook</p>
    </div>
</div>

<!-- FILTER -->
<form method="get">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="month">Month</label>
            <select name="month" id="month" class="form-select">
                @for (int i = 1; i <= 12; i++)
                {
                    if (ViewBag.Month == i)
                    {
                        <option value="@i" selected="selected">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                    }
                    else
                    {
                        <option value="@i">@CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                    }
                }
            </select>
        </div>

        <div class="filter-field">
            <label class="form-label" for="year">Year</label>
            <select name="year" id="year" class="form-select">
                @for (int y = DateTime.Now.Year; y >= 2024; y--)
                {
                    if (ViewBag.Year == y)
                    {
                        <option value="@y" selected="selected">@y</option>
                    }
                    else
                    {
                        <option value="@y">@y</option>
                    }
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
        </div>

    </div>
</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblMonthly" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort" style="width:40px;"></th>
                        <th>S.No</th>
                        <th>Week</th>
                        <th class="text-end">Pickup</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th>Status</th>
                        <th class="no-sort">Remark</th>
                        <th class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control" data-week="@item.WeekNo"></td>

                            <td>@item.RowNum</td>

                            <td class="nowrap">
                                @item.WeekStartDate.ToString("dd MMM") &ndash; @item.WeekEndDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-end fw-bold text-teal">@item.TotalPickupQty</td>
                            <td class="text-end fw-bold text-success">@item.CleanDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.TotalPendingQty</td>

                            <td class="statusCell">
                                @if (item.Status == "Verified")
                                {
                                    <span class="badge badge-ok">Verified</span>
                                }
                                else if (item.Status == "Delivered")
                                {
                                    <span class="badge badge-info">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge badge-warn">Pending</span>
                                }
                            </td>

                            <td>
                                <textarea class="form-control form-control-sm remarkBox" rows="1"
                                          @(item.Status == "Verified" ? "readonly" : "")>@item.Remark</textarea>
                            </td>

                            <td class="text-end">
                                @if (item.Status == "Delivered")
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-primary btnVerify"
                                            data-hospitalid="@item.HospitalId"
                                            data-entryids="@item.EntryIds"
                                            data-weekno="@item.WeekNo"
                                            data-fromdate="@item.WeekStartDate"
                                            data-todate="@item.WeekEndDate"
                                            data-pickup="@item.TotalPickupQty"
                                            data-delivered="@item.CleanDeliveredQty"
                                            data-pending="@item.TotalPendingQty">
                                        <i class="fa-solid fa-check"></i> Verify
                                    </button>
                                }
                                else if (item.Status == "Verified")
                                {
                                    <button type="button" class="btn btn-sm btn-success" disabled>
                                        <i class="fa-solid fa-circle-check"></i> Verified
                                    </button>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

<!-- LOGBOOK -->
@if (ViewBag.IsMonthVerified == true && string.IsNullOrEmpty(ViewBag.LogBookPath))
{
    <div class="card mt-3" id="DivLogBook">
        <div class="card-header">
            <i class="fa-solid fa-book text-teal"></i>
            <span class="card-title">Upload Monthly LogBook</span>
        </div>

        <div class="card-body">
            <form method="post" enctype="multipart/form-data" asp-action="SaveMonthlyLogBook">

                <input type="hidden" name="Month" value="@ViewBag.Month" />
                <input type="hidden" name="Year" value="@ViewBag.Year" />

                <div class="row g-3 align-items-end">

                    <div class="col-12 col-md-4">
                        <label class="form-label" for="LogBookFile">LogBook File</label>
                        <input type="file" name="LogBookFile" id="LogBookFile"
                               class="form-control logBookFile"
                               accept=".pdf,.jpg,.jpeg,.png" required />
                    </div>

                    <div class="col-12 col-md-5">
                        <label class="form-label" for="Remark">Remark</label>
                        <input type="text" name="Remark" id="Remark" class="form-control" placeholder="Enter remark" />
                    </div>

                    <div class="col-12 col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fa-solid fa-upload"></i> Save LogBook
                        </button>
                    </div>

                </div>

            </form>
        </div>
    </div>
}
else if (ViewBag.IsMonthVerified == true && !string.IsNullOrEmpty(ViewBag.LogBookPath))
{
    <div class="card mt-3">
        <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="stat-lbl">Monthly LogBook</div>
                <div class="stat-sub">Uploaded for this month</div>
            </div>
            <a href="@ViewBag.LogBookPath" target="_blank" rel="noopener" class="btn btn-primary">
                <i class="fa-solid fa-book-open"></i> View LogBook
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>

        $(function () {

            // expandable: this table owns its row.child() drilldown,
            // so Responsive is off and the table scrolls sideways instead.
            var table = LMIS.initTable('#tblMonthly', {
                expandable: true,
                exportTitle: 'Weekly Verification',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            function format(data) {

                var html =
                    '<div class="child-wrapper"><div class="table-responsive">' +
                    '<table class="child-table mb-0">' +
                        '<thead><tr>' +
                            '<th>Date</th>' +
                            '<th class="text-end">Pickup</th>' +
                            '<th class="text-end">Delivered</th>' +
                            '<th class="text-end">Pending</th>' +
                            '<th>Status</th>' +
                        '</tr></thead><tbody>';

                $.each(data, function (i, x) {

                    var badge;
                    if (x.status === 'Verified')      badge = '<span class="badge badge-ok">Verified</span>';
                    else if (x.status === 'Delivered') badge = '<span class="badge badge-info">Delivered</span>';
                    else                               badge = '<span class="badge badge-warn">Pending</span>';

                    var entryDate = new Date(x.entryDate).toLocaleDateString('en-GB', {
                        day: '2-digit', month: 'short', year: 'numeric'
                    });

                    html +=
                        '<tr>' +
                            '<td class="nowrap">' + entryDate + '</td>' +
                            '<td class="text-end fw-bold text-teal">' + x.totalPickupQty + '</td>' +
                            '<td class="text-end fw-bold text-success">' + x.cleanDeliveredQty + '</td>' +
                            '<td class="text-end fw-bold text-danger">' + x.totalPendingQty + '</td>' +
                            '<td>' + badge + '</td>' +
                        '</tr>';
                });

                return html + '</tbody></table></div></div>';
            }

            // Weekly drilldown
            $('#tblMonthly tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var weekNo = $(this).data('week');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Hospital/GetWeeklyDrilldown', {
                    weekNo: weekNo,
                    month: '@ViewBag.Month',
                    year: '@ViewBag.Year'
                }, function (data) {
                    row.child(format(data)).show();
                    tr.addClass('shown');
                });
            });

            // Verify a week
            $(document).on('click', '.btnVerify', function (e) {

                e.preventDefault();

                var btn = $(this);
                var tr = btn.closest('tr');

                var model = {
                    HospitalId: btn.data('hospitalid'),
                    EntryIds: btn.data('entryids'),
                    WeekNo: btn.data('weekno'),
                    FromDate: btn.data('fromdate'),
                    ToDate: btn.data('todate'),
                    TotalPickupQty: btn.data('pickup'),
                    TotalDeliveredQty: btn.data('delivered'),
                    TotalPendingQty: btn.data('pending'),
                    Remark: tr.find('.remarkBox').val(),
                    Status: btn.data('pending') == 0 ? 'Verified' : 'Pending',
                    CreatedBy: 1
                };

                $.ajax({
                    url: '/Hospital/SaveWeeklyVerificationLog',
                    type: 'POST',
                    data: model,

                    beforeSend: function () {
                        btn.prop('disabled', true);
                        btn.html('<i class="fa-solid fa-circle-notch fa-spin"></i> Saving…');
                    },

                    success: function (response) {
                        if (response.success) {
                            LMIS.toast(response.message || 'Week verified');
                            setTimeout(function () { location.reload(); }, 800);
                        } else {
                            btn.prop('disabled', false);
                            btn.html('<i class="fa-solid fa-check"></i> Verify');
                            LMIS.alert('Could not verify', response.message || 'Please try again.', 'error');
                        }
                    },

                    error: function () {
                        btn.prop('disabled', false);
                        btn.html('<i class="fa-solid fa-check"></i> Verify');
                        LMIS.alert('Could not verify', 'Something went wrong.', 'error');
                    }
                });

            });

        });

    </script>
}
