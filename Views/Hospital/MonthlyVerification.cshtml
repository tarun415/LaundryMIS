@model List<LaudaryMis.ViewModels.MonthlyVerificationListVM>

@using System.Globalization

<style>

    body {
        font-size: 14px;
        background: #f5f7fb;
    }

    .card {
        border: none;
        border-radius: 14px;
    }

    .card-header {
        padding: 14px 18px;
        font-size: 17px;
        font-weight: 600;
    }

    .form-control,
    .form-select {
        font-size: 13px;
        border-radius: 8px;
    }

    .table td,
    .table th {
        vertical-align: middle !important;
        font-size: 13px;
        padding: 10px 8px;
        white-space: nowrap;
    }

    .table thead th {
        background: #212529;
        color: #fff;
    }

    .badge {
        font-size: 11px;
        padding: 5px 8px;
    }

    .btn-sm {
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 12px;
    }

    .remarkBox {
        width: 140px !important;
        min-width: 140px !important;
        max-width: 140px !important;
        resize: vertical;
        font-size: 12px;
        min-height: 38px;
        overflow-y: hidden;
    }

    .details-control {
        cursor: pointer;
        font-size: 18px;
        text-align: center;
        font-weight: bold;
        width: 40px;
    }

    .child-table td,
    .child-table th {
        font-size: 12px !important;
        padding: 8px !important;
    }

    .child-wrapper {
        padding: 12px;
        background: #f8f9fa;
        border-radius: 10px;
    }

    div.dataTables_wrapper div.dataTables_filter input {
        height: 34px;
        border-radius: 8px;
        border: 1px solid #ced4da;
        margin-left: 5px;
    }

    .dataTables_length select {
        height: 34px;
        border-radius: 8px;
        border: 1px solid #ced4da;
    }

    .dt-buttons {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
    }

        .dt-buttons .btn {
            width: 32px !important;
            height: 32px !important;
            border-radius: 50% !important;
            padding: 0 !important;
            display: flex !important;
            align-items: center;
            justify-content: center;
            color: #fff !important;
            border: none !important;
            font-size: 14px;
        }

    .buttons-copy {
        background: #6c757d !important;
    }

    .buttons-excel {
        background: #198754 !important;
    }

    .buttons-pdf {
        background: #dc3545 !important;
    }

    .buttons-print {
        background: #0d6efd !important;
    }

</style>
<style>

    .btn-gradient-logbook {
        background: linear-gradient(135deg, #0ea5e9, #2563eb);
        color: #fff !important;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        font-size: 14px;
        transition: all 0.3s ease;
        text-decoration: none;
    }

        .btn-gradient-logbook:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
            color: #fff !important;
        }

        .btn-gradient-logbook i {
            font-size: 16px;
        }

</style>
<div class="container-fluid mt-4">

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            Weekly Verification Report

        </div>

        <div class="card-body">

            <form method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-2">

                        <label class="fw-semibold mb-1">
                            Month
                        </label>

                        <select name="month"
                                class="form-select">

                            @for (int i = 1; i <= 12; i++)
                            {
                                if (ViewBag.Month == i)
                                {
                                    <option value="@i"
                                            selected="selected">
                                        @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                                    </option>
                                }
                                else
                                {
                                    <option value="@i">
                                        @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <label class="fw-semibold mb-1">
                            Year
                        </label>

                        <select name="year"
                                class="form-select">

                            @for (int y = DateTime.Now.Year;
                                                        y >= 2024;
                                                        y--)
                            {
                                if (ViewBag.Year == y)
                                {
                                    <option value="@y"
                                            selected="selected">
                                        @y
                                    </option>
                                }
                                else
                                {
                                    <option value="@y">
                                        @y
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            Filter

                        </button>

                    </div>

                </div>

            </form>

            

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table id="tblMonthly"
                       class="table table-bordered table-hover align-middle">

                    <thead>

                        <tr>

                            <th style="width:40px;"></th>

                            <th>S.No</th>
                            <th>Week</th>
                            <th>Pickup</th>
                            <th>Delivered</th>
                            <th>Pending</th>
                            <th>Status</th>
                            <th>Remark</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Status == "Verified" ? "table-success" : "")">

                                <td class="details-control"
                                    data-week="@item.WeekNo">

                                    ➕

                                </td>

                                <td>
                                    @item.RowNum
                                </td>

                                <td>

                                    @item.WeekStartDate.ToString("dd MMM")
                                    -
                                    @item.WeekEndDate.ToString("dd MMM yyyy")

                                </td>

                                <td class="fw-bold text-primary">
                                    @item.TotalPickupQty
                                </td>

                                <td class="fw-bold text-success">
                                    @item.CleanDeliveredQty
                                </td>

                                <td class="fw-bold text-danger">
                                    @item.TotalPendingQty
                                </td>

                                <td class="statusCell">

                                    @if (item.Status == "Verified")
                                    {
                                        <span class="badge bg-success">
                                            Verified
                                        </span>
                                    }
                                    else if (item.Status == "Delivered")
                                    {
                                        <span class="badge bg-info">
                                            Delivered
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }

                                </td>

                                <td>

                                    <textarea class="form-control remarkBox"
                                          rows="1"
                                          @(item.Status == "Verified" ? "readonly" : "")>@item.Remark</textarea>

                                </td>

                                <td>

                                    @if (item.Status == "Delivered")
                                    {
                                        <button type="button"
                                                class="btn btn-primary btn-sm btnVerify"
                                                data-hospitalid="@item.HospitalId"
                                                data-entryids="@item.EntryIds"
                                                data-weekno="@item.WeekNo"
                                                data-fromdate="@item.WeekStartDate"
                                                data-todate="@item.WeekEndDate"
                                                data-pickup="@item.TotalPickupQty"
                                                data-delivered="@item.CleanDeliveredQty"
                                                data-pending="@item.TotalPendingQty">

                                            Verify

                                        </button>
                                    }
                                    else if (item.Status == "Verified")
                                    {
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                disabled>

                                            Verified

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    @if (ViewBag.IsMonthVerified == true && string.IsNullOrEmpty(ViewBag.LogBookPath))
    {
        <div class="card shadow-sm" id="DivLogBook">

            <div class="card-body">
               
                <form method="post"
                      enctype="multipart/form-data"
                      asp-action="SaveMonthlyLogBook">
                    <input type="hidden"
                           name="Month"
                           value="@ViewBag.Month" />

                    <input type="hidden"
                           name="Year"
                           value="@ViewBag.Year" />
                    <div class="row g-3 align-items-end">

                        <div class="col-md-3">

                            <label class="fw-semibold mb-1">
                                Upload LogBook
                            </label>

                            <input type="file"
                                   name="LogBookFile"
                                   class="form-control logBookFile"
                                   accept=".pdf,.jpg,.jpeg,.png"
                                   required />

                        </div>

                        <div class="col-md-5">

                            <label class="fw-semibold mb-1">
                                Remark
                            </label>

                            <input type="text"
                                   name="Remark"
                                   class="form-control"
                                   placeholder="Enter remark" />

                        </div>

                        <div class="col-md-2">

                            <button type="submit"
                                    class="btn btn-success">

                                Save

                            </button>

                        </div>

                    </div>

                </form>

            </div>

        </div>
    }
    else if (ViewBag.IsMonthVerified == true && !string.IsNullOrEmpty(ViewBag.LogBookPath) )
    {


        <a href="@ViewBag.LogBookPath"
           target="_blank"
           class="btn btn-gradient-logbook d-inline-flex align-items-center gap-2 px-4 py-2 shadow-sm">

            <i class="bi bi-journal-text"></i>

            <span>
                View LogBook
            </span>

        </a>
        
    }
</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            var table =
                $('#tblMonthly').DataTable({

                    pageLength: 10,

                    responsive: true,

                    autoWidth: false,

                    dom:
                        "<'row align-items-center mb-3'<'col-md-6 d-flex align-items-center gap-2'B><'col-md-6 text-end'f>>" +
                        "<'row'<'col-12'tr>>" +
                        "<'row mt-3'<'col-md-5'i><'col-md-7 text-end'p>>",

                    buttons: [

                        {
                            extend: 'copy',
                            className: 'btn buttons-copy',
                            text: '📋'
                        },

                        {
                            extend: 'excel',
                            className: 'btn buttons-excel',
                            text: '📊'
                        },

                        {
                            extend: 'pdf',
                            className: 'btn buttons-pdf',
                            text: '📄'
                        },

                        {
                            extend: 'print',
                            className: 'btn buttons-print',
                            text: '🖨️'
                        }

                    ]

                });


            function format(data) {

                let html = `

                    <div class="child-wrapper">

                        <table class="table table-bordered child-table mb-0">

                            <thead class="table-dark">

                                <tr>

                                    <th>Date</th>
                                    <th>Pickup</th>
                                    <th>Delivered</th>
                                    <th>Pending</th>
                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>
                `;

                $.each(data, function (i, x) {

                           let badge = '';

        if (x.status == 'Verified') {

            badge =
                '<span class="badge bg-success">Verified</span>';
        }
        else if (x.status == 'Delivered') {

            badge =
                '<span class="badge bg-info">Delivered</span>';
        }
        else {

            badge =
                '<span class="badge bg-warning text-dark">Pending</span>';
        }

                    html += `

                        <tr>

                            <td>

                                ${new Date(x.entryDate).toLocaleDateString(
                                    'en-GB',
                                    {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric'
                                    })}

                            </td>

                            <td class="fw-bold text-primary">
                                ${x.totalPickupQty}
                            </td>

                            <td class="fw-bold text-success">
                                ${x.cleanDeliveredQty}
                            </td>

                            <td class="fw-bold text-danger">
                                ${x.totalPendingQty}
                            </td>

                            <td>
                                ${badge}
                            </td>

                        </tr>
                    `;
                });

                html += `

                            </tbody>

                        </table>

                    </div>
                `;

                return html;
            }


            $('#tblMonthly tbody').on(
                'click',
                'td.details-control',
                function () {

                    var tr = $(this).closest('tr');

                    var row = table.row(tr);

                    var weekNo =
                        $(this).data('week');

                    if (row.child.isShown()) {

                        row.child.hide();

                        tr.removeClass('shown');

                        $(this).html('➕');
                    }
                    else {

                        $.get(
                            '/Hospital/GetWeeklyDrilldown',
                            {
                                weekNo: weekNo,
                                month: '@ViewBag.Month',
                                year: '@ViewBag.Year'
                            },

                            function (data) {

                                row.child(
                                    format(data)
                                ).show();

                                tr.addClass('shown');

                                tr.find('.details-control')
                                    .html('➖');

                            });

                    }

                });


            $(document).on(
                'click',
                '.btnVerify',
                function (e) {

                    e.preventDefault();

                    let btn = $(this);

                    let tr = btn.closest('tr');

                           let model = {

            HospitalId:
                btn.data('hospitalid'),

            EntryIds:
                btn.data('entryids'),

            WeekNo:
                btn.data('weekno'),

            FromDate:
                btn.data('fromdate'),

            ToDate:
                btn.data('todate'),

            TotalPickupQty:
                btn.data('pickup'),

            TotalDeliveredQty:
                btn.data('delivered'),

            TotalPendingQty:
                btn.data('pending'),

            Remark:
                tr.find('.remarkBox').val(),

            Status:
                btn.data('pending') == 0
                    ? 'Verified'
                    : 'Pending',

            CreatedBy: 1
        };

                    $.ajax({

                        url: '/Hospital/SaveWeeklyVerificationLog',

                        type: 'POST',

                        data: model,

                        beforeSend: function () {

                            btn.prop('disabled', true);

                            btn.html('Saving...');
                        },

                               success: function (response) {

            if (response.success) {

                btn
                    .removeClass('btn-primary')
                    .addClass('btn-success');

                btn.html('Verified');

                btn.prop('disabled', true);

                tr
                    .removeClass('table-warning')
                    .addClass('table-success');

                tr.find('.statusCell').html(
                    '<span class="badge bg-success">Verified</span>'
                );

                tr.find('.remarkBox')
                    .prop('readonly', true);

                alert(response.message);
            }
            else {

                btn.prop('disabled', false);

                btn.html('Verify');

                alert(response.message);
            }
        },

                        error: function () {

                            btn.prop('disabled', false);

                            btn.html('Verify');

                            alert('Something went wrong.');
                        }

                    });

                });

        });

    </script>

}