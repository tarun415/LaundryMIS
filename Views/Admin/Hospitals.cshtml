@model IEnumerable<LaudaryMis.ViewModels.HospitalVM>

@{
    ViewBag.Title = "Hospital List";
    var total = Model?.Count() ?? 0;
    var active = Model?.Count(h => h.IsActive && h.ApprovalStatus == "Approved") ?? 0;
    var pending = Model?.Count(h => h.ApprovalStatus == "Pending") ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hospital"></i></div>
    <div class="ph-text">
        <h1>Hospital Management</h1>
        <p class="ph-sub">@total registered &middot; @active active@(pending > 0 ? " · " + pending + " pending approval" : "")</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/CreateHospital" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Hospital
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="hospitalTable" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th data-priority="1">Hospital Name</th>
                        <th data-priority="3">District</th>
                        <th data-priority="4">Phone</th>
                        <th data-priority="2">Status</th>
                        <th data-priority="1" class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@h.HospitalName</td>
                            <td>@h.DistrictName</td>
                            <td class="nowrap">@h.Phone</td>
                            <td>
                                @if (h.ApprovalStatus == "Pending")
                                {
                                    <span class="badge badge-warn"><i class="fa-solid fa-hourglass-half"></i> Pending approval</span>
                                }
                                else if (h.ApprovalStatus == "Rejected")
                                {
                                    <span class="badge badge-danger" title="@h.ApprovalRemarks"><i class="fa-solid fa-ban"></i> Rejected</span>
                                }
                                else if (h.IsActive)
                                {
                                    <span class="badge badge-ok"><i class="fa-solid fa-circle-check"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-group justify-content-end">
                                    @if (h.ApprovalStatus == "Pending" || h.ApprovalStatus == "Rejected")
                                    {
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-success"
                                                data-bs-toggle="tooltip" title="Approve"
                                                onclick="approveHospital(@h.HospitalId)">
                                            <i class="fa-solid fa-check"></i>
                                        </button>
                                    }
                                    @if (h.ApprovalStatus == "Pending")
                                    {
                                        <button type="button" class="btn btn-sm btn-icon btn-outline-warning"
                                                data-bs-toggle="tooltip" title="Reject"
                                                onclick="rejectHospital(@h.HospitalId)">
                                            <i class="fa-solid fa-xmark"></i>
                                        </button>
                                    }
                                    <a href="/Admin/EditHospital/@h.HospitalId"
                                       class="btn btn-sm btn-icon btn-outline-primary"
                                       data-bs-toggle="tooltip" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-outline-danger"
                                            data-bs-toggle="tooltip" title="Delete"
                                            onclick="deleteHospital(@h.HospitalId, this)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#hospitalTable', { exportTitle: 'Hospitals' });
        });


        function approveHospital(id) {
            LMIS.confirm({
                title: 'Approve this hospital?',
                text: 'They will be able to sign in and be used in agreements.',
                confirmText: 'Yes, approve'
            }).then(function (ok) {
                if (!ok) return;
                $.post('/Admin/ApproveHospital', { id: id }, function (res) {
                    if (res.success) { LMIS.toast(res.message); setTimeout(function () { location.reload(); }, 600); }
                    else LMIS.alert('Approval failed', res.message || 'Please try again.', 'error');
                }).fail(function () {
                    LMIS.alert('Approval failed', 'Could not reach the server.', 'error');
                });
            });
        }

        function rejectHospital(id) {
            Swal.fire({
                title: 'Reject this hospital?',
                input: 'textarea',
                inputLabel: 'Reason (shown to the hospital at login)',
                inputAttributes: { maxlength: 500 },
                showCancelButton: true,
                confirmButtonText: 'Reject',
                preConfirm: function (v) {
                    if (!v || !v.trim()) { Swal.showValidationMessage('Please enter a reason'); return false; }
                    return v.trim();
                }
            }).then(function (r) {
                if (!r.isConfirmed) return;
                $.post('/Admin/RejectHospital', { id: id, remarks: r.value }, function (res) {
                    if (res.success) { LMIS.toast(res.message); setTimeout(function () { location.reload(); }, 600); }
                    else LMIS.alert('Rejection failed', res.message || 'Please try again.', 'error');
                }).fail(function () {
                    LMIS.alert('Rejection failed', 'Could not reach the server.', 'error');
                });
            });
        }

        function deleteHospital(id, btn) {
            LMIS.confirm({
                title: 'Delete this hospital?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Admin/DeleteHospital', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#hospitalTable', btn);
                        LMIS.toast('Hospital deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                }).fail(function () {
                    LMIS.alert('Delete failed', 'Could not reach the server.', 'error');
                });
            });
        }
    </script>
}
