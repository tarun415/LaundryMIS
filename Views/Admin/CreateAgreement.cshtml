@model LaudaryMis.ViewModels.AgreementVM

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <!-- Header -->
        <div class="card-header d-flex justify-content-between align-items-center text-white"
             style="background: linear-gradient(135deg, #4f46e5, #1e3a8a);">

            <h4 class="mb-0">
                <i class="fa fa-file-contract me-2"></i>
                @(Model == null || Model.Id == 0 ? "Create Agreement" : "Edit Agreement")
            </h4>

            <a asp-action="Agreements" asp-controller="Admin"
               class="btn btn-light rounded-pill px-3">
                ← Back to List
            </a>
        </div>

        <div class="card-body p-4">

            <!-- ✅ SUCCESS MESSAGE -->
            @if (TempData["success"] != null)
            {
                <script>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["success"]',
                        timer: 2000,
                        showConfirmButton: false
                    });
                </script>
            }

            <!-- FORM -->
            <form id="agreementForm" asp-action="CreateAgreement" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="FilePath" />

                <div class="row g-3">

                    <!-- Provider -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Provider <span class="text-danger">*</span>
                        </label>
                        <select asp-for="ProviderId" class="form-select shadow-sm" required>
                            <option value="">-- Select Provider --</option>
                            @foreach (var p in Model.Providers)
                            {
                                <option value="@p.ProviderId">@p.ProviderName</option>
                            }
                        </select>
                    </div>

                    <!-- Hospital -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Hospital <span class="text-danger">*</span>
                        </label>
                        <select asp-for="HospitalId" class="form-select shadow-sm" required>
                            <option value="">-- Select Hospital --</option>
                            @foreach (var h in Model.Hospitals)
                            {
                                <option value="@h.HospitalId">@h.HospitalName</option>
                            }
                        </select>
                    </div>

                    <!-- Bed Count -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Bed Count <span class="text-danger">*</span>
                        </label>
                        <input asp-for="BedCount" id="BedCount" class="form-control" required />
                    </div>

                    <!-- Rate -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Rate Per Bed <span class="text-danger">*</span>
                        </label>
                        <input asp-for="RatePerBed" id="RatePerBed" class="form-control" required />
                    </div>

                    <!-- Start Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Start Date <span class="text-danger">*</span>
                        </label>
                        <input asp-for="StartDate" id="StartDate" type="date" class="form-control shadow-sm" required />
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            End Date  <span class="text-danger">*</span>
                        </label>
                        <input asp-for="EndDate" id="EndDate" type="date" class="form-control shadow-sm required" />
                    </div>

                    <!-- File Upload -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Agreement File <span class="text-danger">*</span>
                        </label>

                        <div class="border rounded-3 p-3 bg-light">

                            <input type="file" id="AgreementFile" name="AgreementFile" class="form-control mb-2" />

                            <!-- Existing file -->
                            @if (!string.IsNullOrEmpty(Model.FilePath))
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-file text-primary"></i>
                                    <a href="@Model.FilePath" target="_blank">
                                        View Existing File
                                    </a>
                                </div>
                            }

                            <small class="text-muted">
                                Allowed: PDF, JPG, PNG | Max: 2MB
                            </small>
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end mt-4">

                    <button type="reset" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                        Reset
                    </button>

                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                        @(Model == null || Model.Id == 0 ? "💾 Save Agreement" : "✏️ Update Agreement")
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>



<!-- ✅ VALIDATION SCRIPT -->
<script>
    document.getElementById("agreementForm").addEventListener("submit", function (e) {

        e.preventDefault();

        let provider = document.getElementById("ProviderId").value;
        let hospital = document.getElementById("HospitalId").value;
        let bed = document.getElementById("BedCount").value;
        let rate = document.getElementById("RatePerBed").value;
        let start = document.getElementById("StartDate").value;
        let end = document.getElementById("EndDate").value;

        let fileInput = document.getElementById("AgreementFile");
        let existingFile = document.querySelector('input[name="FilePath"]').value;

        if (!provider) return Swal.fire("Validation Error", "Select provider", "warning");
        if (!hospital) return Swal.fire("Validation Error", "Select hospital", "warning");
        if (!bed || bed <= 0) return Swal.fire("Validation Error", "Invalid bed count", "warning");
        if (!rate || rate <= 0) return Swal.fire("Validation Error", "Invalid rate", "warning");
        if (!start) return Swal.fire("Validation Error", "Start date required", "warning");
         if (!end) return Swal.fire("Validation Error", "End date required", "warning");

        if (end) {
            let s = new Date(start);
            let eDate = new Date(end);
            if (eDate < s) return Swal.fire("Validation Error", "End date must be after start", "warning");
        }

        // File validation
        if (!fileInput.files.length && !existingFile) {
            return Swal.fire("Validation Error", "Upload agreement file", "warning");
        }

        if (fileInput.files.length > 0) {
            let file = fileInput.files[0];

            let allowed = ["application/pdf", "image/jpeg", "image/png"];

            if (!allowed.includes(file.type)) {
                return Swal.fire("Invalid File", "Only PDF/JPG/PNG allowed", "error");
            }

            if (file.size > 2 * 1024 * 1024) {
                return Swal.fire("File Too Large", "Max 2MB allowed", "error");
            }
        }

        // Confirm
        Swal.fire({
            title: "Are you sure?",
            text: "Save this agreement?",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#198754"
        }).then((result) => {
            if (result.isConfirmed) {
                e.target.submit();
            }
        });

    });
</script>