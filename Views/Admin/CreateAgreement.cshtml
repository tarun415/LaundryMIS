@model LaudaryMis.ViewModels.AgreementVM

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <!-- Header -->
        <div class="card-header d-flex justify-content-between align-items-center text-white"
             style="background: linear-gradient(135deg, #4f46e5, #1e3a8a);">

            <h4 class="mb-0">
                <i class="fa fa-file-contract me-2"></i>
                @(Model.Id > 0 ? "Edit Agreement" : "Create Agreement")
            </h4>

            <a asp-action="Agreements" asp-controller="Admin"
               class="btn btn-light rounded-pill px-3">
                ← Back
            </a>
        </div>

        <div class="card-body p-4">

            <form asp-action="CreateAgreement" method="post" enctype="multipart/form-data">

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <!-- Provider -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Provider</label>
                        <select asp-for="ProviderId" class="form-select shadow-sm">
                            <option value="">-- Select Provider --</option>
                            @foreach (var p in Model.Providers)
                            {
                                <option value="@p.ProviderId">@p.ProviderName</option>
                            }
                        </select>
                    </div>

                    <!-- Hospital -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Hospital</label>
                        <select asp-for="HospitalId" class="form-select shadow-sm">
                            <option value="">-- Select Hospital --</option>
                            @foreach (var h in Model.Hospitals)
                            {
                                <option value="@h.HospitalId">@h.HospitalName</option>
                            }
                        </select>
                    </div>

                    <!-- Bed Count -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Bed Count</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-bed"></i></span>
                            <input asp-for="BedCount" class="form-control" placeholder="Total beds" />
                        </div>
                    </div>

                    <!-- Rate -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Rate Per Bed</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input asp-for="RatePerBed" class="form-control" placeholder="Rate per bed" />
                        </div>
                    </div>

                    <!-- Start Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control shadow-sm" />
                    </div>

                    <!-- End Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control shadow-sm" />
                    </div>

                    <!-- File Upload -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Agreement File</label>

                        <div class="border rounded-3 p-3 bg-light">

                            <input type="file" name="AgreementFile" class="form-control mb-2" />

                            <!-- Existing file (Edit mode) -->
                            @if (!string.IsNullOrEmpty(Model.FilePath))
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-file text-primary"></i>

                                    <a href="@Model.FilePath" target="_blank">
                                        View Existing File
                                    </a>
                                </div>
                            }

                            <small class="text-muted">
                                Upload PDF, DOC, or image file
                            </small>
                        </div>
                    </div>

                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end mt-4">

                    <button type="reset" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                        Reset
                    </button>

                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm">
                        <i class="fa fa-save me-1"></i>
                        Save Agreement
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<!-- Font Awesome (if not already added in layout) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />