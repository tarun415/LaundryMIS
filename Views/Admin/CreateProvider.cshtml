@model LaudaryMis.ViewModels.ProvidersVM

<div class="main-container mt-2">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">
                    @(Model == null  || Model.ProviderId == 0 ? "➕ Add Provider" : "✏️ Edit Provider")
                </h4>

                <a href="/Admin/Providers" class="btn btn-outline-secondary rounded-pill px-3">
                    ← Back to List
                </a>
            </div>

            <!-- Form -->
            <form asp-action="CreateProvider" asp-controller="Admin" method="post">
                <input type="hidden" asp-for="ProviderId" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Provider Name<span class="text-danger">*</span></label>
                        <input asp-for="ProviderName" class="form-control" placeholder="Enter provider name" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Rate<span class="text-danger">*</span></label>
                        <input asp-for="RatePerBed" class="form-control" placeholder="Enter provider rate" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" maxlength="10" class="form-control" placeholder="Enter phone number" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter address"></textarea>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Status</label>
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" />
                        <label class="form-check-label">
                            @(Model != null && Model.ProviderId > 0
                                                        ? (Model.IsActive ? "Active" : "Inactive")
                                                        : "Active")
                        </label>
                    </div>
                </div>


                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="/Admin/Providers" class="btn btn-light border rounded-pill px-4">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        @(Model == null  || Model.ProviderId == 0 ? "💾 Save" : "✏️ Update")
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
                 //  Restrict Phone (only digits + max 10)
        $('#Phone').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
        });
        });
    </script>
    <script>
        $("form").submit(function (e) {

            let name = $("#ProviderName").val();
            let rate = $("#RatePerBed").val();
            let phone = $("#Phone").val();
            let email = $("#Email").val();

            // ❌ Provider Name validation
            if (!name || name.trim() === "") {
                e.preventDefault();
                Swal.fire("Validation Error", "Provider Name is required", "warning");
                return false;
            }

            // ❌ Rate validation
            if (!rate || rate <= 0) {
                e.preventDefault();
                Swal.fire("Validation Error", "Enter valid Rate", "warning");
                return false;
            }

            // ❌ Phone validation
            // if (!phone || phone.length < 10) {
            //     e.preventDefault();
            //     Swal.fire("Validation Error", "Enter valid Phone number", "warning");
            //     return false;
            // }

            // // ❌ Email validation (basic)
            // if (!email || !email.includes("@@")) {
            //     e.preventDefault();
            //     Swal.fire("Validation Error", "Enter valid Email", "warning");
            //     return false;
            // }

         

        });
    </script>
}