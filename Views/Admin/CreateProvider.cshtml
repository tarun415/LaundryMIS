@model LaudaryMis.ViewModels.ProvidersVM

@{
    var isEdit = Model != null && Model.ProviderId > 0;
    ViewBag.Title = isEdit ? "Edit Provider" : "Add Provider";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck-fast"></i></div>
    <div class="ph-text">
        <h1>@(isEdit ? "Edit Provider" : "Add Provider")</h1>
        <p class="ph-sub">@(isEdit ? "Update the laundry provider's details" : "Register a new laundry service provider")</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/Providers" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-circle-info text-teal"></i>
        <span class="card-title">Provider Details</span>
    </div>

    <div class="card-body">

        <form id="providerForm" asp-action="CreateProvider" asp-controller="Admin" method="post" novalidate>
            <input type="hidden" asp-for="ProviderId" />

            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <label class="form-label" for="ProviderName">Provider Name <span class="text-danger">*</span></label>
                    <input asp-for="ProviderName" class="form-control" placeholder="Enter provider name" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="RatePerBed">Rate Per Bed <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input asp-for="RatePerBed" class="form-control" inputmode="decimal" placeholder="0.00" />
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="Email">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="Password">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" placeholder="Enter login password" />
                </div>

                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" />
                        <label class="form-check-label" asp-for="IsActive">
                            Active — the provider can sign in and accept pickups
                        </label>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-3 border-top">
                <a href="/Admin/Providers" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid @(isEdit ? "fa-pen" : "fa-floppy-disk")"></i>
                    @(isEdit ? "Update Provider" : "Save Provider")
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {

            $('#providerForm').on('submit', function (e) {

                var name = $('#ProviderName').val();
                var rate = $('#RatePerBed').val();
                var email = $('#Email').val();

                if (!name || name.trim() === '') {
                    e.preventDefault();
                    LMIS.alert('Missing information', 'Provider Name is required.', 'warning');
                    return;
                }

                if (!rate || Number(rate) <= 0) {
                    e.preventDefault();
                    LMIS.alert('Invalid rate', 'Enter a rate greater than zero.', 'warning');
                    return;
                }

                if (!email || !/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {
                    e.preventDefault();
                    LMIS.alert('Invalid email', 'Enter a valid email address.', 'warning');
                    return;
                }
            });

        });
    </script>
}
