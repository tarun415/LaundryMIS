@model IEnumerable<LaudaryMis.ViewModels.ProvidersVM>

@{
    ViewBag.Title = "Provider List";
    var total = Model?.Count() ?? 0;
    var active = Model?.Count(p => p.IsActive) ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-truck-fast"></i></div>
    <div class="ph-text">
        <h1>Provider Management</h1>
        <p class="ph-sub">@total registered &middot; @active active</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/CreateProvider" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Provider
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="providerTable" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th data-priority="1">Provider Name</th>
                        <th data-priority="3" class="text-end">Rate / Bed</th>
                        <th data-priority="2">Status</th>
                        <th data-priority="1" class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.ProviderName</td>
                            <td class="text-end">@p.RatePerBed</td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge badge-ok"><i class="fa-solid fa-circle-check"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-group justify-content-end">
                                    <a href="/Admin/EditProvider/@p.ProviderId"
                                       class="btn btn-sm btn-icon btn-outline-primary"
                                       data-bs-toggle="tooltip" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-outline-danger"
                                            data-bs-toggle="tooltip" title="Delete"
                                            onclick="deleteProvider(@p.ProviderId, this)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#providerTable', { exportTitle: 'Providers' });
        });

        function deleteProvider(id, btn) {
            LMIS.confirm({
                title: 'Delete this provider?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Admin/DeleteProvider', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#providerTable', btn);
                        LMIS.toast('Provider deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                }).fail(function () {
                    LMIS.alert('Delete failed', 'Could not reach the server.', 'error');
                });
            });
        }
    </script>
}
