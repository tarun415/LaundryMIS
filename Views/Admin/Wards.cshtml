@model IEnumerable<LaudaryMis.ViewModels.WardVM>

@{
    ViewBag.Title = "Ward List";
    var total = Model?.Count() ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-bed"></i></div>
    <div class="ph-text">
        <h1>Ward Management</h1>
        <p class="ph-sub">@total ward@(total == 1 ? "" : "s") configured</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/CreateWard" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Ward
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="wardTable" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th data-priority="1">Ward Name</th>
                        <th data-priority="1" class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var w in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@w.WardName</td>
                            <td class="text-end">
                                <div class="action-group justify-content-end">
                                    <a href="/Admin/EditWard/@w.WardId"
                                       class="btn btn-sm btn-icon btn-outline-primary"
                                       data-bs-toggle="tooltip" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-outline-danger"
                                            data-bs-toggle="tooltip" title="Delete"
                                            onclick="deleteWard(@w.WardId, this)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#wardTable', { exportTitle: 'Wards' });
        });

        function deleteWard(id, btn) {
            LMIS.confirm({
                title: 'Delete this ward?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Admin/DeleteWard', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#wardTable', btn);
                        LMIS.toast('Ward deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                }).fail(function () {
                    LMIS.alert('Delete failed', 'Could not reach the server.', 'error');
                });
            });
        }
    </script>
}
