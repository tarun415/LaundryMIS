@model IEnumerable<LaudaryMis.ViewModels.AgreementVM>

@{
    ViewBag.Title = "Agreement List";
    var total = Model?.Count() ?? 0;
    var expiring = Model?.Count(a => a.EndDate != null
                                     && a.EndDate >= DateTime.Now
                                     && (a.EndDate - DateTime.Now)?.TotalDays <= 30) ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-signature"></i></div>
    <div class="ph-text">
        <h1>Agreement Management</h1>
        <p class="ph-sub">
            @total agreement@(total == 1 ? "" : "s")
            @if (expiring > 0)
            {
                <span class="text-warning fw-bold">&middot; @expiring expiring within 30 days</span>
            }
        </p>
    </div>
    <div class="ph-actions">
        <a asp-action="CreateAgreement" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Create Agreement
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="agreementTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="1">Provider</th>
                        <th data-priority="2">Hospital</th>
                        <th data-priority="6" class="text-end">Beds</th>
                        <th data-priority="5" class="text-end">Rate</th>
                        <th data-priority="7">Start</th>
                        <th data-priority="4">End</th>
                        <th data-priority="3">Status</th>
                        <th data-priority="8">File</th>
                        <th data-priority="1" class="text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProviderName</td>
                            <td>@item.HospitalName</td>
                            <td class="text-end">@item.BedCount</td>
                            <td class="text-end nowrap">₹ @item.RatePerBed</td>
                            <td class="nowrap">@item.StartDate?.ToString("dd-MM-yyyy")</td>
                            <td class="nowrap">@item.EndDate?.ToString("dd-MM-yyyy")</td>

                            <td>
                                @if (item.EndDate == null)
                                {
                                    <span class="badge badge-navy">No Expiry</span>
                                }
                                else if (item.EndDate < DateTime.Now)
                                {
                                    <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Expired</span>
                                }
                                else if ((item.EndDate - DateTime.Now)?.TotalDays <= 30)
                                {
                                    <span class="badge badge-warn"><i class="fa-solid fa-triangle-exclamation"></i> Expiring</span>
                                }
                                else
                                {
                                    <span class="badge badge-ok"><i class="fa-solid fa-circle-check"></i> Active</span>
                                }
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(item.FilePath))
                                {
                                    <a href="@item.FilePath" target="_blank" rel="noopener"
                                       class="btn btn-sm btn-icon btn-outline-primary"
                                       data-bs-toggle="tooltip" title="View document">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>

                            <td class="text-end">
                                <div class="action-group justify-content-end">
                                    <a asp-action="EditAgreement" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-icon btn-outline-primary"
                                       data-bs-toggle="tooltip" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-icon btn-outline-danger"
                                            data-bs-toggle="tooltip" title="Delete"
                                            onclick="deleteAgreement(@item.Id, this)">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#agreementTable', {
                exportTitle: 'Agreements',
                order: [[5, 'asc']]
            });
        });

        function deleteAgreement(id, btn) {
            LMIS.confirm({
                title: 'Delete this agreement?',
                text: 'This action cannot be undone.',
                confirmText: 'Yes, delete'
            }).then(function (ok) {
                if (!ok) return;

                $.post('/Admin/DeleteAgreement', { id: id }, function (res) {
                    if (res.success) {
                        LMIS.removeRowOf('#agreementTable', btn);
                        LMIS.toast('Agreement deleted');
                    } else {
                        LMIS.alert('Delete failed', res.message || 'Please try again.', 'error');
                    }
                }).fail(function () {
                    LMIS.alert('Delete failed', 'Could not reach the server.', 'error');
                });
            });
        }
    </script>
}
