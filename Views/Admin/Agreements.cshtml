@model IEnumerable<LaudaryMis.ViewModels.AgreementVM>

@{
    ViewBag.Title = "Agreement List";
}

<!-- ✅ Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<!-- ✅ DataTables -->
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />

<!-- ✅ Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<!-- ✅ jQuery -->
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<!-- ✅ Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- ✅ DataTables -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<!-- ✅ Buttons -->
<script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
<script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

<style>
    .btn-primary {
        background: linear-gradient(135deg, #3b82f6, #1e40af);
        border: none;
    }

    .dt-buttons {
        display: flex;
        gap: 6px;
    }

        .dt-buttons .btn {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            color: #fff;
        }

    .buttons-copy {
        background: #6c757d !important;
    }

    .buttons-excel {
        background: #198754 !important;
    }

    .buttons-pdf {
        background: #dc3545 !important;
    }

    .buttons-print {
        background: #0d6efd !important;
    }

    .dataTables_filter input {
        border-radius: 20px;
        padding: 6px 12px;
    }
</style>

<div class="container mt-4">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <div class="d-flex justify-content-between mb-3">
                <h4>📄 Agreement Management</h4>

                <a asp-action="CreateAgreement" class="btn btn-primary rounded-pill px-4">
                    + Create Agreement
                </a>
            </div>

            <div class="table-responsive">
                <table id="agreementTable" class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Provider</th>
                            <th>Hospital</th>
                            <th>Bed</th>
                            <th>Rate</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Status</th>
                            <th>File</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.ProviderName</td>
                                <td>@item.HospitalName</td>
                                <td>@item.BedCount</td>
                                <td>₹ @item.RatePerBed</td>
                                <td>@item.StartDate?.ToString("dd-MM-yyyy")</td>
                                <td>@item.EndDate?.ToString("dd-MM-yyyy")</td>

                                <!--  Status (Expiry based) -->
                                <td>
                                    @{
                                        if (item.EndDate == null)
                                        {
                                            <span class="badge bg-secondary">No Expiry</span>
                                            ;
                                        }
                                        else if (item.EndDate < DateTime.Now)
                                        {
                                            <span class="badge bg-danger">Expired</span>
                                            ;
                                        }
                                        else if ((item.EndDate - DateTime.Now)?.TotalDays <= 30)
                                        {
                                            <span class="badge bg-warning text-dark">Expiring</span>
                                            ;
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Active</span>
                                            ;
                                        }
                                    }
                                </td>

                                <!-- File -->
                                <td>
                                    @if (!string.IsNullOrEmpty(item.FilePath))
                                    {
                                        <a href="@item.FilePath" target="_blank"
                                           class="btn btn-sm btn-info rounded-pill">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                    }
                                </td>

                                <!-- Actions -->
                                <td>
                                    <a asp-action="EditAgreement" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning rounded-pill">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <button class="btn btn-sm btn-danger rounded-pill"
                                            onclick="deleteAgreement(@item.Id, this)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>

<!-- 🔥 DataTable Script -->
<script>
    $(document).ready(function () {
        $('#agreementTable').DataTable({
            pageLength: 10,
            responsive: true,

            dom:
                "<'row mb-2'<'col-md-4'l><'col-md-8 d-flex justify-content-end gap-2'Bf>>" +
                "<'row'<'col-12'tr>>" +
                "<'row mt-2'<'col-md-5'i><'col-md-7 text-end'p>>",

            buttons: [
                { extend: 'copy', className: 'btn buttons-copy', text: '<i class="fa fa-copy"></i>' },
                { extend: 'excel', className: 'btn buttons-excel', text: '<i class="fa fa-file-excel"></i>' },
                { extend: 'pdf', className: 'btn buttons-pdf', text: '<i class="fa fa-file-pdf"></i>' },
                { extend: 'print', className: 'btn buttons-print', text: '<i class="fa fa-print"></i>' }
            ],

            language: {
                search: "",
                searchPlaceholder: "🔍 Search Agreements..."
            }
        });
    });

    function deleteAgreement(id, btn) {
        if (confirm("Are you sure you want to delete this agreement?")) {
            $.post('/Admin/DeleteAgreement', { id: id }, function (res) {
                if (res.success) {
                    $(btn).closest('tr').fadeOut();
                } else {
                    alert(res.message);
                }
            });
        }
    }
</script>