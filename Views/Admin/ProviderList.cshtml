@model IEnumerable<LaudaryMis.ViewModels.HospitalVM>

@{
    ViewBag.Title = "Hospital List";
    var total = Model?.Count() ?? 0;
    var active = Model?.Count(h => h.IsActive) ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hospital"></i></div>
    <div class="ph-text">
        <h1>Hospital Management</h1>
        <p class="ph-sub">@total registered &middot; @active active</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/CreateHospital" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> Add Hospital
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="hospitalTable" class="table table-hover align-middle w-100">
                <thead>
                    <tr>
                        <th data-priority="1">Hospital Name</th>
                        <th data-priority="3">City</th>
                        <th data-priority="4">Phone</th>
                        <th data-priority="2">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@h.HospitalName</td>
                            <td>@h.City</td>
                            <td class="nowrap">@h.Phone</td>
                            <td>
                                @if (h.IsActive)
                                {
                                    <span class="badge badge-ok"><i class="fa-solid fa-circle-check"></i> Active</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#hospitalTable', { exportTitle: 'Hospitals' });
        });
    </script>
}
