@model LaudaryMis.ViewModels.HospitalVM

@{
    var isEdit = Model != null && Model.HospitalId > 0;
    ViewBag.Title = isEdit ? "Edit Hospital" : "Add Hospital";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hospital"></i></div>
    <div class="ph-text">
        <h1>@(isEdit ? "Edit Hospital" : "Add Hospital")</h1>
        <p class="ph-sub">@(isEdit ? "Update the facility's registration details" : "Register a new facility on the network")</p>
    </div>
    <div class="ph-actions">
        <a href="/Admin/Hospitals" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="fa-solid fa-circle-info text-teal"></i>
        <span class="card-title">Hospital Details</span>
    </div>

    <div class="card-body">

        <form id="hospitalForm" asp-action="CreateHospital" asp-controller="Admin" method="post">
            <input type="hidden" asp-for="HospitalId" />
          
            <div class="row g-3">

                <div class="col-12 col-md-6">
                    <label class="form-label" for="HospitalName">Hospital Name <span class="text-danger">*</span></label>
                    <input asp-for="HospitalName" class="form-control" placeholder="Enter hospital name" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="DistrictId">District <span class="text-danger">*</span></label>
                    <select asp-for="DistrictId" id="DistrictId" class="form-select">
                        <option value="">Select District</option>
                    </select>
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="ContactPerson">Contact Person <span class="text-danger">*</span></label>
                    <input asp-for="ContactPerson" class="form-control" placeholder="Enter contact person" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="Phone">Phone <span class="text-danger">*</span></label>
                    <input asp-for="Phone" class="form-control" maxlength="10" inputmode="numeric" placeholder="10-digit mobile number" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="Email">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Enter email address" />
                </div>

                <div class="col-12 col-md-6">
                    <label class="form-label" for="Password">Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" type="password"  placeholder="Enter login password" />
                </div>

                <div class="col-12">
                    <label class="form-label" for="Address">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter full address"></textarea>
                </div>

                <div class="col-12">
                    <label class="form-label">Status</label>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" />
                        <label class="form-check-label" asp-for="IsActive">
                            Active — the hospital can sign in and raise pickups
                        </label>
                    </div>
                </div>

            </div>

            <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-3 border-top">
                <a href="/Admin/Hospitals" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid @(isEdit ? "fa-pen" : "fa-floppy-disk")"></i>
                    @(isEdit ? "Update Hospital" : "Save Hospital")
                </button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {

                // Show server-side ModelState errors using LMIS alert
        var serverError = '@Html.Raw(
                    string.Join(" | ",
                            ViewData.ModelState.Values
                                    .SelectMany(v => v.Errors)
                                    .Select(e => e.ErrorMessage)
                                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    )
            )';

    if (serverError) {
        LMIS.alert(
            'Unable to save',
            serverError,
            'warning'
        );
    }


            // Phone: digits only, capped at 10
            $('#Phone').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
            });

            // Populate districts, preserving the current selection on edit
            var selectedDistrictId = '@Model?.DistrictId';

            $.get('/Admin/GetDistricts', { stateId: 34 }, function (data) {
                var $ddl = $('#DistrictId');
                $ddl.html('<option value="">Select District</option>');

                $.each(data, function (i, item) {
                    var selected = item.districtId == selectedDistrictId ? 'selected' : '';
                    $ddl.append('<option value="' + item.districtId + '" ' + selected + '>' + item.districtName + '</option>');
                });
            });

            $('#hospitalForm').on('submit', function (e) {

                var checks = [
                    [$('#HospitalName').val(), 'Hospital Name is required'],
                    [$('#DistrictId').val(), 'Please select a District'],
                    [$('#ContactPerson').val(), 'Contact Person is required'],
                    [$('#Phone').val(), 'Phone is required'],
                    [$('#Email').val(), 'Email is required'],
                    [$('#Password').val(), 'Password is required']
                ];

                for (var i = 0; i < checks.length; i++) {
                    if (!checks[i][0]) {
                        e.preventDefault();
                        LMIS.alert('Missing information', checks[i][1], 'warning');
                        return;
                    }
                }

                if (!/^[0-9]{10}$/.test($('#Phone').val())) {
                    e.preventDefault();
                    LMIS.alert('Invalid phone', 'Enter a valid 10 digit phone number.', 'warning');
                    return;
                }

                // if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test($('#Email').val())) {
                //     e.preventDefault();
                //     LMIS.alert('Invalid email', 'Enter a valid email address.', 'warning');
                //     return;
                // }

                               var email = $.trim($('#Email').val());

        if (email === '') {
            e.preventDefault();

            LMIS.alert(
                'Missing information',
                'Email is required.',
                'warning'
            );

            $('#Email').focus();
            return false;
        }

        // Browser's built-in email validation
        if (!$('#Email')[0].checkValidity()) {
            e.preventDefault();

            LMIS.alert(
                'Invalid email',
                'Please enter a valid email address.',
                'warning'
            );

            $('#Email').focus();
            return false;
        }
                var emailPattern = /^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

        if (!emailPattern.test(email)) {
            e.preventDefault();

            LMIS.alert(
                'Invalid email',
                'Please enter a valid email address.',
                'warning'
            );

            $('#Email').focus();
            return false;
        }




            });

        });
    </script>
}
