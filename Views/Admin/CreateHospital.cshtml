@model LaudaryMis.ViewModels.HospitalVM

<div class="main-container mt-2">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                @(Model == null || Model.HospitalId == 0 ? "➕ Add Hospital" : "✏️ Edit Hospital")

                <a href="/Admin/Hospitals" class="btn btn-outline-secondary rounded-pill px-3">
                    ← Back to List
                </a>
            </div>

            <!-- Form -->
            <form id="hospitalForm" asp-action="CreateHospital" asp-controller="Admin" method="post">
                <input type="hidden" asp-for="HospitalId" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hospital Name<span class="text-danger">*</span></label>
                        <input asp-for="HospitalName" class="form-control" placeholder="Enter hospital name" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">District<span class="text-danger">*</span></label>
                        <select asp-for="DistrictId" id="DistrictId" class="form-control">
                            <option value="">--Select District--</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Contact Person<span class="text-danger">*</span></label>
                        <input asp-for="ContactPerson" class="form-control" placeholder="Enter contact person" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Phone<span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" maxlength="10"  placeholder="Enter phone number" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Email<span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter email" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Password<span class="text-danger">*</span></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter Password" />
                    </div>

                    <div class="col-md-12 mb-3">
                        <label class="form-label">Address</label>
                        <textarea asp-for="Address" class="form-control" rows="2" placeholder="Enter address"></textarea>
                    </div>
                    <div class="col-md-12 mb-3">
                        <label class="form-label">Status<span class="text-danger">*</span></label>
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked="checked" />
                        <label class="form-check-label">
                            @(Model != null && Model.HospitalId > 0
                                                        ? (Model.IsActive ? "Active" : "Inactive")
                                                        : "Active")
                        </label>
                    </div>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-3">
                    <a href="/Admin/Hospitals" class="btn btn-light border rounded-pill px-4">
                        Cancel
                    </a>


                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        @(Model == null || Model.HospitalId == 0 ? "💾 Save" : "✏️ Update")
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
                 //  Restrict Phone (only digits + max 10)
        $('#Phone').on('input', function () {
            this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);
        });
        });
    </script>
    <script>
        $(function () {
            
            console.log("JS Loaded");

            // Load districts
                 $(function () {

            console.log("JS Loaded");

            var selectedDistrictId = '@Model?.DistrictId';

            $.get('/Admin/GetDistricts', { stateId: 34 }, function (data) {

                $('#DistrictId').html('<option value="">--Select District--</option>');

                $.each(data, function (i, item) {

                    var selected = item.districtId == selectedDistrictId ? 'selected' : '';

                    $('#DistrictId').append(
                        `<option value="${item.districtId}" ${selected}>
                            ${item.districtName}
                        </option>`
                    );
                });
            });

        });

            // FORM VALIDATION
            $('#hospitalForm').submit(function (e) {

                let hospitalName = $('#HospitalName').val();
                let district = $('#DistrictId').val();
                let contact = $('#ContactPerson').val();
                let phone = $('#Phone').val();
                let email = $('#Email').val();
                let password = $('#Password').val();

                if (!hospitalName) {
                    e.preventDefault();
                    Swal.fire("Error", "Hospital Name is required", "error");
                    return;
                }

                if (!district) {
                    e.preventDefault();
                    Swal.fire("Error", "Select District", "error");
                    return;
                }

                if (!contact) {
                    e.preventDefault();
                    Swal.fire("Error", "Contact Person is required", "error");
                    return;
                }

                if (!phone) {
                    e.preventDefault();
                    Swal.fire("Error", "Phone is required", "error");
                    return;
                }

                if (!/^[0-9]{10}$/.test(phone)) {
                    e.preventDefault();
                    Swal.fire("Error", "Enter valid 10 digit phone", "error");
                    return;
                }

                if (!email) {
                    e.preventDefault();
                    Swal.fire("Error", "Email is required", "error");
                    return;
                }

                if (!password) {
                    e.preventDefault();
                    Swal.fire("Error", "Password is required", "error");
                    return;
                }
                       
                // ✅ If all valid → DO NOTHING → form will submit automatically
            });

        });
    </script>
}

