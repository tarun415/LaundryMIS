@model LaudaryMis.Models.InvoiceMaster

@{
    ViewData["Title"] = "Invoice Details";

    var monthName = Model.InvoiceMonth is >= 1 and <= 12
        ? System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.InvoiceMonth)
        : "—";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
    <div class="ph-text">
        <h1>Invoice Details</h1>
        <p class="ph-sub">@Model.InvoiceNo &middot; @Model.InvoiceDate.ToString("dd MMM yyyy")</p>
    </div>
    <div class="ph-actions">
        <a asp-action="PreviewInvoice" asp-route-invoiceId="@Model.InvoiceId"
           class="btn btn-outline-primary" target="_blank" rel="noopener">
            <i class="fa-solid fa-eye"></i> Preview
        </a>
        <a asp-action="DownloadInvoice" asp-route-invoiceId="@Model.InvoiceId"
           class="btn btn-outline-success">
            <i class="fa-solid fa-download"></i> Download
        </a>
        <a asp-action="InvoiceList" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-3">

    <!-- INVOICE INFORMATION -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-file-invoice text-teal"></i>
                <span class="card-title">Invoice Information</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Invoice No</span>
                    <span class="info-v">@Model.InvoiceNo</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Invoice Date</span>
                    <span class="info-v">@Model.InvoiceDate.ToString("dd MMM yyyy")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Billing Month</span>
                    <span class="info-v">@monthName @Model.InvoiceYear</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Status</span>
                    <span class="info-v">
                        @if (Model.Status == "Generated")
                        {
                            <span class="badge badge-info">@Model.Status</span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge badge-ok">@Model.Status</span>
                        }
                        else
                        {
                            <span class="badge badge-navy">@Model.Status</span>
                        }
                    </span>
                </div>

                <div class="info-row">
                    <span class="info-k">Remarks</span>
                    <span class="info-v">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "—" : Model.Remarks)</span>
                </div>

            </div>
        </div>
    </div>

    <!-- CONTRACT -->
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-file-signature text-teal"></i>
                <span class="card-title">Contract</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Hospital</span>
                    <span class="info-v">@Model.HospitalName</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Provider</span>
                    <span class="info-v">@Model.ProviderName</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Sanctioned Beds</span>
                    <span class="info-v">@Model.SanctionedBeds</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Bed Occupancy</span>
                    <span class="info-v">@Model.BedOccupancy</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Rate per Bed</span>
                    <span class="info-v">₹ @Model.RatePerBed.ToString("N2")</span>
                </div>

            </div>
        </div>
    </div>

    <!-- PAYMENT CALCULATION -->
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-calculator text-teal"></i>
                <span class="card-title">Payment Calculation</span>
            </div>
            <div class="card-body">

                <div class="info-row">
                    <span class="info-k">Monthly Bill</span>
                    <span class="info-v">₹ @Model.MonthlyBill.ToString("N2")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Average Score</span>
                    <span class="info-v">@Model.AverageScore.ToString("0.##")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Payment Percentage</span>
                    <span class="info-v">@Model.PaymentPercentage.ToString("0.##") %</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Gross Payable</span>
                    <span class="info-v">₹ @Model.GrossPayable.ToString("N2")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">GST (@Model.GSTPercentage.ToString("0.##") %)</span>
                    <span class="info-v">₹ @Model.GSTAmount.ToString("N2")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Invoice Amount</span>
                    <span class="info-v fw-bold">₹ @Model.InvoiceAmount.ToString("N2")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">TDS (@Model.TDSPercentage.ToString("0.##") %)</span>
                    <span class="info-v">₹ @Model.TDSAmount.ToString("N2")</span>
                </div>

                <div class="info-row">
                    <span class="info-k">Net Payable</span>
                    <span class="info-v fw-bold">₹ @Model.NetPayable.ToString("N2")</span>
                </div>

            </div>
        </div>
    </div>

</div>
