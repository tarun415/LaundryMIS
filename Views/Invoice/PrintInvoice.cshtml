                @Model.GrossPayable.ToString("N2")

            </td>

        </tr>

        <tr>

            <td>

                GST

            </td>

            <td class="textRight">

                @Model.GSTAmount.ToString("N2")

            </td>

        </tr>

        <tr>

            <td>

                TDS

            </td>

            <td class="textRight">

                @Model.TDSAmount.ToString("N2")

            </td>

        </tr>

        <tr class="highlight">

            <td>

                Net Payable

            </td>

            <td class="textRight">

                ₹ @Model.NetPayable.ToString("N2")

            </td>

        </tr>

    </tbody>

</table>

<div class="printArea">

  @*   <button class="btn"
            onclick="window.print();">

        🖨 Print Invoice

    </button>
 *@
