@model LaudaryMis.ViewModels.GenerateInvoiceVM

@{
    ViewData["Title"] = "Generate Invoice";
}

<div class="container-fluid mt-3">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h4 class="mb-0">

                <i class="fa fa-file-invoice"></i>

                Generate Invoice

            </h4>

        </div>

        <div class="card-body">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    @TempData["Success"]

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">

                    @TempData["Error"]

                </div>
            }

            <form asp-action="GenerateInvoice"
                  method="post">

                <input asp-for="PaymentId" type="hidden" />

                <input asp-for="AgreementId" type="hidden" />

                <input asp-for="ProviderId" type="hidden" />

                <input asp-for="HospitalId" type="hidden" />

                <div class="row">

                    <div class="col-md-4">

                        <label class="font-weight-bold">

                            Payment No

                        </label>

                        <input asp-for="PaymentNo"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-4">

                        <label class="font-weight-bold">

                            Hospital

                        </label>

                        <input asp-for="HospitalName"
                               class="form-control"
                               readonly />

                    </div>

                    <div class="col-md-4">

                        <label class="font-weight-bold">

                            Provider

                        </label>

                        <input asp-for="ProviderName"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <br />

                <div class="row">

                    <div class="col-md-3">

                        <label class="font-weight-bold">

                            Invoice Date

                        </label>

                        <input asp-for="InvoiceDate"
                               type="date"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label class="font-weight-bold">

                            Month

                        </label>

                        <input class="form-control"
                               value="@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(Model.MonthNo)"
                               readonly />

                    </div>

                    <div class="col-md-3">

                        <label class="font-weight-bold">

                            Year

                        </label>

                        <input asp-for="YearNo"
                               class="form-control"
                               readonly />

                    </div>

                </div>

                <br />

                <div class="card border-info">

                    <div class="card-header bg-info text-white">

                        <strong>

                            Payment Summary

                        </strong>

                    </div>

                    <div class="card-body">
                        <div class="row">

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Sanctioned Beds
                                </label>

                                <input asp-for="SanctionedBeds"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    No of Operational Bed
                                </label>

                                <input asp-for="BedOccupancy"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Rate Per Bed
                                </label>

                                <input asp-for="RatePerBed"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Monthly Bill
                                </label>

                                <input asp-for="MonthlyBill"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                        <br />

                        <div class="row">

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Average Score
                                </label>

                                <input asp-for="AverageScore"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Payment %
                                </label>

                                <input asp-for="PaymentPercentage"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Gross Payable
                                </label>

                                <input asp-for="GrossPayable"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    GST %
                                </label>

                                <input asp-for="GSTPercentage"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                        <br />

                        <div class="row">

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    GST Amount
                                </label>

                                <input asp-for="GSTAmount"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    Invoice Amount
                                </label>

                                <input asp-for="InvoiceAmount"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    TDS %
                                </label>

                                <input asp-for="TDSPercentage"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="col-md-3">

                                <label class="font-weight-bold">
                                    TDS Amount
                                </label>

                                <input asp-for="TDSAmount"
                                       class="form-control"
                                       readonly />

                            </div>

                        </div>

                        <br />

                        <div class="row">

                            <div class="col-md-4">

                                <label class="font-weight-bold text-success">
                                    Net Payable
                                </label>

                                <input asp-for="NetPayable"
                                       class="form-control font-weight-bold text-success"
                                       readonly />

                            </div>

                        </div>

                    </div>

                </div>

                <br />
                <div class="row">

                    <div class="col-md-12">

                        <label class="font-weight-bold">

                            Remarks

                        </label>

                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Enter Remarks (Optional)"></textarea>

                    </div>

                </div>

                <br />

                <div class="text-center">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="fa fa-file-invoice"></i>

                        Generate Invoice

                    </button>

                    <a asp-action="InvoiceList"
                       class="btn btn-secondary">

                        <i class="fa fa-arrow-left"></i>

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}