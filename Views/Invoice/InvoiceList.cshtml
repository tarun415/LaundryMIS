@model List<LaudaryMis.Models.InvoiceMaster>

@{
    ViewData["Title"] = "Invoice List";
    var total = Model?.Count ?? 0;
    var netTotal = Model?.Sum(i => i.NetPayable) ?? 0m;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-invoice"></i></div>
    <div class="ph-text">
        <h1>Invoice Management</h1>
        <p class="ph-sub">@total invoice@(total == 1 ? "" : "s") &middot; ₹@netTotal.ToString("N2") net payable</p>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- FILTER -->
<form asp-action="InvoiceList" method="get">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="monthNo">Month</label>
            <select class="form-select" name="monthNo" id="monthNo">
                <option value="">All</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label class="form-label" for="yearNo">Year</label>
            <input type="number" class="form-control" name="yearNo" id="yearNo" value="@DateTime.Now.Year" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
        </div>

    </div>
</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblInvoice" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="1">Invoice No</th>
                        <th data-priority="3">Hospital</th>
                        <th data-priority="4">Provider</th>
                        <th data-priority="5">Month</th>
                        <th data-priority="6" class="text-end">Invoice Amount</th>
                        <th data-priority="2" class="text-end">Net Payable</th>
                        <th data-priority="1" class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-teal">@item.InvoiceNo</td>
                                <td>@item.HospitalName</td>
                                <td>@item.ProviderName</td>
                                <td class="nowrap">
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.InvoiceMonth) @item.InvoiceYear
                                </td>
                                <td class="text-end nowrap">₹ @item.InvoiceAmount.ToString("N2")</td>
                                <td class="text-end nowrap fw-bold">₹ @item.NetPayable.ToString("N2")</td>

                                <td class="text-end">
                                    <div class="action-group justify-content-end">
                                        <a asp-action="PreviewInvoice" asp-route-invoiceId="@item.InvoiceId"
                                           class="btn btn-sm btn-icon btn-outline-primary"
                                           target="_blank" rel="noopener"
                                           data-bs-toggle="tooltip" title="Preview">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                        <a asp-action="DownloadInvoice" asp-route-invoiceId="@item.InvoiceId"
                                           class="btn btn-sm btn-icon btn-outline-success"
                                           data-bs-toggle="tooltip" title="Download">
                                            <i class="fa-solid fa-download"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#tblInvoice', {
                exportTitle: 'Invoice List',
                order: [[0, 'desc']],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });
        });
    </script>
}
