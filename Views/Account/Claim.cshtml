@model LaudaryMis.ViewModels.ClaimVM
@{
    Layout = null;
    var isHospital = Model.RoleId != 3;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f3a" />
    <title>Register &middot; Laundry MIS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <style>
        .login-box { max-width: 520px; }

        /* Desktop fit (fallback when scripts are off; the script below sets the exact value) */
        @@media (min-width: 1200px) and (max-width: 1799px) { .login-box { zoom: .8; } }
        .reg-row { display: grid; grid-template-columns: 1fr; gap: 0 14px; }
        @@media (min-width: 520px) { .reg-row { grid-template-columns: 1fr 1fr; } }

        .field-err { color: var(--danger, #b42318); font-size: .74rem; margin-top: 4px; }
        .field-err:empty { display: none; }

        .code-input { font-family: Consolas, 'Courier New', monospace; font-size: 1.15rem; letter-spacing: .12em; text-transform: uppercase; text-align: center; }

        .pwd-wrap { position: relative; }
        .pwd-wrap input { padding-right: 42px; }
        .pwd-toggle {
            position: absolute; top: 50%; right: 6px; transform: translateY(-50%);
            width: 32px; height: 32px; display: grid; place-items: center;
            border: none; background: transparent; color: var(--ink-3);
            cursor: pointer; border-radius: var(--r-sm);
        }
        .pwd-toggle:hover { color: var(--teal-700); background: var(--surface-3); }

        .login-switch { margin-top: 14px; text-align: center; font-size: .85rem; color: var(--ink-3); }
        .login-switch a { font-weight: 600; color: var(--teal-700); text-decoration: none; }
        .login-switch a:hover { text-decoration: underline; }

        .claim-note {
            margin: 0 0 14px; padding: 10px 12px; font-size: .8rem; line-height: 1.45;
            color: var(--ink-2, #344054); background: var(--surface-2, #f6f7f9);
            border: 1px solid var(--line); border-radius: var(--r-sm);
        }

        .login-foot {
            margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--line);
            text-align: center; font-size: .7rem; color: var(--ink-3); letter-spacing: .04em;
        }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-box">

            <div class="login-logo">
                <div class="emblem"><i class="fa-solid fa-key"></i></div>
                <h1>Register &middot; Laundry MIS</h1>
                <p>Create your account with an activation code</p>
            </div>

            <form method="post" asp-action="Claim" id="claimForm" novalidate>

                @Html.AntiForgeryToken()

                @{
                    var formErrors = ViewData.ModelState[string.Empty]?.Errors;
                }
                @if (formErrors?.Count > 0)
                {
                    <div class="login-err">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                        @string.Join(" ", formErrors.Select(e => e.ErrorMessage))
                    </div>
                }

                <div class="claim-note">
                    Your hospital / firm is already on the tender list. DGMH should have sent you an <strong>activation code</strong>.
                    Choose your name, enter the code and set your email / password.
                </div>

                <!-- ROLE SELECTOR -->
                <div class="role-selector" role="radiogroup" aria-label="Register as" style="grid-template-columns: 1fr 1fr;">

                    <div class="role-btn @(isHospital ? "selected" : "")" role="radio" tabindex="0"
                         aria-checked="@(isHospital ? "true" : "false")" onclick="setRole(2, this)">
                        <div class="role-icon"><i class="fa-solid fa-hospital"></i></div>
                        <div class="role-label">Hospital</div>
                        <div class="role-sub">Facility</div>
                    </div>

                    <div class="role-btn @(!isHospital ? "selected" : "")" role="radio" tabindex="0"
                         aria-checked="@(!isHospital ? "true" : "false")" onclick="setRole(3, this)">
                        <div class="role-icon"><i class="fa-solid fa-truck-fast"></i></div>
                        <div class="role-label">Vendor</div>
                        <div class="role-sub">Laundry Provider</div>
                    </div>

                </div>

                <input type="hidden" asp-for="RoleId" id="RoleId" />

                <!-- HOSPITAL -->
                <div id="hospitalFields" style="@(isHospital ? "" : "display:none;")">
                    <div class="reg-row">
                        <div class="login-field">
                            <label asp-for="DistrictId">District</label>
                            <select asp-for="DistrictId" id="DistrictId" data-selected="@Model.DistrictId" onchange="loadHospitals(this.value)">
                                <option value="">Select District</option>
                            </select>
                        </div>

                        <div class="login-field">
                            <label asp-for="HospitalId">Hospital</label>
                            <select asp-for="HospitalId" id="HospitalId" data-selected="@Model.HospitalId">
                                <option value="">Select Hospital</option>
                            </select>
                        </div>
                    </div>
                    <div class="login-hint" style="margin-top:-6px;margin-bottom:10px;">Only hospitals that do not have an account yet are listed.</div>
                </div>

                <!-- VENDOR -->
                <div id="providerFields" style="@(!isHospital ? "" : "display:none;")">
                    <div class="login-field">
                        <label asp-for="ProviderId">Firm / Vendor</label>
                        <select asp-for="ProviderId" id="ProviderId" data-selected="@Model.ProviderId">
                            <option value="">Select Firm</option>
                        </select>
                    </div>
                </div>

                <div class="login-field">
                    <label asp-for="Code">Activation code</label>
                    <input asp-for="Code" class="code-input" maxlength="14" autocomplete="off" spellcheck="false" placeholder="XXXXX-XXXXX" />
                    <span class="field-err d-block" asp-validation-for="Code"></span>
                </div>

                <div class="reg-row">
                    <div class="login-field">
                        <label asp-for="Phone">Mobile number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" maxlength="10" inputmode="numeric" autocomplete="tel" placeholder="10 digit mobile"
                               required pattern="[6-9][0-9]{9}" title="Enter a 10-digit mobile number starting with 6, 7, 8 or 9" />
                        <span class="field-err d-block" asp-validation-for="Phone"></span>
                    </div>

                    <div class="login-field">
                        <label asp-for="Email">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" maxlength="200" autocomplete="email" placeholder="name@example.com" required />
                        <span class="field-err d-block" asp-validation-for="Email"></span>
                    </div>
                </div>
                <div class="login-hint" style="margin-top:-6px;margin-bottom:10px;">Both are required. Use your own mobile number and email; you can sign in with either one. Made-up numbers or emails are not accepted.</div>

                <div class="reg-row">
                    <div class="login-field">
                        <label asp-for="Password">Password</label>
                        <div class="pwd-wrap">
                            <input asp-for="Password" type="password" autocomplete="new-password" placeholder="At least 8 characters" />
                            <button type="button" class="pwd-toggle" data-target="Password" aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="field-err d-block" asp-validation-for="Password"></span>
                    </div>

                    <div class="login-field">
                        <label asp-for="ConfirmPassword">Confirm password</label>
                        <div class="pwd-wrap">
                            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Same password" />
                            <button type="button" class="pwd-toggle" data-target="ConfirmPassword" aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>
                        <span class="field-err d-block" asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
                <div class="login-hint" style="margin-top:-6px;">Password must contain at least one letter and one number.</div>

                <button type="submit" class="btn-login mt-3" id="claimBtn">
                    <i class="fa-solid fa-user-check me-1"></i> Register &amp; Sign In
                </button>

            </form>

            <div class="login-switch">
                Already have an account? <a asp-action="Login">Sign in</a>
            </div>
            <div class="login-switch" style="margin-top:6px;">
                Hospital / firm not on the list? <a asp-action="Register" asp-route-roleId="@Model.RoleId">Create a new account</a>
            </div>

            <div class="login-foot">
                Directorate General of Medical &amp; Health Services, Uttar Pradesh
            </div>

        </div>

    </div>

    <script>
        // Desktop: scale the card to the screen width, as on the home and sign-in pages
        // (80% on a 1536px laptop, 100% at 1920px). Phones and tablets keep full size.
        (function () {
            var box = document.querySelector(".login-box");
            function fit() {
                var w = window.innerWidth;
                box.style.zoom = w >= 1200 ? String(Math.min(1, Math.max(0.8, w / 1920))) : "";
            }
            fit();
            window.addEventListener("resize", fit);
        })();
    </script>

    <script>
        let districtLoaded = false;
        let providerLoaded = false;

        // Names come from the database, so options are built with text (never innerHTML).
        function fill(ddl, items, selected, emptyText) {
            ddl.length = 1;
            items.forEach(i => {
                const opt = new Option(i.name, i.id);
                if (String(i.id) === String(selected)) opt.selected = true;
                ddl.add(opt);
            });
            if (items.length === 0 && emptyText) ddl.options[0].text = emptyText;
        }

        function setRole(roleId, el) {
            document.getElementById("RoleId").value = roleId;

            document.querySelectorAll(".role-btn").forEach(r => {
                r.classList.remove("selected");
                r.setAttribute("aria-checked", "false");
            });
            el.classList.add("selected");
            el.setAttribute("aria-checked", "true");

            document.getElementById("hospitalFields").style.display = roleId == 2 ? "" : "none";
            document.getElementById("providerFields").style.display = roleId == 3 ? "" : "none";

            if (roleId == 2) loadDistricts(); else loadProviders();
        }

        document.querySelectorAll(".role-btn").forEach(btn => {
            btn.addEventListener("keydown", e => {
                if (e.key === "Enter" || e.key === " ") { e.preventDefault(); btn.click(); }
            });
        });

        function loadDistricts() {
            if (districtLoaded) return;
            const ddl = document.getElementById("DistrictId");
            const selected = ddl.dataset.selected;

            fetch('/User/GetDistricts')
                .then(res => res.json())
                .then(data => {
                    fill(ddl, data.map(d => ({ id: d.districtId, name: d.districtName })), selected);
                    districtLoaded = true;
                    if (selected) loadHospitals(selected);
                });
        }

        function loadHospitals(districtId) {
            const ddl = document.getElementById("HospitalId");
            ddl.length = 1;
            if (!districtId) return;
            const selected = ddl.dataset.selected;

            fetch('/Account/UnclaimedHospitals?districtId=' + encodeURIComponent(districtId))
                .then(res => res.json())
                .then(data => fill(ddl, data.map(h => ({ id: h.id, name: h.name })), selected,
                                   'No hospital left in this district'));
        }

        function loadProviders() {
            if (providerLoaded) return;
            const ddl = document.getElementById("ProviderId");

            fetch('/Account/UnclaimedProviders')
                .then(res => res.json())
                .then(data => {
                    fill(ddl, data.map(p => ({ id: p.id, name: p.name })), ddl.dataset.selected,
                         'No firm left');
                    providerLoaded = true;
                });
        }

        if (document.getElementById("RoleId").value == "2") loadDistricts(); else loadProviders();

        document.querySelectorAll(".pwd-toggle").forEach(btn => {
            btn.addEventListener("click", function () {
                const input = document.getElementById(this.dataset.target);
                const icon = this.querySelector("i");
                const show = input.type === "password";
                input.type = show ? "text" : "password";
                icon.className = show ? "fa-solid fa-eye-slash" : "fa-solid fa-eye";
                this.setAttribute("aria-label", show ? "Hide password" : "Show password");
            });
        });

        document.getElementById("claimForm").addEventListener("submit", function () {
            const btn = document.getElementById("claimBtn");
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Registering…';
        });
    </script>

</body>
</html>
