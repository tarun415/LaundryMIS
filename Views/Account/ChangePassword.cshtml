@model LaudaryMis.ViewModels.ChangePasswordVM

@{
    ViewBag.Title = "Change Password";
    var forced = User.FindFirst("MustChangePassword")?.Value == "1";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-key"></i></div>
    <div class="ph-text">
        <h1>Change Password</h1>
        <p class="ph-sub">@(forced ? "The password the admin gave you is temporary. Choose your own to continue." : "Choose a new password for your account.")</p>
    </div>
</div>

<partial name="_Alerts" />

<div class="row">
    <div class="col-12 col-md-8 col-xl-5">
        <div class="card">
            <div class="card-body">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@Html.ValidationSummary(false, "", new { @class = "d-inline" })</span>
                    </div>
                }

                <form method="post" asp-action="ChangePassword" asp-controller="Account" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" for="CurrentPassword">Current password</label>
                        <input type="password" class="form-control" id="CurrentPassword" name="CurrentPassword" autocomplete="current-password" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="NewPassword">New password</label>
                        <input type="password" class="form-control" id="NewPassword" name="NewPassword" autocomplete="new-password" minlength="8" required />
                        <div class="form-text">At least 8 characters.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="ConfirmPassword">Confirm new password</label>
                        <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword" autocomplete="new-password" minlength="8" required />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> Change password
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>
