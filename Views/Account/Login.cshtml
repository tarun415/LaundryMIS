@model LaudaryMis.ViewModels.LoginVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Laundry MIS Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 20% 30%, #1c3b57, #0f2a44);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .container {
            width: 380px;
            background: #f9fbfc;
            padding: 30px;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.25);
            text-align: center;
        }

        .role-container {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .role {
            flex: 1;
            padding: 12px;
            border-radius: 12px;
            border: 2px solid #dce3e8;
            cursor: pointer;
        }

            .role.active {
                border-color: #0c6b75;
                background: #e6f3f5;
            }

        .label {
            text-align: left;
            font-size: 12px;
            font-weight: 600;
            margin-top: 10px;
        }

        input, select {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #ccd6dd;
            margin-top: 5px;
        }

        button {
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            border-radius: 12px;
            background: #0c6b75;
            color: white;
            border: none;
        }

        .error {
            color: red;
            font-size: 12px;
        }
    </style>
</head>

<body>

    <div class="container">

        <h2>Laundry MIS</h2>

        <form method="post" asp-action="Login">

            @Html.AntiForgeryToken()

            <!-- ROLE -->
            <div class="role-container">
                <div class="role active" onclick="setRole(1,this)">Admin</div>
                <div class="role" onclick="setRole(2,this)">Hospital</div>
                <div class="role" onclick="setRole(3,this)">Provider</div>
            </div>

            <input type="hidden" id="RoleId" name="RoleId" value="1" />

            <!-- ADMIN -->
            <div id="adminFields">
                <div class="label">Username</div>
                <input type="text" name="Username" />
            </div>

            <!-- HOSPITAL -->
            <div id="hospitalFields" style="display:none;">
                <div class="label">District</div>
                <select id="DistrictId" name="DistrictId" onchange="loadHospitals(this.value)">
                    <option value="">Select District</option>
                </select>

                <div class="label">Hospital</div>
                <select id="HospitalId" name="HospitalId">
                    <option value="">Select Hospital</option>
                </select>
            </div>

            <!-- PROVIDER -->
            <div id="providerFields" style="display:none;">
                <div class="label">Provider</div>
                <select id="ProviderId" name="ProviderId">
                    <option value="">Select Provider</option>
                </select>
            </div>

            <!-- COMMON PASSWORD -->
            <div class="label">Password</div>
            <input type="password" name="Password" required />

            <button type="submit">Login</button>

            <div class="error">
                @Html.ValidationSummary()
            </div>

        </form>
    </div>

    <script>

        let districtLoaded = false;
        let providerLoaded = false;

        function setRole(roleId, el) {

            document.getElementById("RoleId").value = roleId;

            document.querySelectorAll(".role").forEach(r => r.classList.remove("active"));
            el.classList.add("active");

            // clear values
            document.querySelectorAll("input, select").forEach(e => {
                if (e.type !== "hidden") e.value = "";
            });

            // hide all
            document.getElementById("adminFields").style.display = "none";
            document.getElementById("hospitalFields").style.display = "none";
            document.getElementById("providerFields").style.display = "none";

            if (roleId == 1) {
                document.getElementById("adminFields").style.display = "block";
            }
            else if (roleId == 2) {
                document.getElementById("hospitalFields").style.display = "block";
                loadDistricts();
            }
            else if (roleId == 3) {
                document.getElementById("providerFields").style.display = "block";
                loadProviders();
            }
        }

        function loadDistricts() {
            if (districtLoaded) return;

            fetch('/User/GetDistricts')
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("DistrictId");
                    ddl.innerHTML = '<option value="">Select District</option>';

                    data.forEach(d => {
                        ddl.innerHTML += `<option value="${d.districtId}">${d.districtName}</option>`;
                    });

                    districtLoaded = true;
                });
        }

        function loadHospitals(districtId) {
            fetch('/User/GetHospitalsByDistrict?districtId=' + districtId)
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("HospitalId");
                    ddl.innerHTML = '<option value="">Select Hospital</option>';

                    data.forEach(h => {
                        ddl.innerHTML += `<option value="${h.hospitalId}">${h.hospitalName}</option>`;
                    });
                });
        }

        function loadProviders() {
            if (providerLoaded) return;

            fetch('/User/GetProviders')
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("ProviderId");
                    ddl.innerHTML = '<option value="">Select Provider</option>';

                    data.forEach(p => {
                        ddl.innerHTML += `<option value="${p.providerId}">${p.providerName}</option>`;
                    });

                    providerLoaded = true;
                });
        }

    </script>

</body>
</html>