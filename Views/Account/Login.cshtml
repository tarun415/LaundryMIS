@model LaudaryMis.ViewModels.LoginVM
@{
    Layout = null;

    // Set when a signed-in tab was sent here: "switched" (another account
    // signed in on this browser) or "expired".
    var reason = Context.Request.Query["reason"].ToString();

    // After a failed sign-in the page comes back with the role the person had chosen
    var startRole = Model?.RoleId is 2 or 3 ? Model.RoleId : 1;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f3a" />
    <title>Sign In &middot; Laundry MIS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <style>
        /* Password field affordance — only needed on this page */
        .pwd-wrap { position: relative; }
        .pwd-wrap input { padding-right: 42px; }
        .pwd-toggle {
            position: absolute;
            top: 50%;
            right: 6px;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border: none;
            background: transparent;
            color: var(--ink-3);
            cursor: pointer;
            border-radius: var(--r-sm);
        }
        .pwd-toggle:hover { color: var(--teal-700); background: var(--surface-3); }

        .login-switch { margin-top: 14px; text-align: center; font-size: .85rem; color: var(--ink-3); }
        .login-switch a { font-weight: 600; color: var(--teal-700); text-decoration: none; }
        .login-switch a:hover { text-decoration: underline; }

        .login-foot {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            text-align: center;
            font-size: .7rem;
            color: var(--ink-3);
            letter-spacing: .04em;
        }

        /* Desktop fit (fallback when scripts are off; the script below sets the exact value) */
        @@media (min-width: 1200px) and (max-width: 1799px) { .login-box { zoom: .8; } }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-box">

            <div class="login-logo">
                <div class="emblem"><i class="fa-solid fa-shirt"></i></div>
                <h1>DGMH UP &middot; Laundry MIS</h1>
                <p>Mechanized Laundry Services</p>
            </div>

            <form method="post" asp-action="Login" id="loginForm" novalidate>

                @Html.AntiForgeryToken()

                @* Explains why a tab that was signed in suddenly landed here. *@
                @if (reason == "switched")
                {
                    <div class="login-err">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                        You were signed out because another account signed in on this browser.
                    </div>
                }
                else if (reason == "expired")
                {
                    <div class="login-err">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                        Your session has ended. Please sign in again.
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-err">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                        @Html.ValidationSummary(false, "", new { @class = "d-inline" })
                    </div>
                }

                <!-- ROLE SELECTOR -->
                <div class="role-selector" role="radiogroup" aria-label="Sign in as">

                    <div class="role-btn @(startRole == 1 ? "selected" : "")" role="radio" tabindex="0" aria-checked="@(startRole == 1 ? "true" : "false")" onclick="setRole(1, this)">
                        <div class="role-icon"><i class="fa-solid fa-user-shield"></i></div>
                        <div class="role-label">Admin</div>
                        <div class="role-sub">Directorate</div>
                    </div>

                    <div class="role-btn @(startRole == 2 ? "selected" : "")" role="radio" tabindex="0" aria-checked="@(startRole == 2 ? "true" : "false")" onclick="setRole(2, this)">
                        <div class="role-icon"><i class="fa-solid fa-hospital"></i></div>
                        <div class="role-label">Hospital</div>
                        <div class="role-sub">Facility</div>
                    </div>

                    <div class="role-btn @(startRole == 3 ? "selected" : "")" role="radio" tabindex="0" aria-checked="@(startRole == 3 ? "true" : "false")" onclick="setRole(3, this)">
                        <div class="role-icon"><i class="fa-solid fa-truck-fast"></i></div>
                        <div class="role-label">Provider</div>
                        <div class="role-sub">Vendor</div>
                    </div>

                </div>

                <input type="hidden" id="RoleId" name="RoleId" value="@startRole" />

                <!-- ADMIN -->
                <div id="adminFields" style="@(startRole == 1 ? "" : "display:none;")">
                    <div class="login-field">
                        <label for="Username">Username</label>
                        <input type="text" id="Username" name="Username" autocomplete="username" placeholder="Enter your username" />
                    </div>
                </div>

                <!-- HOSPITAL / PROVIDER -->
                <div id="contactFields" style="@(startRole == 1 ? "display:none;" : "")">
                    <div class="login-field">
                        <label for="LoginId">Mobile number or Email</label>
                        <input type="text" id="LoginId" name="LoginId" value="@Model?.LoginId" maxlength="200"
                               autocomplete="username" placeholder="10-digit mobile number or email" />
                        <div class="login-hint">Use the mobile number or the email you registered with. Either one works.</div>
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="login-field">
                    <label for="Password">Password</label>
                    <div class="pwd-wrap">
                        <input type="password" id="Password" name="Password" autocomplete="current-password" placeholder="Enter your password" required />
                        <button type="button" class="pwd-toggle" id="pwdToggle" aria-label="Show password">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="loginBtn">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                </button>

            </form>

            <div class="login-switch">
                First time here? <a asp-action="Claim">Register with an activation code</a>
            </div>

            <div class="login-foot">
                Directorate General of Medical &amp; Health Services, Uttar Pradesh
            </div>

        </div>

    </div>

    <script>

        // Desktop: scale the sign-in card to the screen width, as on the home page
        // (80% on a 1536px laptop, 100% at 1920px). Phones and tablets keep full size.
        (function () {
            var box = document.querySelector(".login-box");
            function fit() {
                var w = window.innerWidth;
                box.style.zoom = w >= 1200 ? String(Math.min(1, Math.max(0.8, w / 1920))) : "";
            }
            fit();
            window.addEventListener("resize", fit);
        })();

        function setRole(roleId, el) {

            document.getElementById("RoleId").value = roleId;

            document.querySelectorAll(".role-btn").forEach(r => {
                r.classList.remove("selected");
                r.setAttribute("aria-checked", "false");
            });
            el.classList.add("selected");
            el.setAttribute("aria-checked", "true");

            // Clear previously entered credentials when switching role
            document.querySelectorAll("#loginForm input, #loginForm select").forEach(e => {
                if (e.type !== "hidden") e.value = "";
            });

            // Admin signs in with a username; hospital and vendor with a mobile number or an email
            document.getElementById("adminFields").style.display = roleId == 1 ? "block" : "none";
            document.getElementById("contactFields").style.display = roleId == 1 ? "none" : "block";
        }

        // Keyboard support for the role radios
        document.querySelectorAll(".role-btn").forEach(btn => {
            btn.addEventListener("keydown", e => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    btn.click();
                }
            });
        });

        // Password visibility
        document.getElementById("pwdToggle").addEventListener("click", function () {
            const input = document.getElementById("Password");
            const icon = this.querySelector("i");
            const show = input.type === "password";
            input.type = show ? "text" : "password";
            icon.className = show ? "fa-solid fa-eye-slash" : "fa-solid fa-eye";
            this.setAttribute("aria-label", show ? "Hide password" : "Show password");
        });

        // Prevent double submission
        document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("loginBtn");
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Signing in…';
        });

    </script>

</body>
</html>
