@model LaudaryMis.ViewModels.LoginVM
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f3a" />
    <title>Sign In &middot; Laundry MIS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    <style>
        /* Password field affordance — only needed on this page */
        .pwd-wrap { position: relative; }
        .pwd-wrap input { padding-right: 42px; }
        .pwd-toggle {
            position: absolute;
            top: 50%;
            right: 6px;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            display: grid;
            place-items: center;
            border: none;
            background: transparent;
            color: var(--ink-3);
            cursor: pointer;
            border-radius: var(--r-sm);
        }
        .pwd-toggle:hover { color: var(--teal-700); background: var(--surface-3); }

        .login-foot {
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid var(--line);
            text-align: center;
            font-size: .7rem;
            color: var(--ink-3);
            letter-spacing: .04em;
        }
    </style>
</head>

<body>

    <div class="login-page">

        <div class="login-box">

            <div class="login-logo">
                <div class="emblem"><i class="fa-solid fa-shirt"></i></div>
                <h1>DGMH UP &middot; Laundry MIS</h1>
                <p>Mechanized Laundry Services</p>
            </div>

            <form method="post" asp-action="Login" id="loginForm" novalidate>

                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="login-err">
                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                        @Html.ValidationSummary(false, "", new { @class = "d-inline" })
                    </div>
                }

                <!-- ROLE SELECTOR -->
                <div class="role-selector" role="radiogroup" aria-label="Sign in as">

                    <div class="role-btn selected" role="radio" tabindex="0" aria-checked="true" onclick="setRole(1, this)">
                        <div class="role-icon"><i class="fa-solid fa-user-shield"></i></div>
                        <div class="role-label">Admin</div>
                        <div class="role-sub">Directorate</div>
                    </div>

                    <div class="role-btn" role="radio" tabindex="0" aria-checked="false" onclick="setRole(2, this)">
                        <div class="role-icon"><i class="fa-solid fa-hospital"></i></div>
                        <div class="role-label">Hospital</div>
                        <div class="role-sub">Facility</div>
                    </div>

                    <div class="role-btn" role="radio" tabindex="0" aria-checked="false" onclick="setRole(3, this)">
                        <div class="role-icon"><i class="fa-solid fa-truck-fast"></i></div>
                        <div class="role-label">Provider</div>
                        <div class="role-sub">Vendor</div>
                    </div>

                </div>

                <input type="hidden" id="RoleId" name="RoleId" value="1" />

                <!-- ADMIN -->
                <div id="adminFields">
                    <div class="login-field">
                        <label for="Username">Username</label>
                        <input type="text" id="Username" name="Username" autocomplete="username" placeholder="Enter your username" />
                    </div>
                </div>

                <!-- HOSPITAL -->
                <div id="hospitalFields" style="display:none;">
                    <div class="login-field">
                        <label for="DistrictId">District</label>
                        <select id="DistrictId" name="DistrictId" onchange="loadHospitals(this.value)">
                            <option value="">Select District</option>
                        </select>
                    </div>

                    <div class="login-field">
                        <label for="HospitalId">Hospital</label>
                        <select id="HospitalId" name="HospitalId">
                            <option value="">Select Hospital</option>
                        </select>
                        <div class="login-hint">Choose a district first to load its hospitals.</div>
                    </div>
                </div>

                <!-- PROVIDER -->
                <div id="providerFields" style="display:none;">
                    <div class="login-field">
                        <label for="ProviderId">Provider</label>
                        <select id="ProviderId" name="ProviderId">
                            <option value="">Select Provider</option>
                        </select>
                    </div>
                </div>

                <!-- PASSWORD -->
                <div class="login-field">
                    <label for="Password">Password</label>
                    <div class="pwd-wrap">
                        <input type="password" id="Password" name="Password" autocomplete="current-password" placeholder="Enter your password" required />
                        <button type="button" class="pwd-toggle" id="pwdToggle" aria-label="Show password">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="loginBtn">
                    <i class="fa-solid fa-right-to-bracket me-1"></i> Sign In
                </button>

            </form>

            <div class="login-foot">
                Directorate General of Medical &amp; Health Services, Uttar Pradesh
            </div>

        </div>

    </div>

    <script>

        let districtLoaded = false;
        let providerLoaded = false;

        function setRole(roleId, el) {

            document.getElementById("RoleId").value = roleId;

            document.querySelectorAll(".role-btn").forEach(r => {
                r.classList.remove("selected");
                r.setAttribute("aria-checked", "false");
            });
            el.classList.add("selected");
            el.setAttribute("aria-checked", "true");

            // Clear previously entered credentials when switching role
            document.querySelectorAll("#loginForm input, #loginForm select").forEach(e => {
                if (e.type !== "hidden") e.value = "";
            });

            document.getElementById("adminFields").style.display = "none";
            document.getElementById("hospitalFields").style.display = "none";
            document.getElementById("providerFields").style.display = "none";

            if (roleId == 1) {
                document.getElementById("adminFields").style.display = "block";
            }
            else if (roleId == 2) {
                document.getElementById("hospitalFields").style.display = "block";
                loadDistricts();
            }
            else if (roleId == 3) {
                document.getElementById("providerFields").style.display = "block";
                loadProviders();
            }
        }

        // Keyboard support for the role radios
        document.querySelectorAll(".role-btn").forEach(btn => {
            btn.addEventListener("keydown", e => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    btn.click();
                }
            });
        });

        function loadDistricts() {
            if (districtLoaded) return;

            fetch('/User/GetDistricts')
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("DistrictId");
                    ddl.innerHTML = '<option value="">Select District</option>';

                    data.forEach(d => {
                        ddl.innerHTML += `<option value="${d.districtId}">${d.districtName}</option>`;
                    });

                    districtLoaded = true;
                });
        }

        function loadHospitals(districtId) {
            fetch('/User/GetHospitalsByDistrict?districtId=' + districtId)
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("HospitalId");
                    ddl.innerHTML = '<option value="">Select Hospital</option>';

                    data.forEach(h => {
                        ddl.innerHTML += `<option value="${h.hospitalId}">${h.hospitalName}</option>`;
                    });
                });
        }

        function loadProviders() {
            if (providerLoaded) return;

            fetch('/User/GetProviders')
                .then(res => res.json())
                .then(data => {
                    let ddl = document.getElementById("ProviderId");
                    ddl.innerHTML = '<option value="">Select Provider</option>';

                    data.forEach(p => {
                        ddl.innerHTML += `<option value="${p.providerId}">${p.providerName}</option>`;
                    });

                    providerLoaded = true;
                });
        }

        // Password visibility
        document.getElementById("pwdToggle").addEventListener("click", function () {
            const input = document.getElementById("Password");
            const icon = this.querySelector("i");
            const show = input.type === "password";
            input.type = show ? "text" : "password";
            icon.className = show ? "fa-solid fa-eye-slash" : "fa-solid fa-eye";
            this.setAttribute("aria-label", show ? "Hide password" : "Show password");
        });

        // Prevent double submission
        document.getElementById("loginForm").addEventListener("submit", function () {
            const btn = document.getElementById("loginBtn");
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin me-1"></i> Signing in…';
        });

    </script>

</body>
</html>
