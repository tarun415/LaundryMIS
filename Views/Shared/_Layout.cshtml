@{
    var roleClaim = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var displayName = User.Identity?.Name ?? "";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var currentSlot = LaudaryMis.Infrastructure.TabSlots.CurrentSlot(Context);
    var initials = string.Join("", displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));
    if (string.IsNullOrEmpty(initials)) { initials = "U"; }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1f3a" />
    <title>@ViewData["Title"] - Laundry MIS</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600&display=swap" rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- DataTables + Responsive + Buttons -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />

    <!-- Application theme (must come last so it wins) -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ================= TOP BAR ================= -->
    <header class="app-topbar">

        <button class="topbar-toggle" id="sidebarToggle" type="button" aria-label="Toggle navigation" aria-expanded="false" aria-controls="sidebarNav">
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-identity">
            <div class="topbar-emblem"><i class="fa-solid fa-shirt"></i></div>
            <div class="min-w-0">
                <div class="topbar-brand">DGMH UP <span>Laundry MIS</span></div>
                <div class="topbar-sub">Mechanized Laundry Services &middot; 197 Hospitals</div>
            </div>
        </div>

        <div class="topbar-right">

            <div class="user-pill">
                <div class="user-avatar">@initials</div>
                <div class="user-meta">
                    <div class="user-name">
                        @displayName
                        @if (currentSlot > 0)
                        {
                            @* Slot 0 is the ordinary session; later slots are the
                               extra accounts, so only those need labelling. *@
                            <span class="role-tag" style="display:inline;margin-left:.35rem;">
                                Session @(currentSlot + 1)
                            </span>
                        }
                    </div>
                    <div class="role-tag">@roleClaim</div>
                </div>
            </div>

            <a href="@Url.Action("UseAnotherAccount", "Account")" class="btn-logout"
               title="Sign in as another user in a separate session, keeping this one active">
                <i class="fa-solid fa-user-plus"></i><span>Add account</span>
            </a>

            <a href="~/Account/Logout" class="btn-logout">
                <i class="fa-solid fa-right-from-bracket"></i><span>Logout</span>
            </a>

        </div>

    </header>

    <!-- ================= SHELL ================= -->
    <div class="app-shell">

        <nav class="app-sidebar" id="sidebarNav" aria-label="Main navigation"></nav>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <main class="app-content">
            @RenderBody()
        </main>

    </div>

    <!-- ================= SCRIPTS ================= -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Keeps every request inside this tab's sign-in slot.
         Pages call app URLs as "/Hospital/PickupList"; those are root-relative
         and would leave the "/u/{slot}" prefix behind, landing on another
         session. Rewriting them centrally means page scripts stay unchanged. -->
    <script>
        window.APP_BASE = "@Url.Content("~/")";

        window.appUrl = function (url) {
            if (typeof url !== "string") return url;
            if (url.charAt(0) !== "/") return url;          // relative or absolute
            if (url.indexOf("//") === 0) return url;         // protocol-relative
            if (url.indexOf(APP_BASE) === 0) return url;     // already scoped
            return APP_BASE.replace(/\/$/, "") + url;
        };

        (function () {
            if (window.jQuery) {
                jQuery.ajaxPrefilter(function (options) {
                    options.url = window.appUrl(options.url);
                });
            }

            var nativeFetch = window.fetch;
            if (nativeFetch) {
                window.fetch = function (input, init) {
                    if (typeof input === "string") input = window.appUrl(input);
                    return nativeFetch.call(this, input, init);
                };
            }
        })();
    </script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables core + Responsive extension (the extension was previously missing,
         which is why `responsive: true` had no effect and wide tables overflowed) -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <!-- DataTables Buttons + export dependencies -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.print.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <!-- Shared helpers: DataTable defaults, toasts, confirm dialogs -->
    <script src="~/js/app.js" asp-append-version="true"></script>

    <!-- ================= NAVIGATION ================= -->
    <script>
        const userRole = "@roleClaim";

        const routes = {
            admin: {
                dashboard:  '@Url.Action("Dashboard", "Admin")',
                Hospitals:  '@Url.Action("Hospitals", "Admin")',
                Agreements: '@Url.Action("Agreements", "Admin")',
                Providers:  '@Url.Action("Providers", "Admin")',
                Wards:      '@Url.Action("Wards", "Admin")'
            },
            hospital: {
                dashboard:             '@Url.Action("Dashboard", "Hospital")',
                WPREntry:              '@Url.Action("WPREntry", "WPR")',
                CreatePickUp:          '@Url.Action("PickupList", "Hospital")',
                DeliverySummary:       '@Url.Action("DeliverySummaryReport", "Report")',
                WeeklyDeliveryReport:  '@Url.Action("WeeklyDeliveryReport", "Report")',
                MonthlyDeliveryReport: '@Url.Action("MonthlyReport", "Report")',
                DeliveryAgingReport:   '@Url.Action("DeliveryAgingReport", "Report")',
                GeneratePayment:       '@Url.Action("GeneratePayment", "Payment")',
                PaymentList:           '@Url.Action("PaymentList", "Payment")',
                WarningLetterList:     '@Url.Action("WarningLetterList", "WarningLetter")'
            },
            provider: {
                dashboard:             '@Url.Action("Dashboard", "Provider")',
                AcceptPickup:          '@Url.Action("AcceptPickup", "Provider")',
                DeliverySummary:       '@Url.Action("DeliverySummaryReport", "Report")',
                WeeklyDeliveryReport:  '@Url.Action("WeeklyDeliveryReport", "Report")',
                MonthlyDeliveryReport: '@Url.Action("MonthlyReport", "Report")',
                DeliveryAgingReport:   '@Url.Action("DeliveryAgingReport", "Report")',
                GenerateInvoice:       '@Url.Action("PaymentList", "Payment")',
                InvoiceList:           '@Url.Action("InvoiceList", "Invoice")',
                WarningLetterList:     '@Url.Action("WarningLetterList", "WarningLetter")'
            }
        };

        const MENU_CONFIG = {
            Admin: [
                { section: "Overview" },
                { id: "dashboard",  icon: "fa-chart-pie",       label: "Dashboard",  route: routes.admin.dashboard },
                { section: "Masters" },
                { id: "hospitals",  icon: "fa-hospital",        label: "Hospitals",  route: routes.admin.Hospitals },
                { id: "providers",  icon: "fa-truck-fast",      label: "Providers",  route: routes.admin.Providers },
                { id: "wards",      icon: "fa-bed",             label: "Wards",      route: routes.admin.Wards },
                { id: "agreements", icon: "fa-file-signature",  label: "Agreements", route: routes.admin.Agreements }
            ],
            Hospital: [
                { section: "Overview" },
                { id: "dashboard",    icon: "fa-gauge-high",      label: "Dashboard",     route: routes.hospital.dashboard },
                { section: "Operations" },
                { id: "CreatePickUp", icon: "fa-boxes-packing",   label: "Pickup Linen",  route: routes.hospital.CreatePickUp },
                { id: "WPREntry",     icon: "fa-clipboard-check", label: "WPR Entry",     route: routes.hospital.WPREntry },
                { section: "Reports" },
                { id: "DeliverySummary",       icon: "fa-chart-column",  label: "Delivery Report",  route: routes.hospital.DeliverySummary },
                { id: "WeeklyDeliveryReport",  icon: "fa-calendar-week", label: "Weekly Delivery",  route: routes.hospital.WeeklyDeliveryReport },
                { id: "MonthlyDeliveryReport", icon: "fa-calendar-days", label: "Monthly Delivery", route: routes.hospital.MonthlyDeliveryReport },
                { id: "DeliveryAgingReport",   icon: "fa-hourglass-half",label: "Delivery Aging",   route: routes.hospital.DeliveryAgingReport },
                { section: "Finance" },
                { id: "GeneratePayment", icon: "fa-money-bill-wave", label: "Generate Payment", route: routes.hospital.GeneratePayment },
                { id: "PaymentList",     icon: "fa-credit-card",     label: "Payment List",     route: routes.hospital.PaymentList },
                { section: "Compliance" },
                { id: "WarningLetterList", icon: "fa-triangle-exclamation", label: "Warning Letters", route: routes.hospital.WarningLetterList }
            ],
            Provider: [
                { section: "Overview" },
                { id: "dashboard", icon: "fa-gauge-high", label: "Dashboard", route: routes.provider.dashboard },
                { section: "Operations" },
                { id: "AcceptPickup", icon: "fa-hand-holding-hand", label: "Accept Pickup", route: routes.provider.AcceptPickup },
                { section: "Reports" },
                { id: "DeliverySummary",       icon: "fa-chart-column",   label: "Delivery Report",  route: routes.provider.DeliverySummary },
                { id: "WeeklyDeliveryReport",  icon: "fa-calendar-week",  label: "Weekly Delivery",  route: routes.provider.WeeklyDeliveryReport },
                { id: "MonthlyDeliveryReport", icon: "fa-calendar-days",  label: "Monthly Delivery", route: routes.provider.MonthlyDeliveryReport },
                { id: "DeliveryAgingReport",   icon: "fa-hourglass-half", label: "Delivery Aging",   route: routes.provider.DeliveryAgingReport },
                { section: "Billing" },
                { id: "GenerateInvoice", icon: "fa-file-invoice-dollar", label: "Generate Invoice", route: routes.provider.GenerateInvoice },
                { id: "InvoiceList",     icon: "fa-file-invoice",        label: "Invoice List",     route: routes.provider.InvoiceList },
                { section: "Compliance" },
                { id: "WarningLetterList", icon: "fa-triangle-exclamation", label: "Warning Letters", route: routes.provider.WarningLetterList }
            ]
        };

        (function () {

            function buildSidebar() {
                var nav = document.getElementById("sidebarNav");
                var menu = MENU_CONFIG[userRole];
                if (!nav || !menu) return;

                var currentPath = window.location.pathname.toLowerCase();
                var html = "";
                var matched = null;

                // Longest matching route wins, so /Payment/PaymentList doesn't light up /Payment
                menu.forEach(function (item) {
                    if (item.section || !item.route) return;
                    var routePath = item.route.split('?')[0].toLowerCase();
                    if (routePath.length > 1 && currentPath.indexOf(routePath) === 0) {
                        if (!matched || routePath.length > matched.length) matched = routePath;
                    }
                });

                menu.forEach(function (item) {
                    if (item.section) {
                        html += '<div class="sidebar-section">' + item.section + '</div>';
                        return;
                    }
                    var routePath = (item.route || '').split('?')[0].toLowerCase();
                    var isActive = matched !== null && routePath === matched;
                    html += '<a href="' + item.route + '" class="nav-item' + (isActive ? ' active' : '') + '">'
                          + '<i class="ni fa-solid ' + item.icon + '"></i>'
                          + '<span>' + item.label + '</span>'
                          + '</a>';
                });

                nav.innerHTML = html;
            }

            function setupSidebarToggle() {
                var toggle = document.getElementById("sidebarToggle");
                var nav = document.getElementById("sidebarNav");
                var backdrop = document.getElementById("sidebarBackdrop");
                if (!toggle || !nav || !backdrop) return;

                function close() {
                    nav.classList.remove("open");
                    backdrop.classList.remove("show");
                    toggle.setAttribute("aria-expanded", "false");
                }

                toggle.addEventListener("click", function () {
                    var isOpen = nav.classList.toggle("open");
                    backdrop.classList.toggle("show", isOpen);
                    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });

                backdrop.addEventListener("click", close);
                document.addEventListener("keydown", function (e) { if (e.key === "Escape") close(); });
                window.addEventListener("resize", function () { if (window.innerWidth >= 992) close(); });
            }

            document.addEventListener("DOMContentLoaded", function () {
                buildSidebar();
                setupSidebarToggle();
            });

        })();
    </script>

    @* Tabs on different slots are now independent, so the usual cross-tab
       takeover is gone. This still catches the case that remains: signing in as
       someone else on *this* slot from another tab, and sessions that expired. *@
    <div id="sessionChangedBar"
         data-user-id="@currentUserId"
         data-user-role="@roleClaim"
         hidden
         style="position:fixed;left:0;right:0;bottom:0;z-index:2000;padding:12px 16px;
                background:#8a1c1c;color:#fff;gap:12px;align-items:center;
                justify-content:center;flex-wrap:wrap;font-size:14px;">
        <span id="sessionChangedText"></span>
        <button type="button" onclick="location.reload()"
                style="border:0;border-radius:4px;padding:6px 14px;background:#fff;color:#8a1c1c;
                       font-weight:600;cursor:pointer;">
            Reload page
        </button>
    </div>

    <script>
        (function () {

            var bar = document.getElementById("sessionChangedBar");
            if (!bar) { return; }

            var pageUserId = bar.getAttribute("data-user-id") || "";

            // Anonymous pages (login) have nothing to protect.
            if (pageUserId === "") { return; }

            var notified = false;

            function show(message) {
                if (notified) { return; }
                notified = true;
                document.getElementById("sessionChangedText").textContent = message;
                bar.hidden = false;
                bar.style.display = "flex";
            }

            function checkSession() {
                if (notified || document.hidden) { return; }

                fetch("/Account/WhoAmI", { credentials: "same-origin", cache: "no-store" })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (data) {
                        if (!data) { return; }

                        if (!data.authenticated) {
                            show("Your session has ended. Please sign in again.");
                            return;
                        }

                        if (String(data.id) !== String(pageUserId)) {
                            show("This page is out of date - you are now signed in as "
                                 + (data.name || "another user")
                                 + (data.role ? " (" + data.role + ")" : "")
                                 + " in another tab. Reload before continuing.");
                        }
                    })
                    .catch(function () { /* offline or transient - ignore */ });
            }

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden) { checkSession(); }
            });

            window.addEventListener("focus", checkSession);

        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
