@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">

    <div class="card" style="max-width: 560px; width: 100%;">
        <div class="card-body text-center p-4">

            <div class="ph-icon mx-auto mb-3" style="background: linear-gradient(135deg, var(--danger), #7d1a14);">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <h1 class="mb-2">Something went wrong</h1>
            <p class="text-muted mb-4">
                An error occurred while processing your request. Please try again, or
                contact the system administrator if the problem continues.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-warning d-block text-start">
                    <div class="stat-lbl mb-1">Request ID</div>
                    <code class="d-block text-break">@Model.RequestId</code>
                </div>
            }

            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a href="javascript:history.back()" class="btn btn-light">
                    <i class="fa-solid fa-arrow-left"></i> Go Back
                </a>
                <a href="/" class="btn btn-primary">
                    <i class="fa-solid fa-house"></i> Home
                </a>
            </div>

        </div>
    </div>

</div>
