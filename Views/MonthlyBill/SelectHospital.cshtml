@using LaudaryMis.Models
@{
    ViewData["Title"] = "Naya Bill Banao";
    var hospitals = ViewBag.Hospitals as List<Hospital> ?? new List<Hospital>();
    int currentMonth = (int)ViewBag.CurrentMonth;
    int currentYear = (int)ViewBag.CurrentYear;
}

@section Styles {
    <style>
        .sel-card { max-width: 620px; margin: 0 auto; }

        .month-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .month-btn {
            padding: 9px 4px;
            border: 1px solid var(--line-strong);
            border-radius: var(--r-sm);
            background: var(--surface);
            color: var(--ink-2);
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            transition: border-color .15s, background .15s, color .15s, transform .12s;
        }
        .month-btn:hover { border-color: var(--teal-500); color: var(--teal-700); transform: translateY(-1px); }
        .month-btn.active {
            border-color: var(--teal-600);
            background: var(--teal-600);
            color: #fff;
            box-shadow: 0 3px 10px rgba(14, 124, 123, .28);
        }

        @@media (max-width: 400px) {
            .month-grid { grid-template-columns: repeat(3, 1fr); }
        }
    </style>
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-circle-plus"></i></div>
    <div class="ph-text">
        <h1>Naya Monthly Bill Banao</h1>
        <p class="ph-sub">Hospital aur billing period choose karo</p>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

@if (!hospitals.Any())
{
    <div class="alert alert-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>Aapke account se koi hospital linked nahi hai. Admin se contact karein.</span>
    </div>
}
else
{
    <div class="card sel-card">
        <div class="card-body">

            <!-- Hospital -->
            <div class="mb-4">
                <div class="section-title">Hospital Choose Karo</div>
                <select id="ddlHospital" class="form-select">
                    <option value="">-- Hospital select karo --</option>
                    @foreach (var h in hospitals)
                    {
                        <option value="@h.HospitalId">@h.HospitalName@(h.City != null ? " — " + h.City : "")</option>
                    }
                </select>
            </div>

            <!-- Year -->
            <div class="mb-4">
                <div class="section-title">Year</div>
                <div class="d-flex flex-wrap gap-2">
                    @for (int y = currentYear - 1; y <= currentYear + 1; y++)
                    {
                        <button type="button"
                                class="btn @(y == currentYear ? "btn-primary" : "btn-light") year-btn"
                                data-year="@y">
                            @y
                        </button>
                    }
                </div>
                <input type="hidden" id="selYear" value="@currentYear" />
            </div>

            <!-- Month -->
            <div class="mb-4">
                <div class="section-title">Month Choose Karo</div>
                <div class="month-grid">
                    @{
                        var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                        for (int m = 1; m <= 12; m++)
                        {
                            <button type="button"
                                    class="month-btn @(m == currentMonth ? "active" : "")"
                                    data-month="@m">
                                @months[m - 1]
                            </button>
                        }
                    }
                </div>
                <input type="hidden" id="selMonth" value="@currentMonth" />
            </div>

            <div class="d-grid">
                <button id="btnGo" class="btn btn-primary btn-lg" disabled>
                    <i class="fa-solid fa-file-invoice"></i> Bill Form Kholo
                </button>
            </div>

            <p class="text-muted small text-center mt-3 mb-0">
                <i class="fa-solid fa-circle-info"></i>
                Agar us mahine ka bill pehle se exist karta hai toh wahi edit ho jaayega.
            </p>

        </div>
    </div>
}

@section Scripts {
    <script>

        document.querySelectorAll('.month-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.month-btn').forEach(function (b) { b.classList.remove('active'); });
                this.classList.add('active');
                document.getElementById('selMonth').value = this.dataset.month;
                checkReady();
            });
        });

        document.querySelectorAll('.year-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.year-btn').forEach(function (b) {
                    b.classList.remove('btn-primary');
                    b.classList.add('btn-light');
                });
                this.classList.remove('btn-light');
                this.classList.add('btn-primary');
                document.getElementById('selYear').value = this.dataset.year;
                checkReady();
            });
        });

        var ddl = document.getElementById('ddlHospital');
        if (ddl) ddl.addEventListener('change', checkReady);

        function checkReady() {
            var hosp = document.getElementById('ddlHospital').value;
            document.getElementById('btnGo').disabled = !hosp;
        }

        var btnGo = document.getElementById('btnGo');
        if (btnGo) {
            btnGo.addEventListener('click', function () {
                var hosp = document.getElementById('ddlHospital').value;
                var month = document.getElementById('selMonth').value;
                var year = document.getElementById('selYear').value;
                if (!hosp) return;

                window.location.href = '@Url.Action("Create", "MonthlyBill")'
                    + '?hospitalId=' + hosp
                    + '&month=' + month
                    + '&year=' + year;
            });
        }

    </script>
}
