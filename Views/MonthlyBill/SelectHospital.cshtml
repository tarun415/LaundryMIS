@using LaudaryMis.Models
@{
    ViewData["Title"] = "Naya Bill Banao";
    var hospitals = ViewBag.Hospitals as List<Hospital> ?? new List<Hospital>();
    int currentMonth = (int)ViewBag.CurrentMonth;
    int currentYear = (int)ViewBag.CurrentYear;
}

<style>
    .page-header {
        background: linear-gradient(135deg,#1a3c5e,#2563a8);
        color: white;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 24px;
    }

    .sel-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 10px rgba(0,0,0,.08);
        padding: 28px 30px;
        max-width: 560px;
        margin: 0 auto;
    }

        .sel-card h6 {
            font-weight: 700;
            color: #1a3c5e;
            border-bottom: 2px solid #e8f0fe;
            padding-bottom: 8px;
            margin-bottom: 18px;
        }

    .month-grid {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 8px;
        margin-top: 6px;
    }

    .month-btn {
        border: 2px solid #e2e8f0;
        border-radius: 8px;
        padding: 8px 4px;
        text-align: center;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        background: #fff;
        transition: all .15s;
        color: #374151;
    }

        .month-btn:hover {
            border-color: #2563a8;
            color: #2563a8;
            background: #eff6ff;
        }

        .month-btn.active {
            border-color: #2563a8;
            background: #2563a8;
            color: #fff;
        }
</style>

<div class="page-header">
    <h4 class="mb-1">➕ Naya Monthly Bill Banao</h4>
    <p class="mb-0 opacity-75">Hospital aur billing period choose karo</p>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        ⚠️ @TempData["Error"]
        <button class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!hospitals.Any())
{
    <div class="alert alert-warning text-center">
        ⚠️ Aapke account se koi hospital linked nahi hai. Admin se contact karein.
    </div>
}
else
{
    <div class="sel-card">

        <!-- Hospital -->
        <h6>🏥 Hospital Choose Karo</h6>
        <select id="ddlHospital" class="form-select mb-4">
            <option value="">-- Hospital select karo --</option>
            @foreach (var h in hospitals)
            {
                <option value="@h.HospitalId">@h.HospitalName@(h.City != null ? " — " + h.City : "")</option>
            }
        </select>

        <!-- Year -->
        <h6>📅 Year</h6>
        <div class="d-flex gap-2 mb-4">
            @for (int y = currentYear - 1; y <= currentYear + 1; y++)
            {
                <button type="button"
                        class="btn @(y == currentYear ? "btn-primary" : "btn-outline-secondary") year-btn"
                        data-year="@y">
                    @y
                </button>
            }
        </div>
        <input type="hidden" id="selYear" value="@currentYear" />

        <!-- Month -->
        <h6>🗓️ Month Choose Karo</h6>
        <div class="month-grid mb-4">
            @{
                var months = new[] { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
                for (int m = 1; m <= 12; m++)
                {
                    <button type="button"
                            class="month-btn @(m == currentMonth ? "active" : "")"
                            data-month="@m">
                        @months[m - 1]
                    </button>
                }
            }
        </div>
        <input type="hidden" id="selMonth" value="@currentMonth" />

        <!-- Submit -->
        <div class="d-grid">
            <button id="btnGo" class="btn btn-primary btn-lg" disabled>
                🧾 Bill Form Kholo
            </button>
        </div>

        <p class="text-muted small text-center mt-3">
            Agar us mahine ka bill pehle se exist karta hai toh wahi edit ho jaayega.
        </p>
    </div>
}

@section Scripts {
    <script>
        // Month selection
        document.querySelectorAll('.month-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.month-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('selMonth').value = this.dataset.month;
                checkReady();
            });
        });

        // Year selection
        document.querySelectorAll('.year-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.year-btn').forEach(b => {
                    b.classList.remove('btn-primary');
                    b.classList.add('btn-outline-secondary');
                });
                this.classList.remove('btn-outline-secondary');
                this.classList.add('btn-primary');
                document.getElementById('selYear').value = this.dataset.year;
                checkReady();
            });
        });

        // Hospital dropdown
        document.getElementById('ddlHospital').addEventListener('change', checkReady);

        function checkReady() {
            var hosp  = document.getElementById('ddlHospital').value;
            var month = document.getElementById('selMonth').value;
            var year  = document.getElementById('selYear').value;
            document.getElementById('btnGo').disabled = !hosp;
        }

        document.getElementById('btnGo').addEventListener('click', function () {
            var hosp  = document.getElementById('ddlHospital').value;
            var month = document.getElementById('selMonth').value;
            var year  = document.getElementById('selYear').value;
            if (!hosp) return;
            window.location.href = '@Url.Action("Create", "MonthlyBill")'
                + '?hospitalId=' + hosp
                + '&month='      + month
                + '&year='       + year;
        });
    </script>
}
