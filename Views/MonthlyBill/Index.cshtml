@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>
@{
    ViewData["Title"] = "Monthly Bills";
}

<style>
    .page-header { background:linear-gradient(135deg,#1a3c5e,#2563a8); color:white; border-radius:12px; padding:20px 24px; margin-bottom:20px; display:flex; justify-content:space-between; align-items:center; }
    .stat-card { background:#fff; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.07); padding:14px 18px; text-align:center; }
    .stat-card .num { font-size:2rem; font-weight:800; }
    .stat-card .lbl { font-size:.75rem; text-transform:uppercase; color:#6b7280; }
    .filter-card { background:#fff; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.07); padding:14px 18px; margin-bottom:18px; }
    .table-card { background:#fff; border-radius:10px; box-shadow:0 2px 8px rgba(0,0,0,.07); padding:18px 20px; }
</style>

<div class="page-header">
    <div>
        <h4 class="mb-1">🧾 Monthly Bills</h4>
        <p class="mb-0 opacity-75">Sab hospitals ke bills</p>
    </div>
</div>

@{
    var list = Model.ToList();
    var draft   = list.Count(x => x.Status == "Draft");
    var subm    = list.Count(x => x.Status == "Submitted");
    var appr    = list.Count(x => x.Status == "CMSApproved");
    var rej     = list.Count(x => x.Status == "CMSRejected");
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3"><div class="stat-card"><div class="num text-secondary">@draft</div><div class="lbl">Draft</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="num text-warning">@subm</div><div class="lbl">Pending CMS</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="num text-success">@appr</div><div class="lbl">Approved</div></div></div>
    <div class="col-6 col-md-3"><div class="stat-card"><div class="num text-danger">@rej</div><div class="lbl">Rejected</div></div></div>
</div>

<form method="get" asp-action="Index">
    <div class="filter-card d-flex gap-3 flex-wrap align-items-end">
        <div>
            <label class="form-label small fw-bold mb-1">Status</label>
            <select name="status" class="form-select form-select-sm" style="min-width:140px">
                <option value="">All</option>
                <option value="Draft" selected="@(ViewBag.FilterStatus as string == "Draft")">Draft</option>
                <option value="Submitted" selected="@(ViewBag.FilterStatus as string == "Submitted")">Submitted</option>
                <option value="CMSApproved" selected="@(ViewBag.FilterStatus as string == "CMSApproved")">Approved</option>
                <option value="CMSRejected" selected="@(ViewBag.FilterStatus as string == "CMSRejected")">Rejected</option>
            </select>
        </div>
        <div>
            <button type="submit" class="btn btn-primary btn-sm">🔍 Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </div>
</form>

<div class="table-card">
    <table id="tblBills" class="table table-hover mb-0">
        <thead class="table-light">
            <tr>
                <th>Bill #</th>
                <th>Hospital</th>
                <th>District</th>
                <th>Period</th>
                <th>WPR Score</th>
                <th>Band%</th>
                <th class="text-end">Net Payable</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (!list.Any()) {
                <tr><td colspan="9" class="text-center text-muted py-4">Koi bill nahi mila 📭</td></tr>
            }
            @foreach (var b in list) {
                var sc = b.Status switch { "CMSApproved"=>"success","CMSRejected"=>"danger","Submitted"=>"warning",_=>"secondary" };
                <tr>
                    <td class="text-muted">#@b.BillId</td>
                    <td class="fw-semibold">@b.HospitalName</td>
                    <td>@b.District</td>
                    <td>@b.MonthLabel</td>
                    <td>
                        @b.WPRAvgScore.ToString("N1")
                        @if (b.IsScoreOverridden) { <span class="badge bg-warning ms-1" title="Override">✏️</span> }
                    </td>
                    <td><span class="badge bg-primary">@b.PaymentBandPercent%</span></td>
                    <td class="text-end fw-bold">₹@b.NetPayableAmount.ToString("N0")</td>
                    <td><span class="badge bg-@sc">@b.Status</span></td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@b.BillId" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    $(function() {
        $('#tblBills').DataTable({
            order:[[0,'desc']], pageLength:25,
            language: { search:"Search:", info:"_START_–_END_ of _TOTAL_" }
        });
    });
</script>
}