@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>

@{
    ViewData["Title"] = "Monthly Bills";

    var list = Model.ToList();
    var draft = list.Count(x => x.Status == "Draft");
    var subm  = list.Count(x => x.Status == "Submitted");
    var appr  = list.Count(x => x.Status == "CMSApproved");
    var rej   = list.Count(x => x.Status == "CMSRejected");
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-invoice"></i></div>
    <div class="ph-text">
        <h1>Monthly Bills</h1>
        <p class="ph-sub">Sab hospitals ke bills</p>
    </div>
</div>

<!-- STATUS SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-6 col-xl-3">
        <div class="stat-card is-navy h-100">
            <div class="card-icon"><i class="fa-solid fa-pen-ruler"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@draft</div>
                <div class="stat-lbl">Draft</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-warn h-100">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@subm</div>
                <div class="stat-lbl">Pending CMS</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-ok h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@appr</div>
                <div class="stat-lbl">Approved</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-danger h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@rej</div>
                <div class="stat-lbl">Rejected</div>
            </div>
        </div>
    </div>

</div>

<!-- FILTER -->
<form method="get" asp-action="Index">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="status">Status</label>
            <select name="status" id="status" class="form-select">
                <option value="">All</option>
                <option value="Draft" selected="@(ViewBag.FilterStatus as string == "Draft")">Draft</option>
                <option value="Submitted" selected="@(ViewBag.FilterStatus as string == "Submitted")">Submitted</option>
                <option value="CMSApproved" selected="@(ViewBag.FilterStatus as string == "CMSApproved")">Approved</option>
                <option value="CMSRejected" selected="@(ViewBag.FilterStatus as string == "CMSRejected")">Rejected</option>
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-filter"></i> Filter
            </button>
            <a asp-action="Index" class="btn btn-light">
                <i class="fa-solid fa-rotate-left"></i> Clear
            </a>
        </div>

    </div>
</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblBills" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="5">Bill #</th>
                        <th data-priority="1">Hospital</th>
                        <th data-priority="6">District</th>
                        <th data-priority="4">Period</th>
                        <th data-priority="7" class="text-end">WPR Score</th>
                        <th data-priority="8" class="text-center">Band %</th>
                        <th data-priority="2" class="text-end">Net Payable</th>
                        <th data-priority="3">Status</th>
                        <th data-priority="1" class="no-sort text-end">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var b in list)
                    {
                        var badgeClass = b.Status switch
                        {
                            "CMSApproved" => "badge-ok",
                            "CMSRejected" => "badge-danger",
                            "Submitted" => "badge-warn",
                            _ => "badge-navy"
                        };

                        <tr>
                            <td class="text-muted">#@b.BillId</td>
                            <td class="fw-semibold">@b.HospitalName</td>
                            <td>@b.District</td>
                            <td class="nowrap">@b.MonthLabel</td>

                            <td class="text-end">
                                @b.WPRAvgScore.ToString("N1")
                                @if (b.IsScoreOverridden)
                                {
                                    <i class="fa-solid fa-pen-to-square text-warning ms-1"
                                       data-bs-toggle="tooltip" title="Score overridden"></i>
                                }
                            </td>

                            <td class="text-center">
                                <span class="badge badge-teal">@b.PaymentBandPercent%</span>
                            </td>

                            <td class="text-end fw-bold nowrap">₹@b.NetPayableAmount.ToString("N0")</td>

                            <td><span class="badge @badgeClass">@b.Status</span></td>

                            <td class="text-end">
                                <a asp-action="Detail" asp-route-id="@b.BillId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#tblBills', {
                exportTitle: 'Monthly Bills',
                order: [[0, 'desc']],
                pageLength: 25,
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    emptyTable: 'Koi bill nahi mila'
                }
            });
        });
    </script>
}
