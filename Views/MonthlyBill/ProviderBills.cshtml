@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>

@{
    ViewData["Title"] = "My Bills";

    var list = Model.ToList();
    var draft = list.Count(x => x.Status == "Draft");
    var pending = list.Count(x => x.Status == "HospitalSubmitted" || x.Status == "Submitted");
    var approved = list.Count(x => x.Status == "CMSApproved");
    var rejected = list.Count(x => x.Status is "CMSRejected" or "HospitalRejected");
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-file-invoice"></i></div>
    <div class="ph-text">
        <h1>My Monthly Bills</h1>
        <p class="ph-sub">Aapke sabhi submitted aur draft bills</p>
    </div>
    <div class="ph-actions">
        <a asp-controller="Provider" asp-action="Dashboard" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Dashboard
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-6 col-xl-3">
        <div class="stat-card is-navy h-100">
            <div class="card-icon"><i class="fa-solid fa-pen-ruler"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@draft</div>
                <div class="stat-lbl">Draft</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-warn h-100">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@pending</div>
                <div class="stat-lbl">Pending Review</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-ok h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@approved</div>
                <div class="stat-lbl">Approved</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-danger h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@rejected</div>
                <div class="stat-lbl">Rejected</div>
            </div>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">

        @if (!list.Any())
        {
            <div class="table-empty">
                <i class="fa-solid fa-inbox"></i>
                <p class="fw-semibold mb-1">Abhi tak koi bill nahi hai.</p>
                <p class="small">Kisi hospital ke liye naya bill banane ke liye Dashboard par jayein.</p>
                <a asp-controller="Provider" asp-action="Dashboard" class="btn btn-sm btn-primary mt-2">
                    <i class="fa-solid fa-gauge-high"></i> Dashboard par jayein
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tblMyBills" class="table table-hover align-middle w-100">

                    <thead>
                        <tr>
                            <th data-priority="5">Bill #</th>
                            <th data-priority="1">Hospital</th>
                            <th data-priority="6">District</th>
                            <th data-priority="4">Period</th>
                            <th data-priority="7" class="text-end">WPR Score</th>
                            <th data-priority="8" class="text-center">Band %</th>
                            <th data-priority="2" class="text-end">Net Payable</th>
                            <th data-priority="3">Status</th>
                            <th data-priority="1" class="no-sort text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var b in list)
                        {
                            var badgeClass = b.Status switch
                            {
                                "CMSApproved" => "badge-ok",
                                "CMSRejected" => "badge-danger",
                                "HospitalRejected" => "badge-danger",
                                "HospitalSubmitted" => "badge-info",
                                "Submitted" => "badge-warn",
                                _ => "badge-navy"
                            };

                            <tr>
                                <td class="text-muted">#@b.BillId</td>
                                <td class="fw-semibold">@b.HospitalName</td>
                                <td>@b.District</td>
                                <td class="nowrap">@b.MonthLabel</td>

                                <td class="text-end">
                                    @b.WPRAvgScore.ToString("N1")
                                    @if (b.IsScoreOverridden)
                                    {
                                        <i class="fa-solid fa-pen-to-square text-warning ms-1"
                                           data-bs-toggle="tooltip" title="Score overridden"></i>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-teal">@b.PaymentBandPercent%</span>
                                </td>

                                <td class="text-end fw-bold nowrap">₹@b.NetPayableAmount.ToString("N0")</td>

                                <td><span class="badge @badgeClass">@b.Status</span></td>

                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-id="@b.BillId" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#tblMyBills', {
                exportTitle: 'My Monthly Bills',
                order: [[0, 'desc']],
                pageLength: 25,
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });
        });
    </script>
}
