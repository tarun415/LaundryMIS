@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>
@{
    ViewData["Title"] = "My Bills";
}

<style>
    .page-header { background: linear-gradient(135deg, #1a3c5e, #2563a8); color: white; border-radius: 12px; padding: 20px 24px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
    .stat-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.07); padding: 14px 18px; text-align: center; }
    .stat-card .num { font-size: 2rem; font-weight: 800; }
    .stat-card .lbl { font-size: .75rem; text-transform: uppercase; color: #6b7280; }
    .table-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,.07); padding: 18px 20px; }
</style>

<div class="page-header">
    <div>
        <h4 class="mb-1">🧾 My Monthly Bills</h4>
        <p class="mb-0 opacity-75">Aapke sabhi submitted aur draft bills</p>
    </div>
    <a asp-controller="Provider" asp-action="Dashboard" class="btn btn-light btn-sm">
        ← Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var list = Model.ToList();
    var draft = list.Count(x => x.Status == "Draft");
    var pending = list.Count(x => x.Status == "HospitalSubmitted" || x.Status == "Submitted");
    var approved = list.Count(x => x.Status == "CMSApproved");
    var rejected = list.Count(x => x.Status is "CMSRejected" or "HospitalRejected");
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-secondary">@draft</div>
            <div class="lbl">Draft</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-warning">@pending</div>
            <div class="lbl">Pending Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-success">@approved</div>
            <div class="lbl">Approved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-danger">@rejected</div>
            <div class="lbl">Rejected</div>
        </div>
    </div>
</div>

<div class="table-card">
    @if (!list.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">📭 Abhi tak koi bill nahi hai.</p>
            <p class="small">Kisi hospital ke liye naya bill banane ke liye Dashboard par jayein.</p>
            <a asp-controller="Provider" asp-action="Dashboard" class="btn btn-primary btn-sm">Dashboard par jayein</a>
        </div>
    }
    else
    {
        <table id="tblMyBills" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Bill #</th>
                    <th>Hospital</th>
                    <th>District</th>
                    <th>Period</th>
                    <th>WPR Score</th>
                    <th>Band %</th>
                    <th class="text-end">Net Payable</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in list)
                {
                    var sc = b.Status switch
                    {
                        "CMSApproved" => "success",
                        "CMSRejected" => "danger",
                        "HospitalRejected" => "danger",
                        "HospitalSubmitted" => "info",
                        "Submitted" => "warning",
                        _ => "secondary"
                    };
                    <tr>
                        <td class="text-muted">#@b.BillId</td>
                        <td class="fw-semibold">@b.HospitalName</td>
                        <td>@b.District</td>
                        <td>@b.MonthLabel</td>
                        <td>
                            @b.WPRAvgScore.ToString("N1")
                            @if (b.IsScoreOverridden)
                            {
                                <span class="badge bg-warning ms-1" title="Score Override">✏️</span>
                            }
                        </td>
                        <td><span class="badge bg-primary">@b.PaymentBandPercent%</span></td>
                        <td class="text-end fw-bold">₹@b.NetPayableAmount.ToString("N0")</td>
                        <td><span class="badge bg-@sc">@b.Status</span></td>
                        <td>
                            <a asp-action="Detail" asp-route-id="@b.BillId"
                               class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script>
        $(function () {
            $('#tblMyBills').DataTable({
                order: [[0, 'desc']],
                pageLength: 25,
                language: { search: "Search:", info: "_START_–_END_ of _TOTAL_" }
            });
        });
    </script>
}
