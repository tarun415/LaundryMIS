@model LaudaryMis.ViewModels.MonthlyBillVM
@{
    ViewData["Title"] = "Monthly Bill — " + Model.MonthName;
}

<style>
    .bill-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
        padding: 22px 24px;
        margin-bottom: 20px;
    }
    .bill-card h6 {
        font-weight: 700; color: #1a3c5e;
        border-bottom: 2px solid #e8f0fe;
        padding-bottom: 8px; margin-bottom: 16px;
    }
    .info-pill {
        background: #f0f6ff; border: 1px solid #c7deff;
        border-radius: 8px; padding: 10px 16px; margin-bottom: 8px;
    }
    .info-pill small { display:block; color:#6b7280; font-size:.75rem; font-weight:600; text-transform:uppercase; }
    .calc-row { display:flex; justify-content:space-between; padding:8px 0; border-bottom:1px solid #f0f4f8; font-size:.9rem; }
    .calc-row:last-child { border-bottom:none; }
    .calc-row .lbl { color:#6b7280; }
    .calc-row .val { font-weight:700; color:#1a3c5e; }
    .net-row { background:#eef7f0; border-radius:8px; padding:12px; margin-top:8px; display:flex; justify-content:space-between; }
    .net-row .lbl { font-weight:700; }
    .net-row .val { font-weight:800; color:#16a34a; font-size:1.1rem; }
    .page-header { background:linear-gradient(135deg,#1a3c5e,#2563a8); color:white; border-radius:12px; padding:20px 24px; margin-bottom:24px; }
</style>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        ⚠️ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="page-header">
    <h4 class="mb-1">🧾 Monthly Bill — @Model.MonthName</h4>
    <p class="mb-0 opacity-75">@Model.HospitalName &nbsp;|&nbsp; Contract: @Model.ContractNo</p>
</div>

<form asp-action="SaveDraft" method="post">
    @Html.AntiForgeryToken()

    <!-- Hidden fields -->
    <input type="hidden" asp-for="BillId" />
    <input type="hidden" asp-for="HospitalId" />
    <input type="hidden" asp-for="AgreementId" />
    <input type="hidden" asp-for="BillingMonth" />
    <input type="hidden" asp-for="BillingYear" />
    <input type="hidden" asp-for="SanctionedBeds" />
    <input type="hidden" asp-for="RatePerBedPerYear" />
    <input type="hidden" asp-for="GSTPercent" />
    <input type="hidden" asp-for="WPRWeeksFound" />
    <!-- Computed amounts (JS update karega) -->
    <input type="hidden" asp-for="AnnualValueExGST"   id="hAnnualExGST" />
    <input type="hidden" asp-for="AnnualValueInGST"   id="hAnnualInGST" />
    <input type="hidden" asp-for="MonthlyGrossAmount"  id="hMonthlyGross" />
    <input type="hidden" asp-for="PaymentBandPercent"  id="hBandPct" />
    <input type="hidden" asp-for="BasePayableAmount"   id="hBasePayable" />
    <input type="hidden" asp-for="TDSAmount"           id="hTDSAmount" />
    <input type="hidden" asp-for="NetPayableAmount"    id="hNetPayable" />

    <div class="row g-4">
        <div class="col-md-7">

            <!-- Agreement Info -->
            <div class="bill-card">
                <h6>📋 Agreement Details</h6>
                <div class="row g-2">
                    <div class="col-4">
                        <div class="info-pill">
                            <small>Sanctioned Beds</small>
                            <strong>@Model.SanctionedBeds</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="info-pill">
                            <small>Rate/Bed/Year</small>
                            <strong>₹@Model.RatePerBedPerYear.ToString("N0")</strong>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="info-pill">
                            <small>GST</small>
                            <strong>@Model.GSTPercent%</strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- WPR Score -->
            <div class="bill-card">
                <h6>📊 WPR Score</h6>

                @if (Model.WPRWeeksFound > 0)
                {
                    <div class="alert alert-info py-2 mb-3">
                        ✅ <strong>@Model.WPRWeeksFound weeks</strong> ka WPR mila — 
                        Auto avg: <strong>@Model.AutoCalculatedScore?.ToString("N2")</strong>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning py-2 mb-3">
                        ⚠️ Is month ka WPR data nahi mila. Score manually daalo.
                    </div>
                }

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">WPR Score <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" min="0" max="100"
                               asp-for="WPRAvgScore" id="inpScore"
                               class="form-control" />
                        <span asp-validation-for="WPRAvgScore" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Score Override?</label>
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox"
                                   asp-for="IsScoreOverridden" id="chkOverride" />
                            <label class="form-check-label">Haan, manually set kar raha hoon</label>
                        </div>
                    </div>
                    <div class="col-12" id="divReason" style="display:none">
                        <label class="form-label fw-semibold">Override Reason <span class="text-danger">*</span></label>
                        <textarea asp-for="OverrideReason" class="form-control" rows="2"
                                  placeholder="Reason batao..."></textarea>
                        <span asp-validation-for="OverrideReason" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Deductions -->
            <div class="bill-card">
                <h6>➖ Deductions</h6>
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Extra Deduction (₹)</label>
                        <input type="number" step="0.01" min="0"
                               asp-for="AdditionalDeductions" id="inpDeduct"
                               class="form-control" />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">Deduction Remarks</label>
                        <input type="text" asp-for="DeductionRemarks" class="form-control" placeholder="Optional" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Live Calc -->
        <div class="col-md-5">
            <div class="bill-card" style="position:sticky;top:80px;">
                <h6>💰 Bill Calculation</h6>
                <div class="calc-row"><span class="lbl">Annual (ex-GST)</span><span class="val" id="dExGST">₹@Model.AnnualValueExGST.ToString("N2")</span></div>
                <div class="calc-row"><span class="lbl">Annual (incl GST)</span><span class="val" id="dInGST">₹@Model.AnnualValueInGST.ToString("N2")</span></div>
                <div class="calc-row"><span class="lbl">Monthly Gross</span><span class="val" id="dGross">₹@Model.MonthlyGrossAmount.ToString("N2")</span></div>
                <div class="calc-row"><span class="lbl">WPR Band</span><span class="val"><span class="badge bg-primary" id="dBand">@Model.PaymentBandPercent%</span></span></div>
                <div class="calc-row"><span class="lbl">Base Payable</span><span class="val" id="dBase">₹@Model.BasePayableAmount.ToString("N2")</span></div>
                <div class="calc-row"><span class="lbl">TDS (2%)</span><span class="val text-danger" id="dTDS">-₹@Model.TDSAmount.ToString("N2")</span></div>
                <div class="calc-row"><span class="lbl">Extra Deductions</span><span class="val text-danger" id="dDeduct">-₹@Model.AdditionalDeductions.ToString("N2")</span></div>
                <div class="net-row mt-2">
                    <span class="lbl">Net Payable</span>
                    <span class="val" id="dNet">₹@Model.NetPayableAmount.ToString("N2")</span>
                </div>
                <div class="mt-3 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        💾 Save Draft
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    $('#chkOverride').on('change', function() {
        $('#divReason').toggle(this.checked);
    });
    if ($('#chkOverride').is(':checked')) $('#divReason').show();

    function recalc() {
        $.ajax({
            url: '@Url.Action("Recalculate","MonthlyBill")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                SanctionedBeds:      @Model.SanctionedBeds,
                RatePerBedPerYear:   @Model.RatePerBedPerYear,
                GSTPercent:          @Model.GSTPercent,
                WPRAvgScore:         parseFloat($('#inpScore').val()) || 0,
                AdditionalDeductions:parseFloat($('#inpDeduct').val()) || 0,
                TDSPercent:          2
            }),
            success: function(r) {
                $('#dExGST').text('₹'+r.annualExGST);
                $('#dInGST').text('₹'+r.annualInGST);
                $('#dGross').text('₹'+r.monthlyGross);
                $('#dBand').text(r.paymentBand+'%');
                $('#dBase').text('₹'+r.basePayable);
                $('#dTDS').text('-₹'+r.tdsAmount);
                $('#dDeduct').text('-₹'+(parseFloat($('#inpDeduct').val())||0).toFixed(2));
                $('#dNet').text('₹'+r.netPayable);
                // Hidden fields update
                $('#hAnnualExGST').val(r.annualExGST.replace(/,/g,''));
                $('#hAnnualInGST').val(r.annualInGST.replace(/,/g,''));
                $('#hMonthlyGross').val(r.monthlyGross.replace(/,/g,''));
                $('#hBandPct').val(r.paymentBand);
                $('#hBasePayable').val(r.basePayable.replace(/,/g,''));
                $('#hTDSAmount').val(r.tdsAmount.replace(/,/g,''));
                $('#hNetPayable').val(r.netPayable.replace(/,/g,''));
            }
        });
    }

    $('#inpScore, #inpDeduct').on('input', function() {
        clearTimeout(window._t);
        window._t = setTimeout(recalc, 600);
    });
</script>
}