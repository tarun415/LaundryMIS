@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>
@{
    ViewData["Title"] = "Bill Verification Queue";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #1a3c5e, #2563a8);
        color: white;
        border-radius: 12px;
        padding: 20px 24px;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: 14px 18px;
        text-align: center;
    }

        .stat-card .num {
            font-size: 2rem;
            font-weight: 800;
        }

        .stat-card .lbl {
            font-size: .75rem;
            text-transform: uppercase;
            color: #6b7280;
        }

    .table-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
        padding: 18px 20px;
    }

    .action-btns form {
        display: inline;
    }
</style>

<div class="page-header">
    <div>
        <h4 class="mb-1">📋 Bill Verification Queue</h4>
        <p class="mb-0 opacity-75">Provider ke submitted bills — approve ya reject karein</p>
    </div>
    <a asp-controller="Hospital" asp-action="Dashboard" class="btn btn-light btn-sm">
        ← Dashboard
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        ✅ @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        ❌ @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@{
    var list = Model.ToList();
    var pending = list.Count(x => x.Status == "HospitalSubmitted");
    var approved = list.Count(x => x.Status == "HospitalApproved" || x.Status == "CMSApproved");
    var rejected = list.Count(x => x.Status == "HospitalRejected");
    var total = list.Count;
}

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-warning">@pending</div>
            <div class="lbl">Pending Review</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-success">@approved</div>
            <div class="lbl">Approved</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-danger">@rejected</div>
            <div class="lbl">Rejected</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="num text-primary">@total</div>
            <div class="lbl">Total</div>
        </div>
    </div>
</div>

<div class="table-card">
    @if (!list.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="fs-5">🎉 Koi pending bill nahi hai!</p>
            <p class="small">Jab provider bill submit karega, yahan dikhega.</p>
        </div>
    }
    else
    {
        <table id="tblQueue" class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Bill #</th>
                    <th>Provider</th>
                    <th>Period</th>
                    <th>WPR Score</th>
                    <th>Band %</th>
                    <th class="text-end">Net Payable</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in list)
                {
                    var sc = b.Status switch
                    {
                        "HospitalApproved" => "success",
                        "CMSApproved" => "success",
                        "HospitalRejected" => "danger",
                        "CMSRejected" => "danger",
                        "HospitalSubmitted" => "warning",
                        _ => "secondary"
                    };
                    var isPending = b.Status == "HospitalSubmitted";

                    <tr>
                        <td class="text-muted">#@b.BillId</td>
                        <td class="fw-semibold">@b.ProviderName</td>
                        <td>@b.MonthLabel</td>
                        <td>
                            @b.WPRAvgScore.ToString("N1")
                            @if (b.IsScoreOverridden)
                            {
                                <span class="badge bg-warning ms-1" title="Score Override">✏️</span>
                            }
                        </td>
                        <td><span class="badge bg-primary">@b.PaymentBandPercent%</span></td>
                        <td class="text-end fw-bold">₹@b.NetPayableAmount.ToString("N0")</td>
                        <td><span class="badge bg-@sc">@b.Status</span></td>
                        <td class="action-btns">
                            <a asp-action="Detail" asp-route-id="@b.BillId"
                               class="btn btn-sm btn-outline-primary">🔍 View</a>

                            @if (isPending)
                            {
                                <button class="btn btn-sm btn-success ms-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalApprove"
                                        data-bill-id="@b.BillId"
                                        data-provider="@b.ProviderName">
                                    ✅ Approve
                                </button>
                                <button class="btn btn-sm btn-danger ms-1"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalReject"
                                        data-bill-id="@b.BillId"
                                        data-provider="@b.ProviderName">
                                    ❌ Reject
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- Approve Modal -->
<div class="modal fade" id="modalApprove" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">✅ Bill Approve Karein</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="HospitalAction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billId" id="approveId" />
                <input type="hidden" name="approve" value="true" />
                <div class="modal-body">
                    <p class="text-muted mb-3">
                        Provider: <strong id="approveProvider"></strong> ka bill approve ho jayega.
                    </p>
                    <label class="form-label">Remarks (Optional)</label>
                    <textarea name="remarks" class="form-control" rows="3"
                              placeholder="Koi note likhein..."></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">✅ Approve Karo</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="modalReject" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">❌ Bill Reject Karein</h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="HospitalAction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billId" id="rejectId" />
                <input type="hidden" name="approve" value="false" />
                <div class="modal-body">
                    <p class="text-muted mb-3">
                        Provider: <strong id="rejectProvider"></strong> ka bill reject ho jayega.
                    </p>
                    <label class="form-label fw-bold">Reason <span class="text-danger">*</span></label>
                    <textarea name="remarks" class="form-control" rows="3"
                              placeholder="Rejection ki wajah likhein..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">❌ Reject Karo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal mein bill ID aur provider naam inject karo
        document.getElementById('modalApprove').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('approveId').value       = btn.dataset.billId;
            document.getElementById('approveProvider').textContent = btn.dataset.provider;
        });

        document.getElementById('modalReject').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('rejectId').value        = btn.dataset.billId;
            document.getElementById('rejectProvider').textContent = btn.dataset.provider;
        });

        $(function () {
            $('#tblQueue').DataTable({
                order: [[0, 'desc']],
                pageLength: 25,
                language: { search: "Search:", info: "_START_–_END_ of _TOTAL_" }
            });
        });
    </script>
}
