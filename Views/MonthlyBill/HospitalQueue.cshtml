@model IEnumerable<LaudaryMis.ViewModels.BillListItemVM>

@{
    ViewData["Title"] = "Bill Verification Queue";

    var list = Model.ToList();
    var pending = list.Count(x => x.Status == "HospitalSubmitted");
    var approved = list.Count(x => x.Status == "HospitalApproved" || x.Status == "CMSApproved");
    var rejected = list.Count(x => x.Status == "HospitalRejected");
    var total = list.Count;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-clipboard-list"></i></div>
    <div class="ph-text">
        <h1>Bill Verification Queue</h1>
        <p class="ph-sub">Provider ke submitted bills — approve ya reject karein</p>
    </div>
    <div class="ph-actions">
        <a asp-controller="Hospital" asp-action="Dashboard" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Dashboard
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-6 col-xl-3">
        <div class="stat-card is-warn h-100">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@pending</div>
                <div class="stat-lbl">Pending Review</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-ok h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@approved</div>
                <div class="stat-lbl">Approved</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-danger h-100">
            <div class="card-icon"><i class="fa-solid fa-circle-xmark"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@rejected</div>
                <div class="stat-lbl">Rejected</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-navy h-100">
            <div class="card-icon"><i class="fa-solid fa-layer-group"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@total</div>
                <div class="stat-lbl">Total</div>
            </div>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">

        @if (!list.Any())
        {
            <div class="table-empty">
                <i class="fa-solid fa-inbox"></i>
                <p class="fw-semibold mb-1">Koi pending bill nahi hai!</p>
                <p class="small mb-0">Jab provider bill submit karega, yahan dikhega.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table id="tblQueue" class="table table-hover align-middle w-100">

                    <thead>
                        <tr>
                            <th data-priority="5">Bill #</th>
                            <th data-priority="1">Provider</th>
                            <th data-priority="4">Period</th>
                            <th data-priority="6" class="text-end">WPR Score</th>
                            <th data-priority="7" class="text-center">Band %</th>
                            <th data-priority="2" class="text-end">Net Payable</th>
                            <th data-priority="3">Status</th>
                            <th data-priority="1" class="no-sort text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var b in list)
                        {
                            var badgeClass = b.Status switch
                            {
                                "HospitalApproved" => "badge-ok",
                                "CMSApproved" => "badge-ok",
                                "HospitalRejected" => "badge-danger",
                                "CMSRejected" => "badge-danger",
                                "HospitalSubmitted" => "badge-warn",
                                _ => "badge-navy"
                            };
                            var isPending = b.Status == "HospitalSubmitted";

                            <tr>
                                <td class="text-muted">#@b.BillId</td>
                                <td class="fw-semibold">@b.ProviderName</td>
                                <td class="nowrap">@b.MonthLabel</td>

                                <td class="text-end">
                                    @b.WPRAvgScore.ToString("N1")
                                    @if (b.IsScoreOverridden)
                                    {
                                        <i class="fa-solid fa-pen-to-square text-warning ms-1"
                                           data-bs-toggle="tooltip" title="Score overridden"></i>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-teal">@b.PaymentBandPercent%</span>
                                </td>

                                <td class="text-end fw-bold nowrap">₹@b.NetPayableAmount.ToString("N0")</td>

                                <td><span class="badge @badgeClass">@b.Status</span></td>

                                <td class="text-end">
                                    <div class="action-group justify-content-end">

                                        <a asp-action="Detail" asp-route-id="@b.BillId"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-eye"></i> View
                                        </a>

                                        @if (isPending)
                                        {
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalApprove"
                                                    data-bill-id="@b.BillId"
                                                    data-provider="@b.ProviderName">
                                                <i class="fa-solid fa-check"></i> Approve
                                            </button>

                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#modalReject"
                                                    data-bill-id="@b.BillId"
                                                    data-provider="@b.ProviderName">
                                                <i class="fa-solid fa-xmark"></i> Reject
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>

<!-- APPROVE MODAL -->
<div class="modal fade" id="modalApprove" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-circle-check text-success me-1"></i> Bill Approve Karein
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="HospitalAction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billId" id="approveId" />
                <input type="hidden" name="approve" value="true" />

                <div class="modal-body">
                    <p class="text-muted mb-3">
                        Provider: <strong id="approveProvider"></strong> ka bill approve ho jayega.
                    </p>
                    <label class="form-label" for="approveRemarks">Remarks (Optional)</label>
                    <textarea name="remarks" id="approveRemarks" class="form-control" rows="3"
                              placeholder="Koi note likhein…"></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-check"></i> Approve Karo
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="modalReject" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-circle-xmark text-danger me-1"></i> Bill Reject Karein
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="HospitalAction" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="billId" id="rejectId" />
                <input type="hidden" name="approve" value="false" />

                <div class="modal-body">
                    <p class="text-muted mb-3">
                        Provider: <strong id="rejectProvider"></strong> ka bill reject ho jayega.
                    </p>
                    <label class="form-label" for="rejectRemarks">Reason <span class="text-danger">*</span></label>
                    <textarea name="remarks" id="rejectRemarks" class="form-control" rows="3"
                              placeholder="Rejection ki wajah likhein…" required></textarea>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-xmark"></i> Reject Karo
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>

        document.getElementById('modalApprove').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('approveId').value = btn.dataset.billId;
            document.getElementById('approveProvider').textContent = btn.dataset.provider;
        });

        document.getElementById('modalReject').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('rejectId').value = btn.dataset.billId;
            document.getElementById('rejectProvider').textContent = btn.dataset.provider;
        });

        $(function () {
            LMIS.initTable('#tblQueue', {
                exportTitle: 'Bill Verification Queue',
                order: [[0, 'desc']],
                pageLength: 25,
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });
        });

    </script>
}
