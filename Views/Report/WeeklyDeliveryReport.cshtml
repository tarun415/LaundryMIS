@model List<LaudaryMis.ViewModels.WeeklyDeliveryReport>

@{
    ViewBag.Title = "Weekly Laundry Report";

    var totalPickups = Model.Sum(x => x.TotalPickups);
    var totalCollected = Model.Sum(x => x.TotalCollectedQty);
    var totalDelivered = Model.Sum(x => x.TotalDeliveredQty);
    var totalPending = Model.Sum(x => x.TotalPendingQty);
}

@*
    Note: this file previously contained stray markdown code fences (```) in both
    the markup and the <script> block. The ones inside the script were a syntax
    error, which stopped the DataTable on this page from initialising at all.
*@

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-calendar-week"></i></div>
    <div class="ph-text">
        <h1>Weekly Laundry Report</h1>
        <p class="ph-sub">Daily pickup and delivery totals for the selected range</p>
    </div>
</div>

<!-- FILTER -->
<form method="get">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="fromDate">From Date</label>
            <input type="date" name="fromDate" id="fromDate" value="@ViewBag.FromDate" class="form-control" />
        </div>

        <div class="filter-field">
            <label class="form-label" for="toDate">To Date</label>
            <input type="date" name="toDate" id="toDate" value="@ViewBag.ToDate" class="form-control" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
        </div>

    </div>
</form>

<!-- TOTALS -->
<div class="row g-3 mb-3">

    <div class="col-6 col-xl-3">
        <div class="stat-card is-navy h-100">
            <div class="card-icon"><i class="fa-solid fa-boxes-stacked"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalPickups.ToString("N0")</div>
                <div class="stat-lbl">Total Pickups</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-teal h-100">
            <div class="card-icon"><i class="fa-solid fa-boxes-packing"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalCollected.ToString("N0")</div>
                <div class="stat-lbl">Collected Qty</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-ok h-100">
            <div class="card-icon"><i class="fa-solid fa-truck"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalDelivered.ToString("N0")</div>
                <div class="stat-lbl">Delivered Qty</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-xl-3">
        <div class="stat-card is-danger h-100">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalPending.ToString("N0")</div>
                <div class="stat-lbl">Pending Qty</div>
            </div>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="weeklyTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="1">Date</th>
                        <th data-priority="4" class="text-end">Total Pickups</th>
                        <th data-priority="2" class="text-end">Collected Qty</th>
                        <th data-priority="2" class="text-end">Delivered Qty</th>
                        <th data-priority="3" class="text-end">Pending Qty</th>
                        <th data-priority="5" class="text-center">Fully Delivered</th>
                        <th data-priority="5" class="text-center">Partial Delivered</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="nowrap fw-semibold">@item.ReportDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">@item.TotalPickups</td>
                            <td class="text-end fw-bold text-teal">@item.TotalCollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.TotalDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.TotalPendingQty</td>
                            <td class="text-center"><span class="badge badge-ok">@item.FullyDeliveredCount</span></td>
                            <td class="text-center"><span class="badge badge-warn">@item.PartialDeliveredCount</span></td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#weeklyTable', {
                exportTitle: 'Weekly Laundry Report',
                order: [[0, 'desc']]
            });
        });
    </script>
}
