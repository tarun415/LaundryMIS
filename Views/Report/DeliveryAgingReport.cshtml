@model LaudaryMis.ViewModels.DeliveryAgingReportPageVM

@{
    ViewBag.Title = "Pending Linen Aging Report";

    var totalCollected = Model.Details.Sum(x => x.CollectedQty);
    var totalDelivered = Model.Details.Sum(x => x.DeliveredQty);
    var totalPending = Model.Details.Sum(x => x.PendingQty);
}

@*
    Note: this file previously contained stray markdown code fences (```) in the
    markup, a malformed <thead"> tag in the child-row template, and a second copy
    of DataTables + Buttons loaded from a CDN on top of the ones in _Layout.
*@


<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-hourglass-half"></i></div>
    <div class="ph-text">
        <h1>Pending Linen Aging Report</h1>
        <p class="ph-sub">How long collected linen has been outstanding</p>
    </div>
</div>

@if (Model.Summary.CriticalCount > 0)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span>
            <strong>@Model.Summary.CriticalCount</strong> pickup(s) have been pending for more than 7 days.
        </span>
    </div>
}

<!-- SUMMARY -->
<div class="row g-3 mb-3">

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-navy h-100">
            <div class="min-w-0">
                <div class="stat-val">@Model.Summary.TotalPendingPickups.ToString("N0")</div>
                <div class="stat-lbl">Pending Pickups</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-danger h-100">
            <div class="min-w-0">
                <div class="stat-val">@Model.Summary.TotalPendingQty.ToString("N0")</div>
                <div class="stat-lbl">Pending Linen Qty</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-ok h-100">
            <div class="min-w-0">
                <div class="stat-val">@Model.Summary.NormalCount.ToString("N0")</div>
                <div class="stat-lbl">Normal Cases</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-warn h-100">
            <div class="min-w-0">
                <div class="stat-val">@Model.Summary.WarningCount.ToString("N0")</div>
                <div class="stat-lbl">Warning Cases</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-danger h-100">
            <div class="min-w-0">
                <div class="stat-val">@Model.Summary.CriticalCount.ToString("N0")</div>
                <div class="stat-lbl">Critical Cases</div>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-4 col-xl-2">
        <div class="stat-card is-teal h-100">
            <div class="min-w-0">
                <div class="stat-val">@totalCollected.ToString("N0")</div>
                <div class="stat-lbl">Total Collected</div>
            </div>
        </div>
    </div>

</div>

<!-- GUIDE -->
<div class="card mb-3">
    <div class="card-header">
        <i class="fa-solid fa-book-open text-teal"></i>
        <span class="card-title">Report Guide</span>
        <div class="ms-auto d-flex flex-wrap gap-2">
            <span class="badge badge-ok">Normal (0–3 days)</span>
            <span class="badge badge-warn">Warning (4–7 days)</span>
            <span class="badge badge-danger">Critical (&gt;7 days)</span>
        </div>
    </div>

    <div class="card-body">
        <div class="row g-2">
            <div class="col-12 col-md-6">
                <div class="info-row"><span class="info-k">Total Collected Linen</span><span class="info-v">Dirty linen collected from hospital</span></div>
                <div class="info-row"><span class="info-k">Total Returned Linen</span><span class="info-v">Clean linen returned by provider</span></div>
                <div class="info-row"><span class="info-k">Linen Pending Return</span><span class="info-v">Still pending to be returned</span></div>
            </div>
            <div class="col-12 col-md-6">
                <div class="info-row"><span class="info-k">Days Pending</span><span class="info-v">Days since collection, not fully returned</span></div>
                <div class="info-row"><span class="info-k">Pending Pickups</span><span class="info-v">Pickup challans having pending linen</span></div>
                <div class="info-row"><span class="info-k">Pending Linen Qty</span><span class="info-v">Total quantity still pending</span></div>
            </div>
        </div>
        <p class="text-muted small mb-0 mt-2">
            <i class="fa-solid fa-circle-info"></i>
            Use the expand control on any row to view linen-wise pending details for that pickup.
        </p>
    </div>
</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="agingTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>Pickup Challan No</th>
                        <th>Hospital Name</th>
                        <th>Ward Name</th>
                        <th>Collection Date</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Returned</th>
                        <th class="text-end">Pending</th>
                        <th class="no-sort">Return Completion</th>
                        <th class="text-end">Days Pending</th>
                        <th>Risk Level</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Details)
                    {
                        var completion = item.CollectedQty == 0
                            ? 0
                            : Math.Round(((decimal)item.DeliveredQty / item.CollectedQty) * 100, 2);

                        string rowClass = item.AgingStatus switch
                        {
                            "Critical" => "critical-row",
                            "Warning" => "warning-row",
                            _ => ""
                        };

                        <tr class="@rowClass">

                            <td class="details-control" data-id="@item.PickupId"></td>

                            <td class="fw-semibold text-teal">@item.PickupNo</td>
                            <td>@item.HospitalName</td>
                            <td>@item.WardName</td>
                            <td class="nowrap">@item.PickupDate.ToString("dd MMM yyyy")</td>

                            <td class="text-end fw-bold">@item.CollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.DeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.PendingQty</td>

                            <td style="min-width: 180px;">
                                <div class="progress">
                                    <div class="progress-bar bg-success" style="width:@completion%">@completion%</div>
                                </div>
                                <small class="text-muted">@item.DeliveredQty / @item.CollectedQty returned</small>
                            </td>

                            <td class="text-end">
                                @if (item.AgingStatus == "Critical")
                                {
                                    <span class="aging-critical">@item.AgingDays Days</span>
                                }
                                else if (item.AgingStatus == "Warning")
                                {
                                    <span class="aging-warning">@item.AgingDays Days</span>
                                }
                                else
                                {
                                    <span class="aging-normal">@item.AgingDays Days</span>
                                }
                            </td>

                            <td>
                                @if (item.AgingStatus == "Critical")
                                {
                                    <span class="badge badge-danger">Critical</span>
                                }
                                else if (item.AgingStatus == "Warning")
                                {
                                    <span class="badge badge-warn">Warning</span>
                                }
                                else
                                {
                                    <span class="badge badge-ok">Normal</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="5" class="text-end">Totals</td>
                        <td class="text-end">@totalCollected.ToString("N0")</td>
                        <td class="text-end text-success">@totalDelivered.ToString("N0")</td>
                        <td class="text-end text-danger">@totalPending.ToString("N0")</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            // expandable: this table owns its row.child() linen breakdown,
            // so Responsive is off and the table scrolls sideways instead.
            var table = LMIS.initTable('#agingTable', {
                expandable: true,
                exportTitle: 'Pending Linen Aging Report',
                order: [[9, 'desc']],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            $('#agingTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var pickupId = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Report/GetDeliveryAgingItems/' + pickupId, function (result) {
                    row.child(formatChild(result)).show();
                    tr.addClass('shown');
                }).fail(function () {
                    LMIS.alert('Could not load details', 'Unable to load linen details.', 'error');
                });

            });

        });

        function formatChild(data) {

            var totalCollected = 0;
            var totalDelivered = 0;
            var totalPending = 0;

            var rows = '';

            $.each(data, function (i, item) {

                totalCollected += item.collectedQty;
                totalDelivered += item.deliveredQty;
                totalPending += item.pendingQty;

                rows +=
                    '<tr>' +
                        '<td class="fw-semibold">' + item.linenName + '</td>' +
                        '<td class="text-end fw-bold">' + item.collectedQty + '</td>' +
                        '<td class="text-end fw-bold text-success">' + item.deliveredQty + '</td>' +
                        '<td class="text-end fw-bold text-danger">' + item.pendingQty + '</td>' +
                    '</tr>';
            });

            return '' +
                '<div class="child-wrapper" style="padding:12px;">' +
                    '<div class="section-title">Linen Wise Pending Details</div>' +
                    '<div class="table-responsive">' +
                        '<table class="child-table mb-0">' +
                            '<thead><tr>' +
                                '<th style="width:40%">Linen Type</th>' +
                                '<th class="text-end">Collected Qty</th>' +
                                '<th class="text-end">Returned Qty</th>' +
                                '<th class="text-end">Pending Qty</th>' +
                            '</tr></thead>' +
                            '<tbody>' + rows + '</tbody>' +
                            '<tfoot><tr>' +
                                '<td class="fw-bold">Total</td>' +
                                '<td class="text-end fw-bold text-teal">' + totalCollected + '</td>' +
                                '<td class="text-end fw-bold text-success">' + totalDelivered + '</td>' +
                                '<td class="text-end fw-bold text-danger">' + totalPending + '</td>' +
                            '</tr></tfoot>' +
                        '</table>' +
                    '</div>' +
                    '<small class="text-muted d-block mt-2">' +
                        '<i class="fa-solid fa-circle-info"></i> ' +
                        'Linen-wise collection, returned quantity and pending quantity for the selected pickup.' +
                    '</small>' +
                '</div>';
        }

    </script>
}
