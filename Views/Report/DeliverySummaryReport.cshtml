@using LaudaryMis.ViewModels
@model List<DeliverySummaryVM>

@{
    ViewBag.Title = "Delivery Summary Report";

    var totalCollected = Model?.Sum(x => x.TotalCollectedQty) ?? 0;
    var totalDelivered = Model?.Sum(x => x.TotalDeliveredQty) ?? 0;
    var totalPending = Model?.Sum(x => x.PendingQty) ?? 0;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-chart-column"></i></div>
    <div class="ph-text">
        <h1>Delivery Summary Report</h1>
        <p class="ph-sub">Collected vs delivered linen, by pickup</p>
    </div>
</div>

<!-- TOTALS -->
<div class="row g-3 mb-3">

    <div class="col-12 col-md-4">
        <div class="stat-card is-teal h-100">
            <div class="card-icon"><i class="fa-solid fa-boxes-packing"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalCollected.ToString("N0")</div>
                <div class="stat-lbl">Total Collected</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card is-ok h-100">
            <div class="card-icon"><i class="fa-solid fa-truck"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalDelivered.ToString("N0")</div>
                <div class="stat-lbl">Total Delivered</div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="stat-card is-danger h-100">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@totalPending.ToString("N0")</div>
                <div class="stat-lbl">Total Pending</div>
            </div>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="deliveryTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>Pickup No</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th class="text-end">Collected</th>
                        <th class="text-end">Delivered</th>
                        <th class="text-end">Pending</th>
                        <th class="text-end">Deliveries</th>
                        <th>First Delivery</th>
                        <th>Last Delivery</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="details-control" data-id="@item.PickupId"></td>

                            <td class="fw-semibold text-teal">@item.PickupNo</td>
                            <td>@item.HospitalName</td>
                            <td>@item.WardName</td>

                            <td class="text-end fw-bold text-teal">@item.TotalCollectedQty</td>
                            <td class="text-end fw-bold text-success">@item.TotalDeliveredQty</td>
                            <td class="text-end fw-bold text-danger">@item.PendingQty</td>
                            <td class="text-end">@item.DeliveryCount</td>

                            <td class="nowrap">@(item.FirstDeliveryDate?.ToString("dd MMM yyyy"))</td>
                            <td class="nowrap">@(item.LastDeliveryDate?.ToString("dd MMM yyyy"))</td>

                            <td>
                                @if (item.DeliveryStatus == "Fully Delivered")
                                {
                                    <span class="badge badge-ok">Fully Delivered</span>
                                }
                                else if (item.DeliveryStatus == "Partial Delivered")
                                {
                                    <span class="badge badge-warn">Partial Delivered</span>
                                }
                                else
                                {
                                    <span class="badge badge-navy">Pending</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            // expandable: this table owns its row.child() delivery history,
            // so Responsive is off and the table scrolls sideways instead.
            var table = LMIS.initTable('#deliveryTable', {
                expandable: true,
                exportTitle: 'Delivery Summary',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ]
            });

            $('#deliveryTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var pickupId = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Report/DeliveryHistory/' + pickupId, function (data) {
                    row.child(format(data)).show();
                    tr.addClass('shown');
                });
            });

        });

        function format(data) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Delivery No</th>' +
                        '<th>Date</th>' +
                        '<th>Linen Name</th>' +
                        '<th class="text-end">Delivered Qty</th>' +
                        '<th>Status</th>' +
                        '<th>Remarks</th>' +
                    '</tr></thead><tbody>';

            data.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td class="fw-semibold">' + x.deliveryNo + '</td>' +
                        '<td class="nowrap">' + formatDate(x.deliveryDateTime) + '</td>' +
                        '<td>' + x.linenName + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td><span class="badge badge-info">' + x.status + '</span></td>' +
                        '<td>' + (x.remarks || '') + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

        function formatDate(dateString) {
            return new Date(dateString).toLocaleDateString('en-GB', {
                day: '2-digit', month: 'short', year: 'numeric'
            });
        }

    </script>
}
