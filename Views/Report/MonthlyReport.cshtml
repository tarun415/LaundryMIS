@using LaudaryMis.ViewModels
@model List<MonthlyReportVM>

@{
    ViewBag.Title = "Monthly Laundry Report";
    var summary = Model.FirstOrDefault();
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-calendar-days"></i></div>
    <div class="ph-text">
        <h1>Monthly Laundry Report</h1>
        <p class="ph-sub">Pickup and delivery totals for the selected month</p>
    </div>
</div>

<!-- FILTER -->
<form method="get">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="month">Month</label>
            <select name="month" id="month" class="form-select">
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i" selected="@(ViewBag.Month == i)">
                        @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)
                    </option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label class="form-label" for="year">Year</label>
            <select name="year" id="year" class="form-select">
                @for (int y = DateTime.Now.Year; y >= 2024; y--)
                {
                    <option value="@y" selected="@(ViewBag.Year == y)">@y</option>
                }
            </select>
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
        </div>

    </div>
</form>

<!-- SUMMARY -->
@if (summary != null)
{
    <div class="row g-3 mb-3">

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-navy h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.TotalPickups.ToString("N0")</div>
                    <div class="stat-lbl">Total Pickups</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-teal h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.CollectedQty.ToString("N0")</div>
                    <div class="stat-lbl">Collected Qty</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-ok h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.DeliveredQty.ToString("N0")</div>
                    <div class="stat-lbl">Delivered Qty</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-danger h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.PendingQty.ToString("N0")</div>
                    <div class="stat-lbl">Pending Qty</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-teal h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.FullyDelivered.ToString("N0")</div>
                    <div class="stat-lbl">Fully Delivered</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-4 col-xl-2">
            <div class="stat-card is-gold h-100">
                <div class="min-w-0">
                    <div class="stat-val">@summary.PartialDelivered.ToString("N0")</div>
                    <div class="stat-lbl">Partial Delivered</div>
                </div>
            </div>
        </div>

    </div>
}

<!-- DETAIL TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="monthlyTable" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th class="no-sort"></th>
                        <th>Pickup No</th>
                        <th>Hospital</th>
                        <th>Ward</th>
                        <th class="text-end">Collected Qty</th>
                        <th class="text-end">Delivered Qty</th>
                        <th class="text-end">Pending Qty</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody></tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(function () {

            // expandable: this table owns its row.child() delivery history,
            // so Responsive is off and the table scrolls sideways instead.
            var table = LMIS.initTable('#monthlyTable', {
                expandable: true,
                exportTitle: 'Monthly Laundry Report',

                ajax: {
                    url: '/Report/GetMonthlyPickupDetails',
                    data: function (d) {
                        d.month = $('select[name="month"]').val();
                        d.year = $('select[name="year"]').val();
                    },
                    dataSrc: ''
                },

                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],

                columns: [
                    {
                        data: 'pickupId',
                        render: function (data) {
                            return '<div class="details-control" data-id="' + data + '"></div>';
                        }
                    },
                    { data: 'pickupNo', className: 'fw-semibold text-teal' },
                    { data: 'hospitalName' },
                    { data: 'wardName' },
                    { data: 'collectedQty', className: 'text-end fw-bold text-teal' },
                    { data: 'deliveredQty', className: 'text-end fw-bold text-success' },
                    { data: 'pendingQty', className: 'text-end fw-bold text-danger' },
                    {
                        data: 'status',
                        render: function (data) {
                            if (data === "Verified")
                                return '<span class="badge badge-ok">' + data + '</span>';
                            if (data === "Partial Delivered")
                                return '<span class="badge badge-warn">' + data + '</span>';
                            return '<span class="badge badge-navy">' + data + '</span>';
                        }
                    }
                ]
            });

            $('#monthlyTable tbody').on('click', '.details-control', function () {

                var tr = $(this).closest('tr');
                var row = table.row(tr);
                var id = $(this).data('id');

                if (row.child.isShown()) {
                    row.child.hide();
                    tr.removeClass('shown');
                    return;
                }

                $.get('/Report/GetDeliveryHistory/' + id, function (data) {
                    row.child(format(data)).show();
                    tr.addClass('shown');
                });
            });

        });

        function format(items) {

            var html =
                '<div class="table-responsive">' +
                '<table class="child-table">' +
                    '<thead><tr>' +
                        '<th>Delivery No</th>' +
                        '<th>Date</th>' +
                        '<th class="text-end">Qty</th>' +
                        '<th>Status</th>' +
                    '</tr></thead><tbody>';

            items.forEach(function (x) {
                html +=
                    '<tr>' +
                        '<td class="fw-semibold">' + x.deliveryNo + '</td>' +
                        '<td class="nowrap">' + x.deliveryDate + '</td>' +
                        '<td class="text-end fw-bold text-success">' + x.deliveredQty + '</td>' +
                        '<td>' + x.status + '</td>' +
                    '</tr>';
            });

            return html + '</tbody></table></div>';
        }

    </script>
}
