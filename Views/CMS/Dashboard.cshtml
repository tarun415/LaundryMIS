@model LaudaryMis.ViewModels.CmsDashboardVM

@{
    ViewBag.Title = "CMS Dashboard";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-clipboard-user"></i></div>
    <div class="ph-text">
        <h1>CMS Dashboard</h1>
        <p class="ph-sub">@Model.HospitalName</p>
    </div>
</div>

<partial name="_Alerts" />

<div class="row g-3">

    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-action="WprList" asp-route-status="Pending" class="stat-card is-warn h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@Model.Pending</div>
                <div class="stat-lbl">WPR pending verification</div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-action="WprList" asp-route-status="Verified" class="stat-card is-ok h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-circle-check"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@Model.Verified</div>
                <div class="stat-lbl">WPR verified</div>
            </div>
        </a>
    </div>

    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-action="Disputes" asp-route-status="Open" class="stat-card is-navy h-100 text-decoration-none">
            <div class="card-icon"><i class="fa-solid fa-scale-balanced"></i></div>
            <div class="min-w-0">
                <div class="stat-val">@Model.OpenDisputes</div>
                <div class="stat-lbl">Open bill disputes</div>
            </div>
        </a>
    </div>

</div>

<div class="card mt-3">
    <div class="card-header">
        <i class="fa-solid fa-clipboard-check text-teal"></i>
        <span class="card-title">WPR waiting for you</span>
        <a asp-action="WprList" asp-route-status="Pending" class="ms-auto btn btn-sm btn-light">View all</a>
    </div>
    <div class="card-body">
        @if (Model.RecentPending.Count == 0)
        {
            <p class="text-muted mb-0"><i class="fa-solid fa-circle-check text-success"></i> Nothing is pending. All submitted WPRs are verified.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Month</th>
                            <th>Week</th>
                            <th>Vendor</th>
                            <th class="text-end">Score</th>
                            <th>Submitted</th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in Model.RecentPending)
                        {
                            <tr>
                                <td class="fw-semibold">@w.MonthLabel</td>
                                <td>Week @w.Week</td>
                                <td>@w.ProviderName</td>
                                <td class="text-end">@w.TotalScore / 100</td>
                                <td class="nowrap">@w.SubmittedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Review" asp-route-id="@w.Id" class="btn btn-sm btn-primary">
                                        <i class="fa-solid fa-magnifying-glass"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
