@model LaudaryMis.ViewModels.GeneratePaymentVM

@{
    ViewData["Title"] = "Generate Monthly Payment";
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
    <div class="ph-text">
        <h1>Generate Monthly Payment</h1>
        <p class="ph-sub">Calculated from bed occupancy and the month's average WPR score</p>
    </div>
    <div class="ph-actions">
        <a asp-action="PaymentList" class="btn btn-light">
            <i class="fa-solid fa-arrow-left"></i> Back to List
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<form asp-action="GeneratePayment" asp-controller="Payment" method="post">

    <input asp-for="AgreementId" type="hidden" id="AgreementId" />
    <input asp-for="HospitalId" type="hidden" id="HospitalId" />
    <input asp-for="ProviderId" type="hidden" id="ProviderId" />

    <!-- PARTIES & PERIOD -->
    <div class="card mb-3">
        <div class="card-header">
            <i class="fa-solid fa-circle-info text-teal"></i>
            <span class="card-title">Payment Period</span>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="HospitalName">Hospital</label>
                    <input asp-for="HospitalName" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="ProviderName">Provider</label>
                    <input asp-for="ProviderName" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="MonthNo">Payment Month</label>
                    <select asp-for="MonthNo" id="MonthNo" class="form-select">
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="YearNo">Payment Year</label>
                    <input asp-for="YearNo" id="YearNo" class="form-control" />
                </div>

            </div>
        </div>
    </div>

    <!-- AGREEMENT -->
    <div class="card mb-3">
        <div class="card-header">
            <i class="fa-solid fa-file-signature text-teal"></i>
            <span class="card-title">Agreement Details</span>
            <span class="ms-auto">
                @if (Model.IsActive)
                {
                    <span class="badge badge-ok"><i class="fa-solid fa-circle-check"></i> Active</span>
                }
                else
                {
                    <span class="badge badge-danger"><i class="fa-solid fa-circle-xmark"></i> Inactive</span>
                }
            </span>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" for="startDate">Start Date</label>
                    <input id="startDate" class="form-control input-static" readonly
                           value="@Model.StartDate.ToString("dd/MM/yyyy")" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" for="endDate">End Date</label>
                    <input id="endDate" class="form-control input-static" readonly
                           value="@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Running")" />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="BedCount">Sanctioned Beds</label>
                    <input asp-for="BedCount" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="BedOccupancy">
                        Operational Beds <span class="text-danger">*</span>
                    </label>
                    <input asp-for="BedOccupancy" id="BedOccupancy" class="form-control"
                           inputmode="numeric" placeholder="Enter operational beds" />
                    <div class="stat-sub mt-1">Drives the whole calculation below.</div>
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="RatePerBed">Rate / Bed</label>
                    <input asp-for="RatePerBed" id="RatePerBed" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="MonthlyBill">Monthly Bill</label>
                    <input asp-for="MonthlyBill" id="MonthlyBill" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="AverageScore">Average WPR Score</label>
                    <input asp-for="AverageScore" id="AverageScore" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-6 col-xl-3">
                    <label class="form-label" asp-for="PaymentPercentage">Payment Percentage</label>
                    <div class="input-group">
                        <input asp-for="PaymentPercentage" id="PaymentPercentage" class="form-control input-static" readonly />
                        <span class="input-group-text">%</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="card">
        <div class="card-header">
            <i class="fa-solid fa-calculator text-teal"></i>
            <span class="card-title">Payment Summary</span>
        </div>

        <div class="card-body">
            <div class="row g-3">

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="GrossPayable">Gross Payable</label>
                    <input asp-for="GrossPayable" id="GrossPayable" class="form-control input-static" readonly />
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="GSTPercentage">GST %</label>
                    <input asp-for="GSTPercentage" id="GSTPercentage" class="form-control input-static" readonly />
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="GSTAmount">GST Amount</label>
                    <input asp-for="GSTAmount" id="GSTAmount" class="form-control input-static" readonly />
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="InvoiceAmount">Invoice Amount</label>
                    <input asp-for="InvoiceAmount" id="InvoiceAmount" class="form-control input-static" readonly />
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="TDSPercentage">TDS %</label>
                    <input asp-for="TDSPercentage" id="TDSPercentage" class="form-control input-static" readonly />
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <label class="form-label" asp-for="TDSAmount">TDS Amount</label>
                    <input asp-for="TDSAmount" id="TDSAmount" class="form-control input-static" readonly />
                </div>

                <div class="col-12 col-md-8 col-xl-6">
                    <label class="form-label text-success" asp-for="NetPayable">Net Payable</label>
                    <input asp-for="NetPayable" id="NetPayable" readonly
                           class="form-control form-control-lg input-static fw-bold text-success" />
                </div>

            </div>

            <div class="d-flex justify-content-end flex-wrap gap-2 mt-4 pt-3 border-top">
                <a asp-action="PaymentList" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Submit Payment
                </button>
            </div>

        </div>
    </div>

</form>

@section Scripts {
    <script>

        $(function () {

            CalculatePayment();

            $("#BedOccupancy").on("keyup change", LMIS.debounce(CalculatePayment, 250));
            $("#MonthNo").on("change", CalculatePayment);
            $("#YearNo").on("change", CalculatePayment);

        });

        function CalculatePayment() {

            var bedOccupancy = $("#BedOccupancy").val();

            if (bedOccupancy === "" || parseInt(bedOccupancy, 10) <= 0) {
                ClearCalculation();
                return;
            }

            $.ajax({
                url: '@Url.Action("GetPaymentCalculation", "Payment")',
                type: 'GET',
                data: {
                    agreementId: $("#AgreementId").val(),
                    hospitalId: $("#HospitalId").val(),
                    monthNo: $("#MonthNo").val(),
                    yearNo: $("#YearNo").val(),
                    bedOccupancy: bedOccupancy
                },

                success: function (response) {
                    $("#MonthlyBill").val(response.monthlyBill);
                    $("#AverageScore").val(response.averageScore);
                    $("#PaymentPercentage").val(response.paymentPercentage);
                    $("#GrossPayable").val(response.grossPayable);
                    $("#GSTPercentage").val(response.gstPercentage);
                    $("#GSTAmount").val(response.gstAmount);
                    $("#InvoiceAmount").val(response.invoiceAmount);
                    $("#TDSPercentage").val(response.tdsPercentage);
                    $("#TDSAmount").val(response.tdsAmount);
                    $("#NetPayable").val(response.netPayable);
                },

                error: function () {
                    LMIS.alert("Calculation failed", "Unable to calculate the payment.", "error");
                    ClearCalculation();
                }
            });
        }

        function ClearCalculation() {
            $("#MonthlyBill, #AverageScore, #PaymentPercentage, #GrossPayable, #GSTPercentage, " +
              "#GSTAmount, #InvoiceAmount, #TDSPercentage, #TDSAmount, #NetPayable").val("");
        }

    </script>
}
