@model List<LaudaryMis.Models.PaymentMaster>

@{
    ViewData["Title"] = "Payment List";
    var isHospital = User.IsInRole("Hospital");
    var total = Model?.Count ?? 0;
    var netTotal = Model?.Sum(p => p.NetPayable) ?? 0m;
}

<div class="page-header">
    <div class="ph-icon"><i class="fa-solid fa-money-bill-wave"></i></div>
    <div class="ph-text">
        <h1>Monthly Payment Management</h1>
        <p class="ph-sub">@total payment@(total == 1 ? "" : "s") &middot; ₹@netTotal.ToString("N2") net payable</p>
    </div>
    @if (isHospital)
    {
        <div class="ph-actions">
            <a asp-action="GeneratePayment" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Generate Payment
            </a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" data-auto-dismiss>
        <i class="fa-solid fa-circle-check"></i>
        <span>@TempData["Success"]</span>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<!-- FILTER -->
<form asp-action="PaymentList" method="get">
    <div class="filter-bar">

        <div class="filter-field">
            <label class="form-label" for="monthNo">Month</label>
            <select class="form-select" name="monthNo" id="monthNo">
                <option value="">All Months</option>
                @for (int i = 1; i <= 12; i++)
                {
                    <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                }
            </select>
        </div>

        <div class="filter-field">
            <label class="form-label" for="yearNo">Year</label>
            <input type="number" class="form-control" name="yearNo" id="yearNo" value="@DateTime.Now.Year" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-magnifying-glass"></i> Search
            </button>
            <a asp-action="PaymentList" class="btn btn-light">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </a>
        </div>

    </div>
</form>

<!-- TABLE -->
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblPayments" class="table table-hover align-middle w-100">

                <thead>
                    <tr>
                        <th data-priority="1">Payment No</th>
                        <th data-priority="4">Hospital</th>
                        <th data-priority="5">Provider</th>
                        <th data-priority="6">Month</th>
                        <th data-priority="9" class="text-center">Bed Occupancy</th>
                        <th data-priority="3" class="text-center">Avg Score</th>
                        <th data-priority="10" class="text-end">Monthly Bill</th>
                        <th data-priority="8" class="text-end">Invoice Amount</th>
                        <th data-priority="11" class="text-end">TDS</th>
                        <th data-priority="2" class="text-end">Net Payable</th>
                        <th data-priority="7">Status</th>
                        <th data-priority="1" class="no-sort text-end">Action</th>
                        @if (isHospital)
                        {
                            <th data-priority="3" class="no-sort text-end">Warning Letter</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-teal">@item.PaymentNo</td>
                                <td>@item.HospitalName</td>
                                <td>@item.ProviderName</td>

                                <td class="nowrap">
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.MonthNo) @item.YearNo
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-info">@item.BedOccupancy / @item.SanctionedBeds</span>
                                </td>

                                <td class="text-center">
                                    @if (item.AverageScore >= 81)
                                    {
                                        <span class="badge badge-ok">@item.AverageScore %</span>
                                    }
                                    else if (item.AverageScore >= 61)
                                    {
                                        <span class="badge badge-warn">@item.AverageScore %</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">@item.AverageScore %</span>
                                    }
                                </td>

                                <td class="text-end nowrap">₹ @item.MonthlyBill.ToString("N2")</td>
                                <td class="text-end nowrap fw-bold text-teal">₹ @item.InvoiceAmount.ToString("N2")</td>
                                <td class="text-end nowrap text-danger">₹ @item.TDSAmount.ToString("N2")</td>
                                <td class="text-end nowrap fw-bold text-success">₹ @item.NetPayable.ToString("N2")</td>

                                <td>
                                    @if (item.InvoiceId == null)
                                    {
                                        <span class="badge badge-warn">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-ok">Invoice Generated</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (item.InvoiceId == null)
                                    {
                                        @if (User.IsInRole("Provider"))
                                        {
                                            <a asp-controller="Invoice"
                                               asp-action="GenerateInvoice"
                                               asp-route-paymentId="@item.PaymentId"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa-solid fa-file-invoice"></i> Generate
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">&mdash;</span>
                                        }
                                    }
                                    else
                                    {
                                        <a asp-controller="Invoice"
                                           asp-action="PreviewInvoice"
                                           asp-route-invoiceId="@item.InvoiceId"
                                           class="btn btn-sm btn-icon btn-outline-primary"
                                           target="_blank" rel="noopener"
                                           data-bs-toggle="tooltip" title="View invoice">
                                            <i class="fa-solid fa-eye"></i>
                                        </a>
                                    }
                                </td>

                                @if (isHospital)
                                {
                                    <td class="text-end">
                                        @if (item.AverageScore < 80)
                                        {
                                            if (item.WarningGenerated == false)
                                            {
                                                <a asp-controller="WarningLetter"
                                                   asp-action="GenerateWarningLetter"
                                                   asp-route-paymentId="@item.PaymentId"
                                                   class="btn btn-sm btn-gold">
                                                    <i class="fa-solid fa-triangle-exclamation"></i> Generate
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-controller="WarningLetter"
                                                   asp-action="PreviewWarningLetter"
                                                   asp-route-warningId="@item.WarningId"
                                                   target="_blank" rel="noopener"
                                                   class="btn btn-sm btn-outline-success">
                                                    <i class="fa-solid fa-eye"></i> View
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge badge-ok">Not Required</span>
                                        }
                                    </td>
                                }

                            </tr>
                        }
                    }
                </tbody>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            LMIS.initTable('#tblPayments', {
                exportTitle: 'Payment List',
                order: [[0, 'desc']],
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    emptyTable: 'No payment records found'
                }
            });
        });
    </script>
}
